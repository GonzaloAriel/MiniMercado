@model IEnumerable<MiniMercado.Models.Tenant>

<h2>Tenants</h2>

<a asp-action="Create" class="btn btn-primary">Crear Tenant</a>

<div class="table-responsive">
    <table class="table mt-3 table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Activo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tenant in Model)
            {
                <tr>
                    <td>@tenant.Id</td>
                    <td>@tenant.NombreComercio</td>
                    <td>@tenant.Activo</td>
                    <td>
                        <a asp-action="Toggle" asp-route-id="@tenant.Id"
                           class="btn btn-sm btn-warning">
                            Activar / Desactivar
                        </a>
                    </td>
    
                </tr>
            }
        </tbody>
    </table>
</div>

@if (ViewBag.TotalPaginas > 1)
{
    <div class="pagination-container">
        @if (ViewBag.PaginaActual > 1)
        {
            <a asp-action="Index" 
               asp-route-page="@(ViewBag.PaginaActual - 1)" 
               class="page-link-modern">
                <i class="bi bi-chevron-left"></i>
            </a>
        }
        else
        {
            <span class="page-link-modern disabled"><i class="bi bi-chevron-left"></i></span>
        }

        @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
        {
            if (i == ViewBag.PaginaActual)
            {
                <span class="page-link-modern active">@i</span>
            }
            else
            {
                <a asp-action="Index" 
                   asp-route-page="@i" 
                   class="page-link-modern">@i</a>
            }
        }

        @if (ViewBag.PaginaActual < ViewBag.TotalPaginas)
        {
            <a asp-action="Index" 
               asp-route-page="@(ViewBag.PaginaActual + 1)" 
               class="page-link-modern">
                <i class="bi bi-chevron-right"></i>
            </a>
        }
        else
        {
            <span class="page-link-modern disabled"><i class="bi bi-chevron-right"></i></span>
        }
    </div>
}
