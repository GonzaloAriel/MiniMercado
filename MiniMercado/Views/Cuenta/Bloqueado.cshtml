@model dynamic
@{
    Layout = null;
    
    // ---------------------------------------------------------
    // CONFIGURACIÓN DE SOPORTE
    // ---------------------------------------------------------
    string numeroSoporte = "5491122684117"; // <--- CAMBIAR AQUÍ (Código país + número, sin + ni espacios)
    string mensajeSoporte = Uri.EscapeDataString("Hola! Necesito ayuda con mi suscripción de MiniMercado. Mi comercio se encuentra bloqueado.");
    string urlWhatsapp = $"https://wa.me/{numeroSoporte}?text={mensajeSoporte}";
    // ---------------------------------------------------------
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso Bloqueado - MiniMercado</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background-color: #f0f2f5;
            height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }
        .lock-container {
            max-width: 450px;
            width: 90%;
        }
        .lock-card {
            background: white;
            border-radius: 1.25rem;
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
            padding: 3rem 2rem;
            text-align: center;
            border: none;
        }
        .icon-circle {
            width: 100px;
            height: 100px;
            background-color: #fff5f5;
            color: #dc3545;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3.5rem;
            margin: 0 auto 1.5rem;
        }
        .status-badge {
            background-color: #ffe3e3;
            color: #af233a;
            font-weight: 600;
            padding: 0.5rem 1rem;
            border-radius: 2rem;
            display: inline-block;
            margin-bottom: 1.5rem;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .btn-whatsapp {
            background-color: #25d366;
            color: white;
            border: none;
            padding: 0.8rem;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        .btn-whatsapp:hover {
            background-color: #128c7e;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(37, 211, 102, 0.3);
        }
        .btn-logout {
            padding: 0.8rem;
            font-weight: 500;
        }
    </style>
</head>
<body>

    <div class="lock-container">
        <div class="lock-card">
            <div class="icon-circle">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            
            <span class="status-badge">Acceso Restringido</span>
            
            <h1 class="h3 mb-3 fw-bold text-dark">Servicio Suspendido</h1>
            
            <p class="text-secondary mb-4">
                Lo sentimos, tu acceso al sistema ha sido bloqueado. Esto puede deberse al vencimiento de tu suscripción o a una restricción administrativa.
            </p>

            <div class="d-grid gap-3">
                <a href="@urlWhatsapp" target="_blank" class="btn btn-whatsapp btn-lg rounded-pill shadow-sm">
                    <i class="bi bi-whatsapp me-2"></i> Contactar Soporte
                </a>
                
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                    <button type="submit" class="btn btn-outline-secondary btn-lg w-100 rounded-pill btn-logout">
                        <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                    </button>
                </form>
            </div>

            <div class="mt-5 text-muted small">
                &copy; @DateTime.Now.Year MiniMercado SaaS
            </div>
        </div>
    </div>

</body>
</html>
