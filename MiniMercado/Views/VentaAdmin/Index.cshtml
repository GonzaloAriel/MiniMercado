@model IEnumerable<MiniMercado.Models.Venta>

@{
    ViewData["Title"] = "Administración de Ventas";
}

<h2 class="mb-4">🛠 Administración de Ventas</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <label class="form-label">Desde</label>
        <input type="date" name="desde" value="@ViewBag.Desde" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Hasta</label>
        <input type="date" name="hasta" value="@ViewBag.Hasta" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Estado</label>
        <select name="estado" class="form-select">
            <option value="">Todos</option>
            <option value="activa" selected="@((ViewBag.Estado == "activa") ? "selected" : "")">Activas</option>
            <option value="anulada" selected="@((ViewBag.Estado == "anulada") ? "selected" : "")">Anulada</option>
        </select>
    </div>
    <div class="col-md-3 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-primary">🔍 Filtrar</button>
        <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
    </div>
</form>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Fecha</th>
            <th>Total</th>
            <th>Estado</th>
            <th style="width:200px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var venta in Model)
        {
            <tr class="@(venta.Activa ? "table-danger" : "")">
                <td>@venta.Id</td>
                <td>@venta.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                <td>$@venta.Total.ToString("0")</td>
                <td>
                    @if (venta.Activa)
                    {
                        <span class="badge bg-danger">Anulada</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Activa</span>
                    }
                </td>
                <td>
                    <a asp-action="Detalle"
                       asp-route-id="@venta.Id"
                       class="btn btn-sm btn-info">
                        👁 Detalle
                    </a>

                    @if (!venta.Activa)
                    {
                        <a asp-action="Anular"
                           asp-route-id="@venta.Id"
                           class="btn btn-sm btn-danger">
                            ❌ Anular
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>



