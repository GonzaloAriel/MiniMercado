        // ADMINISTRACIÓN
        <div class="section-card" id="card-admin">
            <div class="section-header" onclick="toggleSection('admin')">
                <div class="section-icon" style="background:rgba(100,116,139,0.12)">
                    <svg viewBox="0 0 24 24" stroke="#64748b">
                        <rect x="3" y="3" width="7" height="7"/>
                        <rect x="14" y="3" width="7" height="7"/>
                        <rect x="14" y="14" width="7" height="7"/>
                        <rect x="3" y="14" width="7" height="7"/>
                    </svg>
                </div>
                <div class="section-info">
                    <p class="section-name">Administración</p>
                    <p class="section-desc">Métricas, usuarios, auditorías y configuración del negocio</p>
                </div>
                <svg class="section-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <polyline points="6 9 12 15 18 9"/>
                </svg>
            </div>
            <div class="section-body" id="body-admin">
                <div class="section-body-inner">
                    <a asp-controller="AdminDashboard" asp-action="Index" class="action-btn">
                        <div class="btn-icon" style="background:rgba(79,70,229,0.10)">
                            <svg viewBox="0 0 24 24" stroke="#4f46e5">
                                <line x1="18" y1="20" x2="18" y2="10"/>
                                <line x1="12" y1="20" x2="12" y2="4"/>
                                <line x1="6" y1="20" x2="6" y2="14"/>
