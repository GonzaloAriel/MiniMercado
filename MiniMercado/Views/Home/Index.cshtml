                    </a>
                    <a asp-controller="Usuarios" asp-action="Index" class="action-btn">
                        <div class="btn-icon" style="background:rgba(100,116,139,0.10)">
                            <svg viewBox="0 0 24 24" stroke="#64748b">
                                <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                <circle cx="12" cy="7" r="4"/>
                            </svg>
                        </div>
                        <span class="btn-label">Usuarios</span>
