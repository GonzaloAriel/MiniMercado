@{
    ViewData["Title"] = "Inicio";
}

<h2 class="mb-4">🏪 Mini Mercado</h2>


<!-- 🚀 ACCESOS -->
<div class="row">

    <div class="col-md-4 mb-3">
        <a asp-controller="Venta" asp-action="Create"
           class="btn btn-success w-100 p-4 fs-5">
            🛒 Nueva Venta
        </a>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <div class="col-md-4 mb-3">
            <a asp-controller="Productos" asp-action="Index"
               class="btn btn-primary w-100 p-4 fs-5">
                📦 Productos
            </a>
        </div>
    }

    @if (User.IsInRole("Admin"))
    {
        <div class="col-md-4 mb-3">
            <a asp-controller="MovimientoStock" asp-action="Ingreso"
               class="btn btn-warning w-100 p-4 fs-5">
                ➕ Ingreso de Stock
            </a>
        </div>
    }

    <div class="col-md-4 mb-3">
        <a asp-controller="Venta" asp-action="Index"
           class="btn btn-info w-100 p-4 fs-5">
            📄 Historial de Ventas
        </a>
    </div>

    <div class="col-md-4 mb-3">
        <a asp-controller="Venta"
           asp-action="Caja"
           class="btn btn-dark w-100 p-4 fs-5">
            📊 Caja diaria
        </a>
    </div>

</div>

@if (User.IsInRole("Admin"))
{
    <hr />
    <h4>⚙️ Administración</h4>

    <div class="row">
        <div class="col-md-4 mb-3">
            <a asp-controller="Usuarios" asp-action="Create"
               class="btn btn-outline-dark w-100 p-3">
                👤 Crear Usuario
            </a>
        </div>
    </div>
}


<hr />

<!-- 🔔 RESUMEN DEL DÍA -->
<div class="row mb-4 pt-xxl-5">

    <div class="col-md-4">
        <div class="alert alert-success text-center">
            💰 <strong>Ventas de hoy</strong><br />
            $@ViewBag.TotalHoy.ToString("0.##")
        </div>
    </div>

    <div class="col-md-4">
        <div class="alert alert-success text-center">
            🧾 <strong>Cantidad de ventas</strong><br />
            @ViewBag.CantidadVentasHoy
        </div>
    </div>

    <div class="col-md-4">
        <div class="alert alert-success text-center">
            ⚠️ <strong>Productos con stock bajo</strong><br />
            @(ViewBag.StockBajo.Count)
        </div>
    </div>

</div>

<!-- ⚠️ LISTADO DE STOCK BAJO -->
@if (ViewBag.StockBajo.Count > 0)
{
    <div class="card mb-4">
        <div class="card-header bg-info">
            ⚠️ Stock bajo
        </div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Stock</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in ViewBag.StockBajo)
                    {
                        <tr>
                            <td>@p.Nombre</td>
                            <td class="text-danger fw-bold">@p.Stock</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
