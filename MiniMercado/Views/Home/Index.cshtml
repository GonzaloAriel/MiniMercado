@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .dashboard-card {
        border: none;
        border-radius: 18px;
        transition: 0.2s ease-in-out;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    }

        .dashboard-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 30px rgba(0,0,0,0.12);
        }

    .action-btn {
        border-radius: 16px;
        padding: 28px;
        font-size: 18px;
        font-weight: 600;
        transition: 0.2s;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

        .action-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }

    .metric-card {
        border-radius: 16px;
        padding: 25px;
        color: white;
    }

    .metric-value {
        font-size: 28px;
        font-weight: bold;
    }
</style>

<!-- Logo -->
<div class="text-center mt-4 mb-5">
    <img src="~/images/Bird_Lime_Minimercado.png" class="rounded-pill " height="90" />
    <p class="text-muted mt-3">Gestioná tu minimercado de forma inteligente!!</p>
</div>

<hr />

<!-- Ingreso -->
@if (!(User.IsInRole("Caja")) && !(User.IsInRole("Admin")) && !(User.IsInRole("AdminGlobal")))
{
    <div class="text-center mt-4 mb-5">
        <a class="btn btn-success w-100 action-btn fs-4"
           asp-area="Identity"
           asp-page="/Account/Login">
            🔐 Ingresar
        </a>
    </div>
}

<!-- 🚀 ACCIONES PRINCIPALES -->
<div class="row g-4 mb-5">

    @if (User.IsInRole("Caja") || User.IsInRole("Admin"))
    {
        <div class="col-md-4">
            <a asp-controller="Venta" asp-action="Create"
               class="btn btn-success w-100 action-btn">
                🛒 Nueva Venta
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="Venta" asp-action="Index"
               class="btn btn-primary w-100 action-btn">
                📄 Historial de Ventas
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="Venta" asp-action="Caja"
               class="btn btn-danger w-100 action-btn">
                📊 Caja Diaria
            </a>
        </div>
    }

    @if (User.IsInRole("Admin"))
    {
        <div class="col-md-4">
            <a asp-controller="Productos" asp-action="Index"
               class="btn btn-info w-100 action-btn">
                📦 Gestión de Productos
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="MovimientoStock" asp-action="Ingreso"
               class="btn btn-warning w-100 action-btn">
                ➕ Ingreso de Stock
            </a>
        </div>


        <hr />

        <h4>⚙️ Administración</h4>

        <div class="col-md-4">
            <a asp-controller="Usuarios" asp-action="Index"
               class="btn btn-dark w-100 action-btn">
                👤 Usuarios
            </a>
        </div>


        <div class="col-md-4">
            <a asp-controller="VentaAdmin" asp-action="Index"
               class="btn btn-dark w-100 action-btn">
                ✏ Administracion de Venta
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="AdminDashboard" asp-action="Index"
               class="btn btn-dark w-100 action-btn">
                📈 Metricas y economia
            </a>
        </div>
    }


    @if (User.IsInRole("AdminGlobal"))
    {
        <div class="col-md-6">
            <a asp-controller="Tenants" asp-action="Index"
               class="btn btn-danger w-100 action-btn">
                🏢 Administrar Tenants
            </a>
        </div>

        <div class="col-md-6">
            <a asp-controller="AdminGlobalUsuarios" asp-action="Tenants"
               class="btn btn-dark w-100 action-btn">
                🔐 Gestión Global de Usuarios
            </a>
        </div>
    }

</div>


@if (User.IsInRole("Caja") || User.IsInRole("Admin"))
{
    <hr />

    <!-- 🔔 RESUMEN DEL DÍA -->
    <div class="row mb-4 pt-xxl-5">

        <div class="col-md-4">
            <div class="alert alert-success text-center">
                💰 <strong>Ventas de hoy</strong><br />
                $@ViewBag.TotalHoy.ToString("0.##")
            </div>
        </div>

        <div class="col-md-4">
            <div class="alert alert-success text-center">
                🧾 <strong>Cantidad de ventas</strong><br />
                @ViewBag.CantidadVentasHoy
            </div>
        </div>

        <div class="col-md-4">
            <div class="alert alert-success text-center">
                ⚠️ <strong>Productos con stock bajo</strong><br />
                @(ViewBag.StockBajo.Count)
            </div>
        </div>

    </div>

    <!-- ⚠️ TABLA STOCK BAJO -->
    @if (ViewBag.StockBajo.Count > 0)
    {
        <div class="card dashboard-card">
            <div class="card-header bg-secondary fw-bold">
                ⚠️ Productos con Stock Bajo
            </div>
            <div class="card-body p-0">
                <table class="table table-bordered table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Producto</th>
                            <th>Stock</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in ViewBag.StockBajo)
                        {
                            <tr>
                                <td>@p.Nombre</td>
                                <td class="text-danger fw-bold">@p.Stock</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}