@{
    ViewData["Title"] = "Panel de Control";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap');

    /* ── Variables que extienden el sistema global ─── */
    :root {
        --home-radius: 20px;
        --home-gap: 10px;
        --home-transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* ── Wrap principal ───────────────────────────── */
    .home-wrap {
        max-width: 860px;
        margin: 0 auto;
        padding: 28px 20px 72px;
        font-family: 'DM Sans', system-ui, sans-serif;
    }

    /* ── Hero / Logo ──────────────────────────────── */
    .home-hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 15px 0 40px;
        text-align: center;
    }

    .home-hero img {
        max-height: 80px;
        width: auto;
        object-fit: contain;
        margin-bottom: 18px;
        border: 1.5px solid #a78bfa;
        border-radius: 20px;
        background: rgba(255,255,255,0.08);
        padding: 4px;
        transition: var(--home-transition);
        filter: drop-shadow(0 4px 16px rgba(79,70,229,0.18));
    }

    .home-hero img:hover {
        border-color: #c084fc;
        transform: scale(1.04) rotate(-1deg);
    }

    body.dark-mode .home-hero img {
        filter: brightness(0) invert(1) drop-shadow(0 0 8px rgba(255, 255, 255, 0.1));
    }

    .home-hero-title {
        font-size: 26px;
        font-weight: 700;
        letter-spacing: -0.03em;
        color: #fff;
        margin: 0 0 8px;
        text-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }

    .home-hero-sub {
        font-size: 14px;
        color: rgba(255,255,255,0.65);
        font-weight: 400;
        max-width: 340px;
        line-height: 1.5;
        margin: 0;
    }

    /* ── Login CTA (sin sesión) ───────────────────── */
    .login-cta {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--home-radius);
        padding: 40px 24px;
        margin-bottom: 24px;
        text-align: center;
    }

    .login-cta p {
        font-size: 15px;
        color: var(--text-secondary);
        margin: 0;
    }

    .login-cta a {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: var(--uala-indigo);
        color: #fff;
        font-size: 15px;
        font-weight: 600;
        padding: 13px 32px;
        border-radius: 14px;
        text-decoration: none;
        transition: var(--home-transition);
        letter-spacing: -0.01em;
    }

    .login-cta a:hover {
        background: var(--uala-blue);
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(79,70,229,0.3);
        text-decoration: none;
        color: #fff;
    }

    .login-cta a svg {
        width: 18px;
        height: 18px;
        stroke: #fff;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* ── CTA Principal: Nueva Venta ───────────────── */
    .nueva-venta-btn {
        display: flex;
        align-items: center;
        gap: 16px;
        width: 100%;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border-radius: var(--home-radius);
        padding: 20px 24px;
        margin-bottom: 20px;
        text-decoration: none;
        transition: var(--home-transition);
        border: none;
        cursor: pointer;
    }

    .nueva-venta-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(16,185,129,0.35);
        text-decoration: none;
    }

    .nueva-venta-btn:active { transform: translateY(0); }

    .nv-icon {
        width: 52px;
        height: 52px;
        background: rgba(255,255,255,0.18);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .nv-icon svg {
        width: 26px;
        height: 26px;
        stroke: #fff;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .nv-text h2 {
        font-size: 18px;
        font-weight: 700;
        color: #fff;
        margin: 0 0 2px;
        letter-spacing: -0.02em;
    }

    .nv-text p {
        font-size: 13px;
        color: rgba(255,255,255,0.7);
        margin: 0;
    }

    .nv-arrow {
        margin-left: auto;
        color: rgba(255,255,255,0.5);
        font-size: 26px;
        line-height: 1;
        flex-shrink: 0;
    }

    /* ── KPI Grid (métricas del día) ──────────────── */
    .kpi-row {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: var(--home-gap);
        margin-bottom: 20px;
    }

    @@media (max-width: 480px) {
        .kpi-row { grid-template-columns: 1fr 1fr; }
        .kpi-row .kpi-card:first-child { grid-column: 1 / -1; }
    }

    .kpi-card {
        background: var(--bg-card) !important;
        border: 1px solid var(--border) !important;
        border-radius: 16px !important;
        padding: 18px 16px !important;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .kpi-label {
        font-size: 11px;
        font-weight: 600;
        color: var(--text-muted) !important;
        text-transform: uppercase;
        letter-spacing: .07em;
        margin: 0;
    }

    .kpi-value {
        font-size: 24px !important;
        font-weight: 700 !important;
        font-family: 'DM Mono', monospace !important;
        letter-spacing: -0.02em;
        line-height: 1.1;
        margin: 2px 0 0;
    }

    .kpi-value.green { color: var(--green-text) !important; }
    .kpi-value.blue  { color: var(--blue-text)  !important; }
    .kpi-value.amber { color: var(--amber-text) !important; }

    /* ── Secciones acordeón ───────────────────────── */
    .sections-label {
        font-size: 11px;
        font-weight: 700;
        color: rgba(255,255,255,0.45);
        text-transform: uppercase;
        letter-spacing: .1em;
        margin: 0 0 12px;
        padding-left: 2px;
    }

    .section-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--home-radius);
        margin-bottom: var(--home-gap);
        overflow: hidden;
        transition: border-color .2s, box-shadow .2s;
    }

    .section-card.open {
        border-color: var(--uala-violet-soft);
        box-shadow: 0 8px 24px rgba(79,70,229,0.10);
    }

    body.dark-mode .section-card.open {
        box-shadow: 0 8px 24px rgba(167,139,250,0.12);
    }

    /* Header del acordeón */
    .section-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 18px;
        cursor: pointer;
        user-select: none;
        background: var(--bg-card);
        transition: background .15s;
        -webkit-tap-highlight-color: transparent;
    }

    .section-header:hover {
        background: var(--bg-card-hover);
    }

    /* Ícono de sección */
    .section-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: transform .2s;
    }

    .section-card.open .section-icon {
        transform: scale(1.06);
    }

    .section-icon svg {
        width: 22px;
        height: 22px;
        fill: none;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* Texto */
    .section-info { flex: 1; min-width: 0; }

    .section-name {
        font-size: 15px;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0 0 3px;
        letter-spacing: -0.01em;
    }

    .section-desc {
        font-size: 12px;
        color: var(--text-muted);
        margin: 0;
        line-height: 1.4;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Chevron */
    .section-chevron {
        width: 20px;
        height: 20px;
        flex-shrink: 0;
        color: var(--text-muted);
        transition: transform .25s cubic-bezier(0.4,0,0.2,1);
    }

    .section-card.open .section-chevron {
        transform: rotate(180deg);
        color: var(--uala-violet-soft);
    }

    /* Cuerpo desplegable */
    .section-body {
        max-height: 0;
        overflow: hidden;
        transition: max-height .32s cubic-bezier(0.4,0,0.2,1);
    }

    .section-body-inner {
        padding: 4px 14px 16px;
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 8px;
    }

    @@media (max-width: 500px) {
        .section-body-inner { grid-template-columns: repeat(2, minmax(0,1fr)); }
    }

    /* Botones internos */
    .action-btn {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
        padding: 13px 12px;
        border-radius: 14px;
        border: 1px solid var(--border);
        background: var(--bg-card);
        cursor: pointer;
        text-decoration: none;
        transition: var(--home-transition);
        color: var(--text-primary);
    }

    .action-btn:hover {
        background: var(--bg-card-hover);
        border-color: var(--uala-violet-soft);
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(79,70,229,0.10);
        text-decoration: none;
        color: var(--text-primary);
    }

    .action-btn:active {
        transform: translateY(0);
    }

    .btn-icon {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .btn-icon svg {
        width: 16px;
        height: 16px;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .btn-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--text-primary);
        line-height: 1.3;
    }

    /* Separador dentro del body */
    .section-divider {
        border: none;
        border-top: 1px solid var(--border);
        margin: 4px 14px 12px;
    }

    /* ── Stock Bajo (tabla) ───────────────────────── */
    .stock-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--home-radius);
        overflow: hidden;
        margin-top: 20px;
    }

    .stock-card-header {
        background: rgba(245,158,11,0.10);
        border-bottom: 1px solid rgba(245,158,11,0.2);
        padding: 12px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .stock-card-header-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .stock-card-header-left svg {
        width: 16px;
        height: 16px;
        stroke: var(--amber-text);
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        flex-shrink: 0;
    }

    .stock-card-header-left span {
        font-size: 13px;
        font-weight: 600;
        color: var(--amber-text);
    }

    .stock-table-wrap { overflow-x: auto; }

    .stock-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    .stock-table th {
        padding: 10px 18px;
        text-align: left;
        font-size: 11px;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: .07em;
        background: var(--bg-card-hover);
        border-bottom: 1px solid var(--border);
    }

    .stock-table td {
        padding: 11px 18px;
        border-bottom: 1px solid var(--border);
        color: var(--text-primary);
        vertical-align: middle;
    }

    .stock-table tbody tr:last-child td { border-bottom: none; }
    .stock-table tbody tr:hover td { background: var(--bg-card-hover); }

    .badge-stock {
        display: inline-block;
        background: var(--red-bg) !important;
        color: var(--red-text) !important;
        font-size: 12px;
        font-weight: 600;
        padding: 3px 12px;
        border-radius: 20px;
        font-family: 'DM Mono', monospace;
    }

    /* ── Responsive general ───────────────────────── */
    @@media (max-width: 600px) {
        .home-hero-title { font-size: 22px; }
        .nueva-venta-btn { padding: 16px 18px; }
        .nv-text h2 { font-size: 16px; }
    }
</style>

<div class="home-wrap">
    <div class="home-hero">
        <img src="~/images/Minimercado.png" alt="MiniMercado" />
        <p class="home-hero-sub">Gestioná tu negocio de forma inteligente, simple y rápida.</p>
    </div>

    @if (!(User.IsInRole("Caja")) && !(User.IsInRole("Admin")) && !(User.IsInRole("AdminGlobal")))
    {
        <div class="login-cta">
            <p>Iniciá sesión para acceder al sistema</p>
            <a asp-area="Identity" asp-page="/Account/Login">
                <svg viewBox="0 0 24 24">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4"/>
                </svg>
                Ingresar al sistema
            </a>
        </div>
    }

    @if (User.IsInRole("Caja") || User.IsInRole("Admin"))
    {
        <a asp-controller="Venta" asp-action="Create" class="nueva-venta-btn">
            <div class="nv-icon">
                <svg viewBox="0 0 24 24">
                    <circle cx="9" cy="21" r="1"/>
                    <circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 001.95-1.55l1.65-8.74H6"/>
                </svg>
            </div>
            <div class="nv-text">
                <h2>Nueva venta</h2>
                <p>Registrar nueva transacción</p>
            </div>
            <span class="nv-arrow">›</span>
        </a>

          <div class="kpi-row">
            <div class="kpi-card">
                <span class="kpi-label">Ventas hoy</span>
                <span class="kpi-value green">$@ViewBag.TotalHoy.ToString("N0")</span>
            </div>
            <div class="kpi-card">
                <span class="kpi-label">Transacciones</span>
                <span class="kpi-value blue">@ViewBag.CantidadVentasHoy</span>
            </div>
            <div class="kpi-card">
                <span class="kpi-label">Stock bajo</span>
                <span class="kpi-value amber">@(ViewBag.StockBajo.Count)</span>
            </div>
        </div>
    }

    <p class="sections-label">Módulos disponibles</p>

    @if (User.IsInRole("Caja") || User.IsInRole("Admin"))
    {
        <div class="section-card" id="card-ventas">
            <div class="section-header" onclick="toggleSection('ventas')">
                <div class="section-icon" style="background:rgba(16,185,129,0.12)">
                    <svg viewBox="0 0 24 24" stroke="#10b981">
                        <line x1="8" y1="6" x2="21" y2="6"/>
                        <line x1="8" y1="12" x2="21" y2="12"/>
                        <line x1="8" y1="18" x2="21" y2="18"/>
                        <line x1="3" y1="6" x2="3.01" y2="6"/>
                        <line x1="3" y1="12" x2="3.01" y2="12"/>
                        <line x1="3" y1="18" x2="3.01" y2="18"/>
                    </svg>
                </div>
                <div class="section-info">
                    <p class="section-name">Ventas</p>
                    <p class="section-desc">Historial, caja diaria y administración de comprobantes</p>
                </div>
                <svg class="section-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <polyline points="6 9 12 15 18 9"/>
                </svg>
            </div>
            <div class="section-body" id="body-ventas">
                <div class="section-body-inner">
                    <a asp-controller="Venta" asp-action="Index" class="action-btn">
                        <div class="btn-icon" style="background:rgba(79,70,229,0.10)">
                            <svg viewBox="0 0 24 24" stroke="#4f46e5">
                                <line x1="8" y1="6" x2="21" y2="6"/>
                                <line x1="8" y1="12" x2="21" y2="12"/>
                                <line x1="8" y1="18" x2="21" y2="18"/>
                                <line x1="3" y1="6" x2="3.01" y2="6"/>
                                <line x1="3" y1="12" x2="3.01" y2="12"/>
                                <line x1="3" y1="18" x2="3.01" y2="18"/>
                            </svg>
                        </div>
                        <span class="btn-label">Historial de ventas</span>
                    </a>
                    <a asp-controller="Venta" asp-action="Caja" class="action-btn">
                        <div class="btn-icon" style="background:rgba(239,68,68,0.10)">
                            <svg viewBox="0 0 24 24" stroke="#ef4444">
                                <rect x="2" y="7" width="20" height="14" rx="2"/>
                                <path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/>
                            </svg>
                        </div>
                        <span class="btn-label">Caja diaria</span>
                    </a>
                    <a asp-controller="VentaAdmin" asp-action="Index" class="action-btn">
                        <div class="btn-icon" style="background:rgba(245,158,11,0.10)">
                            <svg viewBox="0 0 24 24" stroke="#f59e0b">
                                <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                            </svg>
                        </div>
                        <span class="btn-label">Admin ventas</span>
                    </a>
                </div>
            </div>
        </div>
    }

    @if (User.IsInRole("Admin"))
    {
        <div class="section-card" id="card-inventario">
            <div class="section-header" onclick="toggleSection('inventario')">
                <div class="section-icon" style="background:rgba(79,70,229,0.12)">
                    <svg viewBox="0 0 24 24" stroke="#4f46e5">
                        <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                        <line x1="12" y1="22.08" x2="12" y2="12"/>
                    </svg>
                </div>
                <div class="section-info">
                    <p class="section-name">Inventario</p>
                    <p class="section-desc">Productos, stock, rubros y proveedores de tu negocio</p>
                </div>
                <svg class="section-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <polyline points="6 9 12 15 18 9"/>
                </svg>
            </div>
            <div class="section-body" id="body-inventario">
                <div class="section-body-inner">
                    <a asp-controller="Productos" asp-action="Index" class="action-btn">
                        <div class="btn-icon" style="background:rgba(79,70,229,0.10)">
                            <svg viewBox="0 0 24 24" stroke="#4f46e5">
                                <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                            </svg>
                        </div>
                        <span class="btn-label">Productos</span>
                    </a>
                    <a asp-controller="MovimientoStock" asp-action="Ingreso" class="action-btn">
                        <div class="btn-icon" style="background:rgba(16,185,129,0.10)">
                            <svg viewBox="0 0 24 24" stroke="#10b981">
                                <line x1="12" y1="5" x2="12" y2="19"/>
                                <line x1="5" y1="12" x2="19" y2="12"/>
                            </svg>
                        </div>
                        <span class="btn-label">Ingreso stock</span>
                    </a>
                    <a asp-controller="Rubro" asp-action="Index" class="action-btn">
                        <div class="btn-icon" style="background:rgba(100,116,139,0.10)">
                            <svg viewBox="0 0 24 24" stroke="#64748b">
                                <path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/>
                                <line x1="7" y1="7" x2="7.01" y2="7"/>
                            </svg>
                        </div>
                        <span class="btn-label">Rubros</span>
                    </a>
                    <a asp-controller="Proveedores" asp-action="Index" class="action-btn">
                        <div class="btn-icon" style="background:rgba(139,92,246,0.12)">
                            <svg viewBox="0 0 24 24" stroke="#8b5cf6">
                                <rect x="1" y="3" width="15" height="13"/>
                                <path d="M16 8h4l3 3v5h-7V8z"/>
                                <circle cx="5.5" cy="18.5" r="2.5"/>
                                <circle cx="18.5" cy="18.5" r="2.5"/>
                            </svg>
                        </div>
                        <span class="btn-label">Proveedores</span>
                    </a>
                </div>
            </div>
        </div>

        // CLIENTES
        <div class="section-card" id="card-clientes">
            <div class="section-header" onclick="toggleSection('clientes')">
                <div class="section-icon" style="background:rgba(139,92,246,0.12)">
                    <svg viewBox="0 0 24 24" stroke="#8b5cf6">
                        <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 00-3-3.87"/>
                        <path d="M16 3.13a4 4 0 010 7.75"/>
                    </svg>
                </div>
                <div class="section-info">
                    <p class="section-name">Clientes y fiados</p>
                    <p class="section-desc">Cuentas corrientes, deudas y pagos de tus clientes</p>
                </div>
                <svg class="section-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <polyline points="6 9 12 15 18 9"/>
                </svg>
            </div>
            <div class="section-body" id="body-clientes">
                <div class="section-body-inner">
                    <a asp-controller="Cliente" asp-action="Index" class="action-btn">
                        <div class="btn-icon" style="background:rgba(139,92,246,0.12)">
                            <svg viewBox="0 0 24 24" stroke="#8b5cf6">
                                <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                            </svg>
                        </div>
                        <span class="btn-label">Ver clientes</span>
                    </a>
                    <a asp-controller="Cliente" asp-action="Index" class="action-btn">
                        <div class="btn-icon" style="background:rgba(245,158,11,0.10)">
                            <svg viewBox="0 0 24 24" stroke="#f59e0b">
                                <line x1="12" y1="1" x2="12" y2="23"/>
                                <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
