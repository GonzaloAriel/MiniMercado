@{
    ViewData["Title"] = "Panel de Control";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap');

    .db-wrap {
        font-family: 'DM Sans', system-ui, sans-serif;
        color: var(--text-primary);
        background: var(--bg-primary);
        padding: 32px 24px 64px;
        max-width: 1200px;
        margin: 0 auto;
        min-height: 100vh;
    }

    /* Header */
    .db-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 32px;
    }

    .db-header-left h1 {
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -0.02em;
        margin: 0 0 4px;
        color: var(--text-primary);
    }

    .db-header-left p {
        font-size: 15px;
        color: var(--text-secondary);
        margin: 0;
    }

    /* Hero Section - Profesional y alegre */
    .main-hero {
        text-align: center;
        padding: 40px 0 48px;
    }

    .main-hero img {
        max-height: 100px;
        width: auto;
        margin-bottom: 20px;
    }

    .main-hero h2 {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 8px;
        color: var(--text-primary);
    }

    .main-hero p {
        font-size: 16px;
        color: var(--text-secondary);
    }

    /* Section Title */
    .section-title {
        font-size: 13px;
        font-weight: 700;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: .08em;
        margin: 32px 0 16px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .section-title::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--border);
    }

    /* Action Grid */
    .action-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .action-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 20px 24px;
        text-decoration: none;
        transition: all 0.25s ease;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .action-card:hover {
        transform: translateY(-3px);
        background: var(--bg-card-hover);
        border-color: var(--blue);
    }

    .action-card .icon {
        font-size: 24px;
    }

    .action-card .title {
        font-size: 16px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .action-card .desc {
        font-size: 13px;
        color: var(--text-muted);
        line-height: 1.4;
    }

    /* Colores por tipo */
    .action-card.primary { border-left: 3px solid var(--blue); }
    .action-card.success { border-left: 3px solid var(--green); }
    .action-card.danger { border-left: 3px solid var(--red); }
    .action-card.warning { border-left: 3px solid var(--amber); }

    /* KPI Grid */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 32px;
    }

    @@media (max-width: 768px) {
        .kpi-grid { grid-template-columns: 1fr; }
    }

    .kpi-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 20px 24px;
        transition: all 0.25s ease;
    }

    .kpi-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 8px;
        display: block;
    }

    .kpi-value {
        font-size: 32px;
        font-weight: 700;
        font-family: 'DM Mono', monospace;
    }

    .kpi-value.green { color: var(--green-text); }
    .kpi-value.amber { color: var(--amber-text); }
    .kpi-value.blue { color: var(--blue-text); }

    /* Data Card */
    .data-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        margin-top: 24px;
    }

    .data-card-header {
        padding: 14px 20px;
        background: var(--bg-tertiary);
        border-bottom: 1px solid var(--border);
        font-weight: 600;
        font-size: 14px;
        color: var(--amber-text);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* Tablas */
    .db-table {
        width: 100%;
        border-collapse: collapse;
    }

    .db-table th {
        padding: 12px 20px;
        text-align: left;
        font-size: 12px;
        font-weight: 600;
        color: var(--text-secondary);
        text-transform: uppercase;
        background: var(--bg-tertiary);
        border-bottom: 1px solid var(--border);
    }

    .db-table td {
        padding: 12px 20px;
        border-bottom: 1px solid var(--border-light);
        color: var(--text-primary);
        font-size: 14px;
    }

    .db-table tr:hover td { background: var(--bg-card-hover); }

    /* Badges */
    .badge-stock {
        font-family: 'DM Mono', monospace;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 20px;
        background: var(--red-bg);
        color: var(--red-text);
        display: inline-block;
        font-size: 12px;
    }

    /* Login Card */
    .login-card {
        max-width: 400px;
        margin: 40px auto;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        padding: 40px;
        text-align: center;
    }

    /* Botón de login */
    .login-btn {
        background: var(--blue);
        border: none;
        border-radius: var(--radius-lg);
        padding: 14px 28px;
        text-decoration: none;
        display: inline-block;
        margin-top: 20px;
        transition: all 0.25s ease;
        color: #fff;
        font-weight: 600;
    }

    .login-btn:hover {
        transform: translateY(-2px);
        opacity: 0.9;
        box-shadow: 0 8px 20px rgba(59, 130, 246, 0.3);
    }
</style>

<div class="db-wrap">
    
    <div class="main-hero">
        <img src="~/images/Bird_Lime_Minimercado.png" class="rounded-pill" alt="MiniMercado" />
        <p>Gestión inteligente para tu negocio</p>
    </div>

    @if (!(User.IsInRole("Caja")) && !(User.IsInRole("Admin")) && !(User.IsInRole("AdminGlobal")))
    {
        <div class="login-card">
            <div style="font-size: 48px; margin-bottom: 16px;">🏪</div>
            <h3 class="fw-bold mb-3">Bienvenido</h3>
            <p style="color: var(--text-secondary);">
                Sistema de gestión integral para tu minimercado
            </p>
            <a class="login-btn" asp-area="Identity" asp-page="/Account/Login">
                Ingresar al Sistema
            </a>
        </div>
    }

    @if (User.IsInRole("Caja") || User.IsInRole("Admin"))
    {
        <div class="col-md-12 mb-3">
            <a asp-controller="Venta" asp-action="Create" class="btn btn-primary w-100 py-3 fw-bold fs-4" style="border-radius: 16px;">
                🛍️ Nueva Venta
            </a>
        </div>

        <div class="section-title">Administración</div>
        <div class="action-grid">
            <a asp-controller="Venta" asp-action="Index" class="action-card">
                <span class="icon">📄</span>
                <span class="title">Historial</span>
                <span class="desc">Ver todas las ventas realizadas</span>
            </a>
            <a asp-controller="Venta" asp-action="Caja" class="action-card">
                <span class="icon">📊</span>
                <span class="title">Caja Diaria</span>
                <span class="desc">Resumen de ingresos y egresos de hoy</span>
            </a>
            <a asp-controller="VentaAdmin" asp-action="Index" class="action-card">
                <span class="icon">✏️</span>
                <span class="title">Gestión Ventas</span>
                <span class="desc">Administración avanzada de comprobantes</span>
            </a>
        </div>
    }

    @if (User.IsInRole("Admin"))
    {
        <div class="section-title">Inventario</div>
        <div class="action-grid">
            <a asp-controller="Productos" asp-action="Index" class="action-card">
                <span class="icon">📦</span>
                <span class="title">Productos</span>
                <span class="desc">Administrar catálogo y precios</span>
            </a>
            <a asp-controller="MovimientoStock" asp-action="Ingreso" class="action-card">
                <span class="icon">➕</span>
                <span class="title">Ingreso Stock</span>
                <span class="desc">Carga de mercadería y proveedores</span>
            </a>
            <a asp-controller="Rubro" asp-action="Index" class="action-card">
                <span class="icon">🏷️</span>
                <span class="title">Rubros</span>
                <span class="desc">Categorización de productos</span>
            </a>
        </div>

        <div class="section-title">Configuración y Reportes</div>
        <div class="action-grid">
            <a asp-controller="Usuarios" asp-action="Index" class="action-card">
                <span class="icon">👤</span>
                <span class="title">Usuarios</span>
                <span class="desc">Gestión de personal y permisos</span>
            </a>
            <a asp-controller="AdminDashboard" asp-action="Index" class="action-card">
                <span class="icon">📈</span>
                <span class="title">Métricas</span>
                <span class="desc">Estadísticas y reportes económicos</span>
            </a>
            <a asp-controller="Dashboard" asp-action="AuditoriaCajas" class="action-card">
                <span class="icon">🔍</span>
                <span class="title">Auditorías</span>
                <span class="desc">Control de movimientos de caja</span>
            </a>
            <a asp-controller="Cliente" asp-action="Index" class="action-card">
                <span class="icon">👥</span>
                <span class="title">Clientes</span>
                <span class="desc">Fiados y cuentas corrientes</span>
            </a>
            <a asp-controller="Caja" asp-action="Historial" class="action-card">
                <span class="icon">🏦</span>
                <span class="title">Estados Caja</span>
                <span class="desc">Histórico de aperturas y cierres</span>
            </a>
            <a asp-controller="Configuracion" asp-action="Index" class="action-card">
                <span class="icon">🛠️</span>
                <span class="title">Negocio</span>
                <span class="desc">Datos del local y comprobantes</span>
            </a>
        </div>
    }

    @if (User.IsInRole("AdminGlobal"))
    {
        <div class="section-title">Administración Global</div>
        <div class="action-grid">
            <a asp-controller="AdminGlobal" asp-action="Dashboard" class="action-card info">
                <span class="icon">📊</span>
                <span class="title">Dashboard Global</span>
                <span class="desc">Ingresos totales del sistema SaaS</span>
            </a>
            <a asp-controller="AdminGlobal" asp-action="Tenants" class="action-card danger">
                <span class="icon">🏢</span>
                <span class="title">Tenants</span>
                <span class="desc">Administrar locales y suscripciones</span>
            </a>
            <a asp-controller="Tenants" asp-action="Create" class="action-card success">
                <span class="icon">➕</span>
                <span class="title">Nuevo Local</span>
                <span class="desc">Dar de alta un nuevo minimercado</span>
            </a>
            <a asp-controller="AdminGlobalUsuarios" asp-action="Tenants" class="action-card">
                <span class="icon">🔐</span>
                <span class="title">Usuarios Global</span>
                <span class="desc">Gestión multi-tenant de usuarios</span>
            </a>
        </div>
    }

    @if (User.IsInRole("Caja") || User.IsInRole("Admin"))
    {
        <div class="section-title">Resumen del día</div>
        <div class="kpi-grid">
            <div class="kpi-card">
                <span class="kpi-label">Ventas de hoy</span>
                <span class="kpi-value green">$@ViewBag.TotalHoy.ToString("N0")</span>
            </div>
            <div class="kpi-card">
                <span class="kpi-label">Cant. Ventas</span>
                <span class="kpi-value blue">@ViewBag.CantidadVentasHoy</span>
            </div>
            <div class="kpi-card">
                <span class="kpi-label">Stock Bajo</span>
                <span class="kpi-value amber">@(ViewBag.StockBajo.Count)</span>
            </div>
        </div>

        @if (ViewBag.StockBajo.Count > 0)
        {
            <div class="data-card">
                <div class="data-card-header">⚠️ Productos con Stock Bajo</div>
                <table class="db-table">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Stock Actual</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in ViewBag.StockBajo)
                        {
                            <tr>
                                <td>@p.Nombre</td>
                                <td><span class="badge-stock">@p.Stock unidades</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>
