@{
    ViewData["Title"] = "Inicio";
}

<h2 class="mb-4">🏪 Mini Mercado</h2>

<div class="row">

    <div class="col-md-4 mb-3">
        <a asp-controller="Venta" asp-action="Create"
           class="btn btn-success w-100 p-4 fs-5">
            🛒 Nueva Venta
        </a>
    </div>

    <div class="col-md-4 mb-3">
        <a asp-controller="Productos" asp-action="Index"
           class="btn btn-primary w-100 p-4 fs-5">
            📦 Productos
        </a>
    </div>

    <div class="col-md-4 mb-3">
        <a asp-controller="MovimientoStock" asp-action="Ingreso"
           class="btn btn-warning w-100 p-4 fs-5">
            ➕ Ingreso de Stock
        </a>
    </div>

    <div class="col-md-4 mb-3">
        <a asp-controller="Venta" asp-action="Index"
           class="btn btn-info w-100 p-4 fs-5">
            📄 Historial de Ventas
        </a>
    </div>

</div>
