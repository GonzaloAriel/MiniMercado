    }

    @if (User.IsInRole("AdminGlobal"))
    {
        <div class="section-card" id="card-global">
            <div class="section-header" onclick="toggleSection('global')">
                <div class="section-icon" style="background:rgba(79,70,229,0.15)">
                    <svg viewBox="0 0 24 24" stroke="#4f46e5">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="2" y1="12" x2="22" y2="12"/>
                        <path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/>
                    </svg>
                </div>
                <div class="section-info">
                    <p class="section-name">Administración global</p>
                    <p class="section-desc">Dashboard SaaS, tenants, suscripciones y usuarios globales</p>
                </div>
                <svg class="section-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <polyline points="6 9 12 15 18 9"/>
                </svg>
            </div>
            <div class="section-body" id="body-global">
                <div class="section-body-inner">
                    <a asp-controller="AdminGlobal" asp-action="Dashboard" class="action-btn">
                        <div class="btn-icon" style="background:rgba(79,70,229,0.10)">
                            <svg viewBox="0 0 24 24" stroke="#4f46e5">
                                <line x1="18" y1="20" x2="18" y2="10"/>
                                <line x1="12" y1="20" x2="12" y2="4"/>
                                <line x1="6" y1="20" x2="6" y2="14"/>
                            </svg>
                        </div>
                        <span class="btn-label">Dashboard global</span>
                    </a>
                    <a asp-controller="AdminGlobal" asp-action="Tenants" class="action-btn">
                        <div class="btn-icon" style="background:rgba(239,68,68,0.10)">
                            <svg viewBox="0 0 24 24" stroke="#ef4444">
                                <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                                <polyline points="9 22 9 12 15 12 15 22"/>
                            </svg>
                        </div>
                        <span class="btn-label">Tenants y cobros</span>
                    </a>
                    <a asp-controller="Tenants" asp-action="Create" class="action-btn">
                        <div class="btn-icon" style="background:rgba(16,185,129,0.10)">
                            <svg viewBox="0 0 24 24" stroke="#10b981">
                                <line x1="12" y1="5" x2="12" y2="19"/>
                                <line x1="5" y1="12" x2="19" y2="12"/>
                            </svg>
                        </div>
                        <span class="btn-label">Nuevo tenant</span>
                    </a>
                    <a asp-controller="AdminGlobalUsuarios" asp-action="Tenants" class="action-btn">
                        <div class="btn-icon" style="background:rgba(139,92,246,0.12)">
                            <svg viewBox="0 0 24 24" stroke="#8b5cf6">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                <path d="M7 11V7a5 5 0 0110 0v4"/>
                            </svg>
                        </div>
                        <span class="btn-label">Usuarios globales</span>
                    </a>
                </div>
            </div>
        </div>
    }

    @if ((User.IsInRole("Caja") || User.IsInRole("Admin")) && ViewBag.StockBajo != null && ViewBag.StockBajo.Count > 0)
    {
        <div class="stock-card">
            <div class="stock-card-header">
                <div class="stock-card-header-left">
                    <svg viewBox="0 0 24 24">
                        <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                        <line x1="12" y1="9" x2="12" y2="13"/>
                        <line x1="12" y1="17" x2="12.01" y2="17"/>
                    </svg>
                    <span>Productos con stock bajo (@ViewBag.StockBajo.Count)</span>
                </div>
            </div>
            <div class="stock-table-wrap">
                <table class="stock-table">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Stock</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in ViewBag.StockBajo)
                        {
                            <tr>
                                <td>@p.Nombre</td>
                                <td><span class="badge-stock">@p.Stock unidades</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

<script>
    function toggleSection(id) {
        const card = document.getElementById('card-' + id);
        const body = document.getElementById('body-' + id);
        const isOpen = card.classList.contains('open');

        // Cerrar todas
        document.querySelectorAll('.section-card').forEach(c => {
            c.classList.remove('open');
            const b = c.querySelector('.section-body');
            if (b) b.style.maxHeight = '0';
        });

        // Abrir la clickeada si estaba cerrada
        if (!isOpen) {
            card.classList.add('open');
            body.style.maxHeight = body.scrollHeight + 'px';
        }
    }
</script>
