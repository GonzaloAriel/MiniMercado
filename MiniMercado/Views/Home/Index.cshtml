                            <svg viewBox="0 0 24 24" stroke="#64748b">
                                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                <polyline points="14 2 14 8 20 8"/>
                                <line x1="16" y1="13" x2="8" y2="13"/>
                                <line x1="16" y1="17" x2="8" y2="17"/>
                            </svg>
                        </div>
                        <span class="btn-label">Auditorías</span>
                    </a>
                    <a asp-controller="Caja" asp-action="Historial" class="action-btn">
                        <div class="btn-icon" style="background:rgba(100,116,139,0.10)">
                            <svg viewBox="0 0 24 24" stroke="#64748b">
                                <polyline points="12 8 12 12 14 14"/>
