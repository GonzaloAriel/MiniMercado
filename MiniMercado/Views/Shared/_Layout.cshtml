<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MiniMercado</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MiniMercado.styles.css" asp-append-version="true" />
</head>


<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom mb-4">
            <div class="container-fluid">

                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="~/images/Bird_Lime_Nav_2.png" height="40" class="me-2" alt="Logo" />
                </a>


                <button class="navbar-toggler border-0" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">

                    <ul class="navbar-nav me-auto">

                        @if (User.IsInRole("Admin") || User.IsInRole("Caja"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Venta"
                                   asp-action="Create">
                                    <i class="bi bi-cart-plus me-1"></i> Nueva Venta
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Venta"
                                   asp-action="Index">
                                    <i class="bi bi-receipt me-1"></i> Ventas
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Venta"
                                   asp-action="Caja">
                                    <i class="bi bi-cash-stack me-1"></i> Caja
                                </a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Productos"
                                       asp-action="Index">
                                        <i class="bi bi-box-seam me-1"></i> Productos
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="MovimientoStock"
                                       asp-action="Ingreso">
                                        <i class="bi bi-arrow-down-up me-1"></i> Stock
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-flex align-items-center">
                        <button id="toggleDark"
                                class="btn btn-link text-white-50 p-2 me-3 shadow-none border-0"
                                title="Cambiar modo">
                            <i class="bi bi-moon-stars-fill fs-5"></i>
                        </button>

                        <!-- LOGIN / LOGOUT -->
                        <partial name="_LoginPartial" />
                    </div>

                </div>
            </div>
        </nav>

    </header>
    <div class="container">
        <main role="main" class="pb-3 ">
            @RenderBody()
        </main>
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - MiniMercado - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)


    <script>
        const toggleBtn = document.getElementById("toggleDark");
        const icon = toggleBtn.querySelector("i");

        // Cargar preferencia guardada
        if (localStorage.getItem("darkMode") === "true") {
            document.body.classList.add("dark-mode");
            icon.classList.replace("bi-moon-stars-fill", "bi-sun-fill");
        }

        toggleBtn.addEventListener("click", function () {
            document.body.classList.toggle("dark-mode");

            const isDark = document.body.classList.contains("dark-mode");
            localStorage.setItem("darkMode", isDark);

            if (isDark) {
                icon.classList.replace("bi-moon-stars-fill", "bi-sun-fill");
            } else {
                icon.classList.replace("bi-sun-fill", "bi-moon-stars-fill");
            }
        });
    </script>

</body>
</html>
