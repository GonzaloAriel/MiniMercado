@using MiniMercado.Services
@inject ISuscripcionService SuscripcionService
@inject ITenantService TenantService

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MiniMercado</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/uala-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MiniMercado.styles.css" asp-append-version="true" />
    <style>
        .sub-alert-bar {
            background: #ef4444;
            color: white;
            text-align: center;
            padding: 8px;
            font-size: 14px;
            font-weight: 600;
            z-index: 2000;
        }
        .sub-alert-bar.warning { background: #f59e0b; }
        .sub-alert-bar a { color: white; text-decoration: underline; margin-left: 10px; }

        .notif-dropdown {
            width: 320px;
            max-width: 90vw;
            max-height: 450px;
            overflow-y: auto;
            right: 0;
            left: auto;
        }

       @@media (max-width: 768px) {
    
           .notif-dropdown {
                position: fixed !important;
                top: 60px;
                right: 10px;
                width: 90vw;
                z-index: 1050;
           }
       }
    </style>
    <script>
        // Aplicar modo antes de renderizar para evitar flash
        if (localStorage.getItem("darkMode") === "true") {
            document.documentElement.classList.add("dark-mode");
            document.addEventListener("DOMContentLoaded", () => document.body.classList.add("dark-mode"));
        }
    </script>
</head>


<body>
    @if (User.Identity.IsAuthenticated && !User.IsInRole("AdminGlobal"))
    {
        var tenantId = TenantService.GetTenantId();
        if (tenantId.HasValue)
        {
            var tenant = SuscripcionService.GetSuscripcionActualAsync(tenantId.Value).Result;
           

            if (tenant != null && tenant.FechaVencimiento.HasValue)
            {
                var diasRestantes = (tenant.FechaVencimiento.Value - DateTime.Now).TotalDays;
                
                string bannerTipo = "";
                string mensaje = "";

                // Período de gracia: 5 días después del vencimiento (Red)
                if (diasRestantes <= 0 && diasRestantes >= -5)
                {
                    bannerTipo = "danger";
                    mensaje = "Su suscripción está VENCIDA. Dispone de un período de gracia para regularizar su pago y evitar el bloqueo del servicio.";
                }
                // Aviso previo: 5 días antes del vencimiento (Orange)
                else if (diasRestantes > 0 && diasRestantes <= 5)
                {
                    bannerTipo = "warning";
                    mensaje = $"Su suscripción vence en {Math.Ceiling(diasRestantes)} días. Evite cortes en el servicio regularizando su pago.";
                }

                if (!string.IsNullOrEmpty(bannerTipo))
                {
                    <div id="sub-banner" class="sub-alert-bar @(bannerTipo == "warning" ? "warning" : "")" style="display:none;">
                        <div class="container-fluid d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1 text-center">
                                <i class="bi @(bannerTipo == "danger" ? "bi-exclamation-octagon-fill" : "bi-clock-fill") me-2"></i> 
                                <span>@mensaje</span>
                                <a asp-controller="Configuracion" asp-action="Suscripcion" class="ms-2">Ver detalles de pago</a>
                            </div>
                            <button type="button" class="btn-close btn-close-white shadow-none" onclick="dismissBanner()" aria-label="Close"></button>
                        </div>
                    </div>
                    <script>
                        function dismissBanner() {
                            const hoy = new Date().toISOString().split('T')[0];
                            localStorage.setItem("bannerSuscripcionOculto_" + hoy, "true");
                            document.getElementById("sub-banner").style.display = "none";
                        }

                        document.addEventListener("DOMContentLoaded", function() {
                            const hoy = new Date().toISOString().split('T')[0];
                            if (!localStorage.getItem("bannerSuscripcionOculto_" + hoy)) {
                                document.getElementById("sub-banner").style.display = "block";
                            }
                        });
                    </script>
                }
            }
        }
    }

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom mb-4 sticky-top">
            <div class="container-fluid">

                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="~/Images/Minimercado.png" class="navbar-logo-modern me-2" alt="Logo" />
                </a>


                <button class="navbar-toggler border-0 shadow-none text-secondary" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav">
                    <i class="bi bi-list fs-2"></i>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">

                    <ul class="navbar-nav me-auto">

                        @if (User.Identity.IsAuthenticated)
                        {
                            @* Vender y Ventas: VentaController es [Authorize(Roles = "Admin,Caja")].
                               AdminGlobal es back-office (D-014): no entra al POS. *@
                            @if (User.IsInRole("Admin") || User.IsInRole("Caja"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Venta" asp-action="Create">
                                        <i class="bi bi-cart-plus me-1"></i> Vender
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Venta" asp-action="Index">
                                        <i class="bi bi-receipt me-1"></i> Ventas
                                    </a>
                                </li>
                            }

                            @* Análisis Comercial: AnalisisComercialController es solo [Authorize(Roles = "Admin")]. *@
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="AnalisisComercial" asp-action="Index">
                                        <i class="bi bi-graph-up-arrow me-1"></i> Análisis Comercial
                                    </a>
                                </li>
                            }

                            @* Finanzas: EgresosController y FinanzasController son [Authorize(Roles = "Admin,Caja")]. *@
                            @if (User.IsInRole("Admin") || User.IsInRole("Caja"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="navbarFinanzas" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-bank me-1"></i> Finanzas
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-dark border-0 shadow animated fadeIn" aria-labelledby="navbarFinanzas">
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Egresos" asp-action="Index">
                                                <i class="bi bi-cash-coin me-2"></i>Egresos
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Finanzas" asp-action="Dashboard">
                                                <i class="bi bi-graph-up-arrow me-2"></i>Dashboard Financiero
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Productos" asp-action="Index">
                                        <i class="bi bi-box-seam me-1"></i> Productos
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Proveedores" asp-action="Index">
                                        <i class="bi bi-truck me-1"></i> Proveedores
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-flex align-items-center text-black">
                        <!-- 💰 Estado de Caja -->
                        @await Component.InvokeAsync("CajaStatus")

                        <!-- 🔔 Notificaciones -->
                        @if (User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown me-3 text-info">
                                <button class="btn btn-link text-secondary p-2 shadow-none border-0 position-relative"
                                        type="button" id="notifDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-bell fs-5"></i>
                                    <span id="notifCount" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" style="font-size: 0.6rem;">
                                        0
                                    </span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-custom animated fadeIn p-0 notif-dropdown" 
                                            aria-labelledby="notifDropdown">
                                    <li class="p-3 border-bottom d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0 fw-bold text-info">Notificaciones</h6>
                                        <span class="badge bg-primary rounded-pill" id="notifCountBadge">0</span>
                                    </li>
                                    <div id="notifList">
                                        <li class="p-4 text-center text-muted">
                                            <div class="spinner-border spinner-border-sm mb-2" role="status"></div>
                                            <p class="mb-0 small text-info">Cargando...</p>
                                        </li>
                                    </div>
                                    <li class="text-center p-2 border-top">
                                        <small class="text-muted text-info">Mostrando últimas no leídas</small>
                                    </li>
                                </ul>
                            </div>
                        }

                        <button id="toggleDark"
                                class="btn btn-link text-secondary p-2 me-3 shadow-none border-0"
                                title="Cambiar modo">
                            <i class="bi bi-moon-stars-fill fs-5"></i>
                        </button>

                        <!-- LOGIN / LOGOUT -->
                        <partial name="_LoginPartial" />
                    </div>

                </div>
            </div>
        </nav>

    </header>
    <div class="container-fluid px-lg-5 text-black">
        <main role="main" class="pb-5 text-black">
            @RenderBody()
        </main>
        
        <div class="container">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger border-0 shadow-sm rounded-4 mb-4">
                    <i class="bi bi-exclamation-octagon me-2"></i> @TempData["Error"]
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success border-0 shadow-sm rounded-4 mb-4">
                    <i class="bi bi-check-circle me-2"></i> @TempData["Success"]
                </div>
            }
        </div>
    </div>

    <footer class="footer text-muted">
        <div class="container text-center">
            <small>&copy; 2026 - MiniMercado · Sistema de Gestión Inteligente</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        const toggleBtn = document.getElementById("toggleDark");
        const icon = toggleBtn.querySelector("i");

        // Función para actualizar el icono
        function updateIcon(isDark) {
            if (isDark) {
                icon.classList.replace("bi-moon-stars-fill", "bi-sun-fill");
            } else {
                icon.classList.replace("bi-sun-fill", "bi-moon-stars-fill");
            }
        }

        // Cargar preferencia guardada
        const isDarkStored = localStorage.getItem("darkMode") === "true";
        if (isDarkStored) {
            document.body.classList.add("dark-mode");
            updateIcon(true);
        }

        toggleBtn.addEventListener("click", function () {
            document.body.classList.toggle("dark-mode");
            const isDark = document.body.classList.contains("dark-mode");
            localStorage.setItem("darkMode", isDark);
            updateIcon(isDark);
        });
    </script>

    @if (User.Identity.IsAuthenticated)
    {
        <script>
            function cargarNotificaciones() {
                $.get("/Notificaciones/Get", function (data) {
                    const list = $("#notifList");
                    const count = $("#notifCount");
                    const badge = $("#notifCountBadge");

                    list.empty();

                    if (data.length > 0) {
                        count.text(data.length).removeClass("d-none");
                        badge.text(data.length);

                        data.forEach(n => {
                            const fecha = new Date(n.fecha).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
                            let iconNotif = "bi-info-circle";
                            let color = "text-primary";

                            if (n.tipo === "Stock") { iconNotif = "bi-exclamation-triangle"; color = "text-danger"; }
                            if (n.tipo === "Pago") { iconNotif = "bi-credit-card"; color = "text-warning"; }

                            const item = `
                                <li class="notif-item p-3 border-bottom position-relative" style="cursor:pointer" onclick="marcarLeida(${n.id}, '${n.url}')">
                                    <div class="d-flex align-items-start">
                                        <div class="${color} me-3 mt-1">
                                            <i class="bi ${iconNotif} fs-5"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="fw-bold small">@* Titulo *@ ${n.titulo}</span>
                                                <span class="text-muted" style="font-size: 0.65rem;">${fecha}</span>
                                            </div>
                                            <p class="mb-0 text-muted small" style="line-height:1.2">${n.mensaje}</p>
                                        </div>
                                    </div>
                                </li>`;
                            list.append(item);
                        });
                    } else {
                        count.addClass("d-none");
                        badge.text("0");
                        list.append('<li class="p-4 text-center text-muted small">No hay notificaciones nuevas</li>');
                    }
                });
            }

            function marcarLeida(id, url) {
                $.post("/Notificaciones/MarcarLeida", { id: id }, function () {
                    if (url && url !== "null") {
                        window.location.href = url;
                    } else {
                        cargarNotificaciones();
                    }
                });
            }

            setInterval(cargarNotificaciones, 20000);
            $(document).ready(cargarNotificaciones);
        </script>
    }
    @if (User.Identity.IsAuthenticated)
    {
        <!-- BURBUJA DE NOVEDADES -->
        <div id="novedades-bubble" class="novedades-bubble-wrap" style="display:none;">
            <div class="novedades-bubble-content">
                <button type="button" class="btn-close-novedades" onclick="dismissNovedades()">✕</button>
                <div class="novedades-bubble-body">
                    <div class="novedades-icon-top">💜 Novedades</div>
                    <h5 class="novedades-bubble-title">📈 Analisis Comercial</h5>
                    <p class="novedades-bubble-text">Analizá tu negocio con nuevos reportes avanzados.</p>
                    <hr class="novedades-divider">
                    <h5 class="novedades-bubble-title">🏷 Módulo de Etiquetas</h5>
                    <p class="novedades-bubble-text">Creá y gestioná etiquetas para tus productos.</p>
                    <a asp-controller="Home" asp-action="Novedades" class="btn-novedades-action" onclick="dismissNovedades()">Ver todas las novedades</a>
                </div>
            </div>
        </div>

        <style>
            .novedades-bubble-wrap {
                position: fixed;
                bottom: 30px;
                right: 30px;
                width: 300px;
                z-index: 9999;
                animation: slideInUp 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            }

            .novedades-bubble-content {
                background: var(--bg-card);
                border: 1px solid var(--border);
                border-radius: 24px;
                box-shadow: 0 15px 45px rgba(0,0,0,0.15);
                padding: 24px;
                position: relative;
                overflow: hidden;
            }

            body.dark-mode .novedades-bubble-content {
                box-shadow: 0 15px 45px rgba(0,0,0,0.4);
            }

            .btn-close-novedades {
                position: absolute;
                top: 12px;
                right: 12px;
                background: none;
                border: none;
                color: var(--text-muted);
                font-size: 18px;
                cursor: pointer;
                padding: 5px;
                line-height: 1;
                transition: color 0.2s;
            }

            .btn-close-novedades:hover {
                color: var(--text-primary);
            }

            .novedades-icon-top {
                font-size: 0.9rem;
                font-weight: 800;
                color: #6366f1;
                margin-bottom: 12px;
            }

            .novedades-bubble-title {
                font-size: 14px;
                font-weight: 700;
                margin-bottom: 4px;
                color: var(--text-primary);
            }

            .novedades-bubble-text {
                font-size: 13px;
                color: var(--text-secondary);
                line-height: 1.4;
                margin-bottom: 12px;
            }

            .novedades-divider {
                margin: 12px 0;
                opacity: 0.1;
            }

            .btn-novedades-action {
                display: block;
                width: 100%;
                background: #6366f1;
                color: white;
                text-align: center;
                padding: 10px;
                border-radius: 12px;
                text-decoration: none !important;
                font-size: 13px;
                font-weight: 600;
                margin-top: 15px;
                transition: transform 0.2s, background 0.2s;
            }

            .btn-novedades-action:hover {
                background: #4f46e5;
                transform: translateY(-2px);
                color: white;
            }

            @@keyframes slideInUp {
                from { transform: translateY(100px); opacity: 0; }
                to { transform: translateY(0); opacity: 1; }
            }

            @@media (max-width: 480px) {
                .novedades-bubble-wrap {
                    right: 15px;
                    left: 15px;
                    bottom: 20px;
                    width: auto;
                }
            }
        </style>

        <script>
            function dismissNovedades() {
                localStorage.setItem("minimercado_novedades_v3", "true");
                document.getElementById("novedades-bubble").style.display = "none";
            }

            document.addEventListener("DOMContentLoaded", function() {
                if (!localStorage.getItem("minimercado_novedades_v3")) {
                    setTimeout(() => {
                        document.getElementById("novedades-bubble").style.display = "block";
                    }, 2000);
                }
            });
        </script>
    }
</body>
</html>
