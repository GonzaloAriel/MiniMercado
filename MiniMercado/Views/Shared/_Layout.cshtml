<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MiniMercado</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MiniMercado.styles.css" asp-append-version="true" />
</head>


<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom mb-4">
            <div class="container-fluid">

                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="~/images/Bird_Lime_Nav_2.png" height="40" class="me-2" alt="Logo" />
                </a>


                <button class="navbar-toggler border-0" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">

                    <ul class="navbar-nav me-auto">

                        @if (User.IsInRole("Admin") || User.IsInRole("Caja"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Venta"
                                   asp-action="Create">
                                    <i class="bi bi-cart-plus me-1"></i> Nueva Venta
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Venta"
                                   asp-action="Index">
                                    <i class="bi bi-receipt me-1"></i> Ventas
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Venta"
                                   asp-action="Caja">
                                    <i class="bi bi-cash-stack me-1"></i> Caja
                                </a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Productos"
                                       asp-action="Index">
                                        <i class="bi bi-box-seam me-1"></i> Productos
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="MovimientoStock"
                                       asp-action="Ingreso">
                                        <i class="bi bi-arrow-down-up me-1"></i> Stock
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-flex align-items-center">
                        <!-- 🔔 Notificaciones -->
                        @if (User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown me-2">
                                <button class="btn btn-link text-white-50 p-2 shadow-none border-0 position-relative"
                                        type="button" id="notifDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-bell-fill fs-5"></i>
                                    <span id="notifCount" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">
                                        0
                                    </span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-custom animated fadeIn p-0 text-info" 
                                    aria-labelledby="notifDropdown" style="width: 320px; max-height: 450px; overflow-y: auto;">
                                    <li class="p-3 border-bottom d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0 fw-bold">Notificaciones</h6>
                                        <span class="badge bg-primary rounded-pill" id="notifCountBadge">0</span>
                                    </li>
                                    <div id="notifList">
                                        <!-- Se carga via AJAX -->
                                        <li class="p-4 text-center text-muted">
                                            <div class="spinner-border spinner-border-sm mb-2" role="status"></div>
                                            <p class="mb-0 small text-light">Cargando...</p>
                                        </li>
                                    </div>
                                    <li class="text-center p-2 border-top">
                                        <small class="text-muted text-info">Mostrando últimas no leídas</small>
                                    </li>
                                </ul>
                            </div>
                        }

                        <button id="toggleDark"
                                class="btn btn-link text-white-50 p-2 me-3 shadow-none border-0"
                                title="Cambiar modo">
                            <i class="bi bi-moon-stars-fill fs-5"></i>
                        </button>

                        <!-- LOGIN / LOGOUT -->
                        <partial name="_LoginPartial" />
                    </div>

                </div>
            </div>
        </nav>

    </header>
    <div class="container">
        <main role="main" class="pb-3 ">
            @RenderBody()
        </main>
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - MiniMercado - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)


    <script>
        const toggleBtn = document.getElementById("toggleDark");
        const icon = toggleBtn.querySelector("i");

        // Cargar preferencia guardada
        if (localStorage.getItem("darkMode") === "true") {
            document.body.classList.add("dark-mode");
            icon.classList.replace("bi-moon-stars-fill", "bi-sun-fill");
        }

        toggleBtn.addEventListener("click", function () {
            document.body.classList.toggle("dark-mode");

            const isDark = document.body.classList.contains("dark-mode");
            localStorage.setItem("darkMode", isDark);

            if (isDark) {
                icon.classList.replace("bi-moon-stars-fill", "bi-sun-fill");
            } else {
                icon.classList.replace("bi-sun-fill", "bi-moon-stars-fill");
            }
        });
    </script>

    @if (User.Identity.IsAuthenticated)
    {
        <script>
            function cargarNotificaciones() {
                $.get("/Notificaciones/Get", function (data) {
                    const list = $("#notifList");
                    const count = $("#notifCount");
                    const badge = $("#notifCountBadge");

                    list.empty();

                    if (data.length > 0) {
                        count.text(data.length).removeClass("d-none");
                        badge.text(data.length);

                        data.forEach(n => {
                            const fecha = new Date(n.fecha).toLocaleString();
                            let icon = "bi-info-circle";
                            let color = "text-primary";

                            if (n.tipo === "Stock") { icon = "bi-exclamation-triangle"; color = "text-danger"; }
                            if (n.tipo === "Pago") { icon = "bi-credit-card"; color = "text-warning"; }

                            const item = `
                                <li class="notif-item p-3 border-bottom position-relative" onclick="marcarLeida(${n.id}, '${n.url}')">
                                    <div class="d-flex align-items-start">
                                        <div class="${color} me-3 mt-1">
                                            <i class="bi ${icon} fs-5"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="fw-bold small">${n.titulo}</span>
                                                <span class="text-muted" style="font-size: 0.7rem;">${fecha}</span>
                                            </div>
                                            <p class="mb-0 text-muted small text-light">${n.mensaje}</p>
                                        </div>
                                    </div>
                                </li>`;
                            list.append(item);
                        });
                    } else {
                        count.addClass("d-none");
                        badge.text("0");
                                list.append('<li class="p-4 text-center text-muted small text-light">No hay notificaciones nuevas</li>');
                    }
                });
            }

            function marcarLeida(id, url) {
                $.post("/Notificaciones/MarcarLeida", { id: id }, function () {
                    if (url && url !== "null") {
                        window.location.href = url;
                    } else {
                        cargarNotificaciones();
                    }
                });
            }

            // Polling cada 10 seg
            setInterval(cargarNotificaciones, 10000);
            $(document).ready(cargarNotificaciones);
        </script>
    }

</body>
</html>
