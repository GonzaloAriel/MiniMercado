<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MiniMercado</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MiniMercado.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-success">
            <div class="container-fluid">

                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    🏪 MiniMercado
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link fw-bold text-black"
                               asp-controller="Venta"
                               asp-action="Create">
                                🛒 Nueva Venta
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fw-bold text-black"
                               asp-controller="Venta"
                               asp-action="Index">
                                📄 Ventas
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fw-bold text-black"
                               asp-controller="Venta"
                               asp-action="Caja">
                                📊 Caja
                            </a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-bold text-black"
                                   asp-controller="Productos"
                                   asp-action="Index">
                                    📦 Productos
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-bold text-black"
                                   asp-controller="MovimientoStock"
                                   asp-action="Ingreso">
                                    ➕ Ingreso Stock
                                </a>
                            </li>
                        }

                    </ul>

                    <!-- LOGIN / LOGOUT -->
                    <ul class="navbar-nav ">
                        <partial name="_LoginPartial" />
                    </ul>

                </div>
            </div>
        </nav>

    </header>
    <div class="container">
        <main role="main" class="pb-3 ">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - MiniMercado - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
