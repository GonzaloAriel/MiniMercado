@model MiniMercado.Models.Caja

@if (Model != null)
{
    <li class="nav-item dropdown me-2">
        <a class="nav-link dropdown-toggle btn btn-outline-success border-0 px-3" href="#" id="cajaDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-wallet2 me-1"></i> Caja: <strong>$ @Model.TotalVentas.ToString("N2")</strong>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-3" aria-labelledby="cajaDropdown" style="width: 250px;">
            <li class="mb-2">
                <small class="text-muted d-block">Usuario actual</small>
                <strong>@User.Identity.Name</strong>
            </li>
            <li class="mb-2 border-top pt-2">
                <div class="d-flex justify-content-between small">
                    <span class="text-muted">Monto inicial:</span>
                    <span>$ @Model.MontoInicial.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between small">
                    <span class="text-muted">Ventas turno:</span>
                    <span class="text-success fw-bold">$ @Model.TotalVentas.ToString("N2")</span>
                </div>
            </li>
            <li class="mt-3">
                <a asp-action="CerrarCaja" asp-controller="Caja" class="btn btn-danger btn-sm w-100">
                    🔴 Cerrar Caja
                </a>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item me-2">
        <a asp-action="AbrirCaja" asp-controller="Caja" class="nav-link btn btn-outline-danger border-2 px-3 fw-bold pulse-red">
            <i class="bi bi-exclamation-circle-fill me-1"></i> Abrir Caja
        </a>
    </li>

    <style>
        .pulse-red {
            animation: pulse-red-animation 2s infinite;
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
        }

        @@keyframes pulse-red-animation {
            0% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
            }
            70% {
                transform: scale(1);
                box-shadow: 0 0 0 10px rgba(220, 53, 69, 0);
            }
            100% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
            }
        }
    </style>
}
