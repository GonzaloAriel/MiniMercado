@{
    ViewData["Title"] = "Dashboard Anual";
    var ventasPorMes = ViewBag.VentasPorMes;
    var productosTop = ViewBag.ProductosTop;
    var anioActual = ViewBag.Anio ?? DateTime.Today.Year;
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap');

    .db-wrap {
        font-family: 'DM Sans', system-ui, sans-serif;
        color: var(--text-primary);
        background: var(--bg-primary);
        padding: 40px 32px 64px;
        max-width: 1200px;
        margin: 0 auto;
        min-height: 100vh;
    }

    .db-header-left h1 {
        font-size: 36px;
        font-weight: 700;
        letter-spacing: -0.03em;
        margin: 0 0 6px;
        line-height: 1.2;
        color: var(--text-primary);
    }

    .db-header-left p {
        font-size: 17px;
        color: var(--text-secondary);
        margin: 0;
        font-family: 'DM Mono', monospace;
    }

    .db-year-badge {
        background: var(--bg-tertiary);
        color: var(--text-primary);
        font-size: 17px;
        font-weight: 600;
        padding: 8px 20px;
        border-radius: 30px;
        font-family: 'DM Mono', monospace;
        letter-spacing: .04em;
        border: 1px solid var(--border);
    }

    .section-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: .1em;
        margin: 32px 0 20px;
    }

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .kpi-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        padding: 28px 24px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        transition: all 0.3s ease;
    }

    .kpi-card:hover {
        transform: translateY(-4px);
        border-color: var(--blue);
        background: var(--bg-card-hover);
    }

    .kpi-label {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: .1em;
    }

    .kpi-value {
        font-size: 38px;
        font-weight: 700;
        font-family: 'DM Mono', monospace;
    }

    .kpi-value.green { color: var(--green-text); }
    .kpi-value.red { color: var(--red-text); }
    .kpi-value.blue { color: var(--blue-text); }
    .kpi-value.amber { color: var(--amber-text); }

    .charts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .chart-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        padding: 28px 24px;
    }

    .chart-card h5 {
        font-size: 18px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 24px;
    }

    /* Fixed container height for charts to prevent "infinite growth" */
    .chart-container {
        position: relative;
        height: 300px;
        width: 100%;
    }

    .data-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        overflow: hidden;
        margin-bottom: 24px;
    }

    .data-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 24px;
        border-bottom: 1px solid var(--border);
        background: var(--bg-tertiary);
    }

    .db-table {
        width: 100%;
        border-collapse: collapse;
    }

    .db-table th {
        padding: 14px 24px;
        text-align: left;
        font-size: 13px;
        font-weight: 700;
        color: var(--text-secondary);
        text-transform: uppercase;
        background: var(--bg-tertiary);
        border-bottom: 1px solid var(--border);
    }

    .db-table td {
        padding: 14px 24px;
        border-bottom: 1px solid var(--border-light);
        color: var(--text-primary);
    }

    .db-table tr:hover td { background: var(--bg-card-hover); }

    .btn-table {
        font-size: 13px;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--bg-surface);
        color: var(--text-secondary);
        text-decoration: none;
    }

    .btn-table:hover {
        background: var(--blue);
        color: #fff;
        border-color: var(--blue);
    }

    .stock-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .stock-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        overflow: hidden;
    }

    .stock-card-header {
        padding: 16px 24px;
        font-size: 16px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .stock-card-header.red { background: var(--red-bg); color: var(--red-text); }
    .stock-card-header.amber { background: var(--amber-bg); color: var(--amber-text); }

    .stock-item {
        display: flex;
        justify-content: space-between;
        padding: 16px 24px;
        border-bottom: 1px solid var(--border-light);
    }

    .stock-item:last-child { border-bottom: none; }

    .stock-name { font-weight: 600; color: var(--text-primary); }
    .stock-date { font-size: 12px; color: var(--text-muted); font-family: 'DM Mono', monospace; }

    @@media (max-width: 768px) {
        .charts-grid { grid-template-columns: 1fr; }
        .db-wrap { padding: 20px 16px; }
    }
</style>

<div class="db-wrap">
    <div class="db-header d-flex justify-content-between align-items-center mb-4">
        <div class="db-header-left">
            <h1>Dashboard Anual</h1>
            <p>Resumen de actividad comercial del minimercado</p>
        </div>
        <span class="db-year-badge">@anioActual</span>
    </div>

    <div class="kpi-grid">
        <div class="kpi-card">
            <span class="kpi-label">Ventas Totales</span>
            <span class="kpi-value green">$@ViewBag.TotalAnual.ToString("N0")</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Ventas Anuladas</span>
            <span class="kpi-value red">@ViewBag.Anuladas</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Ticket Promedio</span>
            <span class="kpi-value blue">$@ViewBag.TicketPromedio.ToString("N0")</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Bajo Stock</span>
            <span class="kpi-value amber">@ViewBag.StockBajoCount</span>
        </div>
    </div>

    <p class="section-title">Gráficos de Rendimiento</p>
    <div class="charts-grid">
        <div class="chart-card">
            <h5>Ventas por Mes</h5>
            <div class="chart-container">
                <canvas id="ventasChart"></canvas>
            </div>
        </div>
        <div class="chart-card">
            <h5>Top 5 Productos Vendidos</h5>
            <div class="chart-container">
                <canvas id="productosChart"></canvas>
            </div>
        </div>
    </div>

    <p class="section-title">Inventario y Stock</p>
    <div class="data-card">
        <div class="data-card-header">
            <h5 class="mb-0">Productos con Stock Crítico</h5>
            <a href="/Alertas/StockBajo" class="btn-table">Ver todos</a>
        </div>
        <table class="db-table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th style="text-align:center">Stock</th>
                    <th style="text-align:right">Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in ViewBag.BajoStock)
                {
                    <tr>
                        <td class="fw-bold">@p.Nombre</td>
                        <td style="text-align:center">
                            <span class="badge rounded-pill @(p.Stock <= 0 ? "bg-danger" : "bg-warning text-dark")">@p.Stock</span>
                        </td>
                        <td style="text-align:right">
                            <a href="/MovimientoStock/Ingreso?productoId=@p.Id" class="btn-table">Cargar Stock</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="section-title">Control de Vencimientos</p>
    <div class="stock-grid">
        <div class="stock-card">
            <div class="stock-card-header red">Productos Vencidos</div>
            @foreach (var p in ViewBag.ProductosVencidos)
            {
                <div class="stock-item">
                    <div>
                        <div class="stock-name">@p.Nombre</div>
                        <div class="stock-date">Venció: @p.Fecha.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="text-end">
                        <div class="fw-bold text-danger">@p.Cantidad uds</div>
                        <a href="/Productos/Detalle/@p.ProductoId" class="small text-muted">Ver lotes</a>
                    </div>
                </div>
            }
        </div>

        <div class="stock-card">
            <div class="stock-card-header amber">Próximos a Vencer (7 días)</div>
            @foreach (var p in ViewBag.ProductosPorVencer)
            {
                <div class="stock-item">
                    <div>
                        <div class="stock-name">@p.Nombre</div>
                        <div class="stock-date">Vence: @p.Fecha.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="text-end">
                        <div class="fw-bold text-warning">@p.Cantidad uds</div>
                        <a href="/Productos/Detalle/@p.ProductoId" class="small text-muted">Ver lotes</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctxVentas = document.getElementById('ventasChart');
        const ctxProds = document.getElementById('productosChart');

        const getThemeColors = () => {
            const isDark = document.body.classList.contains('dark-mode');
            return {
                text: isDark ? '#9ca3af' : '#4b5563',
                grid: isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)'
            };
        };

        let colors = getThemeColors();

        const vChart = new Chart(ctxVentas, {
            type: 'line',
            data: {
                labels: [@Html.Raw(string.Join(",", ((IEnumerable<dynamic>)ventasPorMes).Select(m => $"\"{System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m.Mes)}\"")))],
                datasets: [{
                    label: 'Ventas $',
                    data: [@string.Join(",", ((IEnumerable<dynamic>)ventasPorMes).Select(m => m.Total.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)))],
                    borderColor: '#10b981',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { grid: { color: colors.grid }, ticks: { color: colors.text } },
                    x: { grid: { color: colors.grid }, ticks: { color: colors.text } }
                }
            }
        });

        const pChart = new Chart(ctxProds, {
            type: 'bar',
            data: {
                labels: [@Html.Raw(string.Join(",", ((IEnumerable<dynamic>)productosTop).Select(p => $"\"{p.Producto}\"")))],
                datasets: [{
                    label: 'Cant. Vendida',
                    data: [@string.Join(",", ((IEnumerable<dynamic>)productosTop).Select(p => p.CantidadVendida))],
                    backgroundColor: '#3b82f6',
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                indexAxis: 'y',
                scales: {
                    y: { grid: { display: false }, ticks: { color: colors.text } },
                    x: { grid: { color: colors.grid }, ticks: { color: colors.text } }
                }
            }
        });

        // Observer optimizado: Solo actualizar si hay un cambio real de clase
        let lastClass = document.body.className;
        const observer = new MutationObserver(() => {
            if (document.body.className !== lastClass) {
                lastClass = document.body.className;
                const newColors = getThemeColors();
                [vChart, pChart].forEach(c => {
                    c.options.scales.y.grid.color = newColors.grid;
                    c.options.scales.y.ticks.color = newColors.text;
                    if(c.options.scales.x.grid) c.options.scales.x.grid.color = newColors.grid;
                    c.options.scales.x.ticks.color = newColors.text;
                    c.update('none'); // Update without animations to be faster and safer
                });
            }
        });
        observer.observe(document.body, { attributes: true, attributeFilter: ['class'] });
    </script>
}
