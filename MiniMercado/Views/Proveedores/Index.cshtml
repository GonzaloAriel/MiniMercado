@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Proveedores";
    var proveedores = ViewBag.Proveedores as IEnumerable<dynamic>;
}

<style>
    .card-custom {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        padding: 24px;
        margin-bottom: 24px;
    }

    .header-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        gap: 20px;
        flex-wrap: wrap;
    }

    .search-box {
        display: flex;
        gap: 8px;
        flex-grow: 1;
        max-width: 500px;
    }

    .btn-primary-custom {
        background-color: #16a34a;
        color: white;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: none;
        transition: background-color 0.2s;
    }

    .btn-primary-custom:hover {
        background-color: #15803d;
        color: white;
    }

    .alert-soft {
        background-color: #eff6ff;
        color: #1e40af;
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        border: 1px solid #bfdbfe;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .table-custom {
        width: 100%;
        border-collapse: collapse;
    }

    .table-custom th {
        text-align: left;
        padding: 12px;
        border-bottom: 2px solid #f4f4f5;
        color: #71717a;
        font-weight: 600;
    }

    .table-custom td {
        padding: 16px 12px;
        border-bottom: 1px solid #f4f4f5;
    }

    .form-control-custom {
        padding: 8px 12px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        width: 100%;
        transition: border-color 0.2s;
    }

    .form-control-custom:focus {
        outline: none;
        border-color: #16a34a;
    }

    .status-badge {
        padding: 4px 12px;
        border-radius: 9999px;
        font-size: 0.875rem;
        font-weight: 500;
    }

    .status-active {
        background-color: #dcfce7;
        color: #166534;
    }

    .status-inactive {
        background-color: #fee2e2;
        color: #991b1b;
    }

    .action-links {
        display: flex;
        gap: 12px;
    }

    .action-link {
        color: #71717a;
        text-decoration: none;
        transition: color 0.2s;
    }

    .action-link:hover {
        color: #18181b;
    }

    .btn-toggle {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        color: #71717a;
    }

    .btn-toggle.deactivate:hover {
        color: #dc2626;
    }

    .btn-toggle.activate:hover {
        color: #16a34a;
    }
</style>

<div class="header-section">
    <h1 style="font-size: 1.875rem; font-weight: 700; color: #18181b; margin: 0;">Proveedores</h1>
    
    <div class="search-box">
        <form asp-action="Index" method="get" style="display:contents">
            <input type="text" name="q" value="@ViewBag.CurrentFilter" class="form-control-custom" placeholder="Buscar por nombre o CUIT..." />
            <button type="submit" class="btn-primary-custom" style="background-color: #64748b">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.CurrentFilter) || Context.Request.Query.ContainsKey("proveedorId"))
            {
                <a asp-action="Index" class="btn-primary-custom" style="background-color: #f4f4f5; color: #71717a;">Limpiar</a>
            }
        </form>
    </div>

    <a asp-action="Create" class="btn-primary-custom">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Nuevo proveedor
    </a>
</div>

@if (ViewBag.MensajeInfo != null)
{
    <div class="alert-soft">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
        @ViewBag.MensajeInfo
    </div>
}

<div class="card-custom">
    <table class="table-custom">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>CUIT</th>
                <th>Contacto</th>
                <th>Teléfono</th>
                <th style="text-align:center">Productos</th>
                <th>Estado</th>
                <th style="text-align:right">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in proveedores)
            {
                <tr>
                    <td style="font-weight: 600; color: #18181b;">@item.Nombre</td>
                    <td>@(item.CUIT ?? "-")</td>
                    <td>@(item.Contacto ?? "-")</td>
                    <td>@item.Telefono</td>
                    <td style="text-align:center">@item.CantidadProductos</td>
                    <td>
                        @if (item.Activo)
                        {
                            <span class="status-badge status-active">Activo</span>
                        }
                        else
                        {
                            <span class="status-badge status-inactive">Inactivo</span>
                        }
                    </td>
                    <td class="action-links" style="justify-content: flex-end;">
                        <a asp-action="Detalle" asp-route-id="@item.Id" class="action-link" title="Ver detalle">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="action-link" title="Editar">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                        </a>
                        <form asp-action="ToggleActivo" asp-route-id="@item.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn-toggle @(item.Activo ? "deactivate" : "activate")" title="@(item.Activo ? "Desactivar" : "Activar")">
                                @if (item.Activo)
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="9" x2="15" y2="15"></line><line x1="15" y1="9" x2="9" y2="15"></line></svg>
                                }
                                else
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                }
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
