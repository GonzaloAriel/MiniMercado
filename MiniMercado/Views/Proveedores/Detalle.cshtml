@model MiniMercado.Models.Proveedor
@{
    ViewData["Title"] = "Detalle de Proveedor";
}

<style>
    .card-custom {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        padding: 32px;
        margin-bottom: 24px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 24px;
        margin-bottom: 32px;
    }

    .info-item label {
        display: block;
        font-size: 0.875rem;
        color: #71717a;
        margin-bottom: 4px;
        font-weight: 500;
    }

    .info-item span {
        display: block;
        font-size: 1.125rem;
        color: #18181b;
        font-weight: 600;
    }

    .table-custom {
        width: 100%;
        border-collapse: collapse;
    }

    .table-custom th {
        text-align: left;
        padding: 12px;
        border-bottom: 2px solid #f4f4f5;
        color: #71717a;
        font-weight: 600;
    }

    .table-custom td {
        padding: 16px 12px;
        border-bottom: 1px solid #f4f4f5;
    }

    .btn-back {
        background-color: #f4f4f5;
        color: #71717a;
        padding: 10px 24px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-edit {
        background-color: #16a34a;
        color: white;
        padding: 10px 24px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .section-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #18181b;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
</style>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <h1 style="font-size: 1.875rem; font-weight: 700; color: #18181b; margin: 0;">Ficha de Proveedor</h1>
    <div style="display: flex; gap: 12px;">
        <a asp-action="Index" class="btn-back">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            Volver
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-edit">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
            Editar
        </a>
    </div>
</div>

<div class="card-custom">
    <div class="info-grid">
        <div class="info-item">
            <label>Nombre / Razón Social</label>
            <span>@Model.Nombre</span>
        </div>
        <div class="info-item">
            <label>Contacto</label>
            <span>@(Model.Contacto ?? "-")</span>
        </div>
        <div class="info-item">
            <label>Teléfono</label>
            <span>@Model.Telefono</span>
        </div>
        <div class="info-item">
            <label>CUIT</label>
            <span>@(Model.CUIT ?? "-")</span>
        </div>
        <div class="info-item">
            <label>Email</label>
            <span>@(Model.Email ?? "-")</span>
        </div>
        <div class="info-item">
            <label>Fecha Alta</label>
            <span>@Model.FechaAlta.ToString("dd/MM/yyyy")</span>
        </div>
    </div>

    <div class="info-item" style="margin-bottom: 24px;">
        <label>Dirección</label>
        <span style="font-size: 1rem;">@(Model.Direccion ?? "-")</span>
    </div>

    <div class="info-item">
        <label>Notas</label>
        <p style="color: #4b5563; line-height: 1.5; margin: 0;">@(Model.Notas ?? "Sin observaciones adicionales.")</p>
    </div>
</div>

<h2 class="section-title">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
    Productos Asociados
</h2>

<div class="card-custom" style="padding: 0;">
    <table class="table-custom">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Stock actual</th>
                <th>Precio Costo</th>
                <th>Principal</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Productos != null && Model.Productos.Any())
            {
                foreach (var producto in Model.Productos)
                {
                    <tr>
                        <td style="font-weight: 500;">@producto.NombreDisplay</td>
                        <td>@producto.Stock</td>
                        <td>-</td> @* Precio costo logic pending if intermediate table is used here *@
                        <td>
                            @if (producto.ProveedorId == Model.Id)
                            {
                                <span style="color: #16a34a; font-weight: 600;">Sí</span>
                            }
                            else
                            {
                                <span>No</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" style="text-align: center; color: #71717a; padding: 32px;">No hay productos asociados a este proveedor.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
