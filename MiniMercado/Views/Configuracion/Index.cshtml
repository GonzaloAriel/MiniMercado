@model MiniMercado.Models.Tenant

@{
    ViewData["Title"] = "Configuración del Negocio";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap');

    .db-wrap {
        font-family: 'DM Sans', system-ui, sans-serif;
        color: var(--text-primary);
        background: var(--bg-primary);
        padding: 40px 24px 64px;
        max-width: 800px;
        margin: 0 auto;
        min-height: 100vh;
    }

    .db-header {
        margin-bottom: 32px;
        text-align: center;
    }

    .db-header h1 {
        font-size: 32px;
        font-weight: 700;
        letter-spacing: -0.03em;
        margin: 0 0 8px;
        color: var(--text-primary);
    }

    .data-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        padding: 32px;
        margin-bottom: 24px;
    }

    .form-label-modern {
        font-size: 13px;
        font-weight: 700;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: .05em;
        margin-bottom: 8px;
        display: block;
    }

    .form-control-modern {
        background: var(--bg-surface);
        border: 1px solid var(--border);
        color: var(--text-primary);
        border-radius: 12px;
        padding: 12px 16px;
        font-size: 15px;
        width: 100%;
        transition: all 0.2s;
    }

    .form-control-modern:focus {
        border-color: var(--blue);
        outline: none;
        box-shadow: 0 0 0 3px var(--blue-bg);
    }

    .btn-modern {
        font-size: 15px;
        font-weight: 700;
        padding: 14px 24px;
        border-radius: 12px;
        transition: all 0.2s;
        border: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        cursor: pointer;
        width: 100%;
    }

    .btn-modern.success { background: var(--green); color: #fff; }
    .btn-modern:hover { transform: translateY(-2px); opacity: 0.9; }

    .settings-group {
        border-top: 1px solid var(--border);
        padding-top: 24px;
        margin-top: 24px;
    }

    .feature-toggle {
        background: var(--bg-tertiary);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .feature-toggle-info h5 {
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 4px;
        color: var(--blue-text);
    }

    .feature-toggle-info p {
        font-size: 13px;
        color: var(--text-muted);
        margin: 0;
    }

    .form-check-input {
        width: 44px !important;
        height: 24px !important;
        cursor: pointer;
    }

    .alert-modern {
        background: var(--green-bg);
        border: 1px solid var(--green);
        color: var(--green-text);
        padding: 16px 24px;
        border-radius: 12px;
        margin-bottom: 24px;
        font-weight: 600;
        text-align: center;
    }
</style>

<div class="db-wrap">
    
    <div class="db-header">
        <h1>Configuración del Negocio</h1>
        <p class="text-muted">Personaliza los datos que aparecen en tus comprobantes</p>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert-modern">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Mensaje"]
        </div>
    }

    <div class="data-card">
        <form asp-action="Index" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-4">
                <label asp-for="NombreComercio" class="form-label-modern">Nombre del Comercio</label>
                <input asp-for="NombreComercio" class="form-control-modern" placeholder="Ej: Minimercado El Sol" />
                <span asp-validation-for="NombreComercio" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Direccion" class="form-label-modern">Dirección</label>
                    <input asp-for="Direccion" class="form-control-modern" placeholder="Ej: Av. Principal 123" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Telefono" class="form-label-modern">Teléfono de Contacto</label>
                    <input asp-for="Telefono" class="form-control-modern" placeholder="Ej: 011-1234-5678" />
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label-modern">Email Corporativo</label>
                    <input asp-for="Email" class="form-control-modern" placeholder="Ej: admin@comercio.com" />
                </div>
                <div class="col-md-6">
                    <label asp-for="CUIT" class="form-label-modern">CUIT / Identificación Fiscal</label>
                    <input asp-for="CUIT" class="form-control-modern" placeholder="Ej: 20-12345678-9" />
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="MensajeTicket" class="form-label-modern">Mensaje en Ticket</label>
                <input asp-for="MensajeTicket" class="form-control-modern" placeholder="Ej: ¡Gracias por su preferencia!" />
            </div>

            <div class="settings-group mb-5">
                <div class="feature-toggle">
                    <div class="feature-toggle-info">
                        <h5>💰 Sistema de Cajas</h5>
                        <p>Habilita el control estricto de apertura y cierre diario.</p>
                    </div>
                    <div class="form-check form-switch p-0 m-0">
                        <input class="form-check-input ms-0 shadow-none" type="checkbox" id="UsarCaja" name="UsarCaja" value="true" @(ViewBag.UsarCaja ? "checked" : "")>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn-modern success mb-3">
                <i class="bi bi-save2"></i> Guardar Cambios
            </button>

            <div class="border-top pt-4 mt-2">
                <a asp-action="Suscripcion" class="btn-modern outline w-100" style="background: var(--bg-surface); border: 1px solid var(--border); color: var(--blue-text);">
                    <i class="bi bi-credit-card-2-front"></i> Gestionar Mi Suscripción
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
