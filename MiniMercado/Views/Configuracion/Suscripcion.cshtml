@model MiniMercado.Models.Tenant
@{
    ViewData["Title"] = "Mi Suscripción";
    var estado = (MiniMercado.Models.EstadoSuscripcion)ViewBag.EstadoCalculado;
    var diasRestantes = (int)ViewBag.DiasRestantes;
}

<style>
    .sub-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 32px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

    .status-badge-lg {
        padding: 8px 20px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 14px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .status-active { background: #dcfce7; color: #166534; }
    .status-warning { background: #fef9c3; color: #854d0e; }
    .status-danger { background: #fee2e2; color: #991b1b; }
    .status-neutral { background: #f3f4f6; color: #374151; }

    .kpi-sub {
        background: var(--bg-surface);
        border: 1px solid var(--border);
        padding: 20px;
        border-radius: 16px;
        text-align: center;
    }

    .kpi-label { font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 600; margin-bottom: 5px; }
    .kpi-val { font-size: 24px; font-weight: 700; font-family: 'DM Mono', monospace; }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h2 class="fw-bold mb-4 text-white">Estado de la Suscripción</h2>

            <div class="sub-card">
                <div class="d-flex justify-content-between align-items-start mb-5">
                    <div>
                        <h4 class="fw-bold mb-1">Plan @Model.Plan</h4>
                        <p class="text-muted">ID de Cliente: #@Model.Id</p>
                    </div>
                    <div>
                        @if (estado == MiniMercado.Models.EstadoSuscripcion.Activa)
                        {
                            if (diasRestantes <= 5)
                            {
                                <span class="status-badge-lg status-warning"><i class="bi bi-exclamation-triangle-fill"></i> Próxima a Vencer</span>
                            }
                            else
                            {
                                <span class="status-badge-lg status-active"><i class="bi bi-check-circle-fill"></i> Suscripción Activa</span>
                            }
                        }
                        else if (estado == MiniMercado.Models.EstadoSuscripcion.Vencida)
                        {
                            <span class="status-badge-lg status-danger"><i class="bi bi-x-circle-fill"></i> Suscripción Vencida</span>
                        }
                        else
                        {
                            <span class="status-badge-lg status-neutral"><i class="bi bi-pause-fill"></i> @estado.ToString()</span>
                        }
                    </div>
                </div>

                <div class="row g-4 mb-5">
                    <div class="col-md-4">
                        <div class="kpi-sub">
                            <div class="kpi-label">Vencimiento</div>
                            <div class="kpi-val">@(Model.FechaProximoPago?.ToString("dd/MM/yyyy") ?? "—")</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="kpi-sub">
                            <div class="kpi-label">Días Restantes</div>
                            <div class="kpi-val text-primary">@diasRestantes</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="kpi-sub">
                            <div class="kpi-label">Meses Acumulados</div>
                            <div class="kpi-val">@Model.MesesPagados</div>
                        </div>
                    </div>
                </div>

                <div class="border-top pt-4">
                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <span class="text-muted d-block small">Último Pago Registrado</span>
                            <span class="fw-bold">@(Model.UltimoPagoRegistrado?.ToString("dd/MM/yyyy HH:mm") ?? "Sin registros")</span>
                        </div>
                        <div class="col-sm-6 mb-3">
                            <span class="text-muted d-block small">Precio del Plan</span>
                            <span class="fw-bold">@Model.PrecioMensual.ToString("C") / mes</span>
                        </div>
                    </div>
                </div>

                <div class="mt-4 p-3 bg-light rounded border text-center">
                    <p class="mb-0 small text-secondary">
                        <i class="bi bi-info-circle me-1"></i> 
                        Para renovar o cambiar su plan, por favor contacte al administrador del sistema.
                    </p>
                </div>
            </div>
            
            <div class="mt-4 text-center">
                <a asp-action="Index" class="btn btn-link text-decoration-none text-muted">
                    <i class="bi bi-arrow-left"></i> Volver a Configuración
                </a>
            </div>
        </div>
    </div>
</div>
