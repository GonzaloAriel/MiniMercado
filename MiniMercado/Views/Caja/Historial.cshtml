@model List<MiniMercado.Models.Caja>

@{
    ViewData["Title"] = "Historial de Cajas";
    decimal totalVentas = Model.Sum(c => c.TotalVentas);
    decimal totalDiferencia = Model.Sum(c => c.Diferencia ?? 0);
    int cajasCerradas = Model.Count(c => c.Estado == "CERRADA");
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap');

    .db-wrap {
        font-family: 'DM Sans', system-ui, sans-serif;
        color: var(--text-primary);
        background: var(--bg-primary);
        padding: 40px 24px 64px;
        max-width: 1200px;
        margin: 0 auto;
        min-height: 100vh;
    }

    .db-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 32px;
        flex-wrap: wrap;
        gap: 20px;
    }

    .db-header-left h1 {
        font-size: 32px;
        font-weight: 700;
        letter-spacing: -0.03em;
        margin: 0 0 6px;
        color: var(--text-primary);
    }

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 32px;
    }

    @@media (max-width: 768px) { .kpi-grid { grid-template-columns: 1fr; } }

    .kpi-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .kpi-label { font-size: 13px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: .1em; }
    .kpi-value { font-family: 'DM Mono', monospace; font-size: 28px; font-weight: 700; }
    .kpi-value.green { color: var(--green-text); }
    .kpi-value.red { color: var(--red-text); }
    .kpi-value.amber { color: var(--amber-text); }
    .kpi-value.blue { color: var(--blue-text); }

    .filters-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        padding: 20px;
        margin-bottom: 24px;
    }

    .form-control-modern {
        background: var(--bg-surface);
        border: 1px solid var(--border);
        color: var(--text-primary);
        border-radius: 10px;
        padding: 10px 16px;
        font-size: 14px;
        width: 100%;
    }

    .btn-modern {
        font-size: 14px;
        font-weight: 600;
        padding: 10px 20px;
        border-radius: 12px;
        text-decoration: none;
        transition: all 0.2s;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
    }

    .btn-modern.primary { background: var(--blue); color: #fff; }
    .btn-modern.outline { background: var(--bg-surface); border: 1px solid var(--border); color: var(--text-secondary); }
    .btn-modern:hover { transform: translateY(-2px); opacity: 0.9; color: #fff; }

    .data-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        overflow: hidden;
    }

    .db-table { width: 100%; border-collapse: collapse; }
    .db-table th {
        padding: 16px 20px;
        background: var(--bg-tertiary);
        color: var(--text-secondary);
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
        border-bottom: 1px solid var(--border);
        text-align: left;
    }

    .db-table td {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border-light);
        color: var(--text-primary);
        vertical-align: middle;
    }

    .db-table tr:hover td { background: var(--bg-card-hover); }

    .badge-status {
        font-family: 'DM Mono', monospace;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 8px;
    }

    .badge-status.success { background: var(--green-bg); color: var(--green-text); }
    .badge-status.info { background: var(--blue-bg); color: var(--blue-text); }
    .badge-status.secondary { background: var(--bg-surface); color: var(--text-muted); border: 1px solid var(--border); }

    .mono-text { font-family: 'DM Mono', monospace; font-weight: 600; }
</style>

<div class="db-wrap">
    
    <div class="db-header">
        <div class="db-header-left">
            <h1>Historial de Cajas</h1>
            <p>Seguimiento de aperturas, cierres y arqueos</p>
        </div>
        <div class="header-actions">
            <a asp-controller="Home" asp-action="Index" class="btn-modern outline">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
        </div>
    </div>

    <div class="kpi-grid">
        <div class="kpi-card">
            <span class="kpi-label">Ventas Registradas</span>
            <span class="kpi-value blue">$ @totalVentas.ToString("N0")</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Diferencia de Arqueo</span>
            <span class="kpi-value @(totalDiferencia < 0 ? "red" : (totalDiferencia > 0 ? "amber" : "green"))">
                $ @totalDiferencia.ToString("N0")
            </span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">Cajas Cerradas</span>
            <span class="kpi-value">@cajasCerradas</span>
        </div>
    </div>

    <div class="filters-card">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label small fw-bold text-muted text-uppercase mb-2 d-block">Fecha Desde</label>
                <input type="date" name="desde" class="form-control-modern" value="@(((DateTime)ViewBag.Desde).ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-bold text-muted text-uppercase mb-2 d-block">Fecha Hasta</label>
                <input type="date" name="hasta" class="form-control-modern" value="@(((DateTime)ViewBag.Hasta).ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn-modern primary w-100">
                    <i class="bi bi-funnel"></i> Filtrar Historial
                </button>
            </div>
        </form>
    </div>

    <div class="data-card">
        <div class="table-responsive">
            <table class="db-table table">
                <thead>
                    <tr>
                        <th>Apertura</th>
                        <th>Cierre</th>
                        <th>Responsable</th>
                        <th class="text-end">Monto Inicial</th>
                        <th class="text-end">Ventas</th>
                        <th class="text-end">Diferencia</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var caja in Model)
                    {
                        <tr>
                            <td><span class="small text-muted mono-text">@caja.FechaApertura.ToString("dd/MM/yy HH:mm")</span></td>
                            <td><span class="small text-muted mono-text">@(caja.FechaCierre?.ToString("dd/MM/yy HH:mm") ?? "—")</span></td>
                            <td><span class="small fw-bold">@caja.Usuario</span></td>
                            <td class="text-end"><span class="mono-text small">$@caja.MontoInicial.ToString("N0")</span></td>
                            <td class="text-end"><span class="mono-text fw-bold text-primary">$@caja.TotalVentas.ToString("N0")</span></td>
                            <td class="text-end">
                                <span class="mono-text fw-bold @(caja.Diferencia < 0 ? "text-danger" : (caja.Diferencia > 0 ? "text-warning" : "text-success"))">
                                    @(caja.Diferencia.HasValue ? $"$ {caja.Diferencia.Value:N0}" : "—")
                                </span>
                            </td>
                            <td class="text-center">
                                @if (caja.Estado == "ABIERTA") { <span class="badge-status success">ABIERTA</span> }
                                else if (caja.Estado == "AUTOMATICA") { <span class="badge-status info">AUTO</span> }
                                else { <span class="badge-status secondary">CERRADA</span> }
                            </td>
                            <td class="text-end">
                                <a asp-action="ResumenCierre" asp-route-id="@caja.Id" class="btn-modern outline btn-sm" title="Ver Resumen">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (ViewBag.TotalPaginas > 1)
    {
        <div class="pagination-container">
            @if (ViewBag.PaginaActual > 1)
            {
                <a asp-action="Historial" 
                   asp-route-page="@(ViewBag.PaginaActual - 1)" 
                   asp-route-desde="@ViewBag.Desde.ToString("yyyy-MM-dd")"
                   asp-route-hasta="@ViewBag.Hasta.ToString("yyyy-MM-dd")"
                   class="page-link-modern">
                    <i class="bi bi-chevron-left"></i>
                </a>
            }
            else
            {
                <span class="page-link-modern disabled"><i class="bi bi-chevron-left"></i></span>
            }

            @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
            {
                if (i == ViewBag.PaginaActual)
                {
                    <span class="page-link-modern active">@i</span>
                }
                else
                {
                    <a asp-action="Historial" 
                       asp-route-page="@i" 
                       asp-route-desde="@ViewBag.Desde.ToString("yyyy-MM-dd")"
                       asp-route-hasta="@ViewBag.Hasta.ToString("yyyy-MM-dd")"
                       class="page-link-modern">@i</a>
                }
            }

            @if (ViewBag.PaginaActual < ViewBag.TotalPaginas)
            {
                <a asp-action="Historial" 
                   asp-route-page="@(ViewBag.PaginaActual + 1)" 
                   asp-route-desde="@ViewBag.Desde.ToString("yyyy-MM-dd")"
                   asp-route-hasta="@ViewBag.Hasta.ToString("yyyy-MM-dd")"
                   class="page-link-modern">
                    <i class="bi bi-chevron-right"></i>
                </a>
            }
            else
            {
                <span class="page-link-modern disabled"><i class="bi bi-chevron-right"></i></span>
            }
        </div>
    }
</div>
