@model MiniMercado.Models.Caja

@{
    ViewData["Title"] = "Cierre de Caja";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-danger text-white text-center">
                <h3>🚪 Cierre de Caja</h3>
            </div>
            <div class="card-body">
                <div class="row text-center mb-4">
                    <div class="col-6">
                        <small class="text-muted d-block">Monto Inicial</small>
                        <span class="h5">$ @Model.MontoInicial.ToString("N2")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Total Ventas (Turno)</small>
                        <span class="h5 text-success">$ @Model.TotalVentas.ToString("N2")</span>
                    </div>
                </div>

                <div class="row text-center mb-4">
                    <div class="col-12">
                        <small class="text-muted d-block">Total Egresos (Turno)</small>
                        <span class="h5 text-danger">$ @(ViewBag.TotalEgresos?.ToString("N2") ?? "0.00")</span>
                    </div>
                </div>

                <div class="alert alert-info text-center">
                    <h5>Esperado en Caja:</h5>
                    <span class="h3">$ @((Model.MontoInicial + Model.TotalVentas - (decimal)(ViewBag.TotalEgresos ?? 0m)).ToString("N2"))</span>
                </div>

                <hr />

                <form asp-action="CerrarCaja" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    
                    <div class="mb-4 text-center">
                        <label for="montoReal" class="form-label h5">Monto Real en Efectivo</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text">$</span>
                            <input type="number" name="montoReal" id="montoReal" step="0.01" class="form-control text-center" placeholder="0.00" autofocus required />
                        </div>
                        <small class="text-muted">Cuente el dinero en caja e ingrese el total.</small>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger btn-lg">
                            🔴 Cerrar Caja y Finalizar Turno
                        </button>
                        <a asp-action="Create" asp-controller="Venta" class="btn btn-link text-muted">Cancelar y volver a ventas</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
