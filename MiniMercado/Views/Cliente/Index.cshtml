@model IEnumerable<MiniMercado.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
    var deudas = ViewBag.Deudas as Dictionary<int, decimal> ?? new();
    var pagos = ViewBag.Pagos as Dictionary<int, decimal> ?? new();
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap');

    .db-wrap {
        font-family: 'DM Sans', system-ui, sans-serif;
        color: var(--text-primary);
        background: var(--bg-primary);
        padding: 40px 24px 64px;
        max-width: 1100px;
        margin: 0 auto;
        min-height: 100vh;
    }

    .db-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 32px;
        flex-wrap: wrap;
        gap: 20px;
    }

    .db-header-left h1 {
        font-size: 32px;
        font-weight: 700;
        letter-spacing: -0.03em;
        margin: 0 0 6px;
        color: var(--text-primary);
    }

    .db-header-left p {
        font-size: 16px;
        color: var(--text-secondary);
        margin: 0;
        font-family: 'DM Mono', monospace;
    }

    .btn-modern {
        font-size: 14px;
        font-weight: 600;
        padding: 10px 20px;
        border-radius: 12px;
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid var(--border);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
    }

    .btn-modern.success { background: var(--green); color: #fff; border: none; }
    .btn-modern.primary { background: var(--blue); color: #fff; border: none; }
    .btn-modern.outline { background: var(--bg-surface); color: var(--text-secondary); }
    .btn-modern:hover { transform: translateY(-2px); opacity: 0.9; color: #fff; text-decoration: none; }

    .filters-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        padding: 20px;
        margin-bottom: 24px;
    }

    .form-control-modern {
        background: var(--bg-surface);
        border: 1px solid var(--border);
        color: var(--text-primary);
        border-radius: 10px;
        padding: 10px 16px;
        font-size: 14px;
        width: 100%;
    }

    .form-control-modern:focus {
        border-color: var(--blue);
        outline: none;
        box-shadow: 0 0 0 2px var(--blue-bg);
    }

    .data-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        overflow: hidden;
    }

    .db-table {
        width: 100%;
        border-collapse: collapse;
    }

    .db-table th {
        padding: 16px 24px;
        background: var(--bg-tertiary);
        color: var(--text-secondary);
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
        border-bottom: 1px solid var(--border);
        text-align: left;
    }

    .db-table td {
        padding: 16px 24px;
        border-bottom: 1px solid var(--border-light);
        color: var(--text-primary);
        vertical-align: middle;
    }

    .db-table tr:hover td { background: var(--bg-card-hover); }

    .balance-text {
        font-family: 'DM Mono', monospace;
        font-weight: 700;
        font-size: 16px;
    }

    .balance-text.debt { color: var(--red-text); }
    .balance-text.clear { color: var(--green-text); }

    .btn-action {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        border: 1px solid var(--border);
        background: var(--bg-surface);
        color: var(--text-secondary);
        transition: all 0.2s;
        text-decoration: none;
    }

    .btn-action:hover {
        background: var(--bg-card-hover);
        border-color: var(--blue);
        color: var(--blue-text);
        transform: translateY(-1px);
    }

    .btn-action.success:hover { border-color: var(--green); color: var(--green-text); }
    .btn-action.danger:hover { border-color: var(--red); color: var(--red-text); }

    .alert-modern {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 16px 24px;
        margin-bottom: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .alert-modern.success { border-left: 4px solid var(--green); color: var(--green-text); }
</style>

<div class="db-wrap">
    
    <div class="db-header">
        <div class="db-header-left">
            <h1>Clientes y Cuentas</h1>
            <p>Gestión de fiados y saldos pendientes</p>
        </div>
        <div class="header-actions">
            <a asp-action="Create" class="btn-modern success">
                <i class="bi bi-person-plus"></i> Nuevo Cliente
            </a>
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert-modern success">
            <span><i class="bi bi-check-circle-fill me-2"></i> @TempData["Mensaje"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div id="ajaxAlert" class="alert-modern d-none">
        <span id="ajaxAlertMessage"></span>
        <button type="button" class="btn-close" onclick="this.parentElement.classList.add('d-none')"></button>
    </div>

    <div class="filters-card">
        <form method="get" class="row g-3">
            <div class="col-md-9">
                <div class="position-relative">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="text" name="filtro" value="@Context.Request.Query["filtro"]" 
                           class="form-control-modern ps-5" placeholder="Buscar por nombre o teléfono..." />
                </div>
            </div>
            <div class="col-md-3">
                <button class="btn-modern primary w-100" type="submit">Buscar Cliente</button>
            </div>
        </form>
    </div>

    <div class="data-card">
        <div class="table-responsive">
            <table class="db-table table">
                <thead>
                    <tr>
                        <th style="width: 40%">Cliente</th>
                        <th>Teléfono</th>
                        <th class="text-end">Saldo Actual</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            decimal deuda = deudas.ContainsKey(item.Id) ? deudas[item.Id] : 0;
                            decimal pago = pagos.ContainsKey(item.Id) ? pagos[item.Id] : 0;
                            decimal saldo = deuda - pago;
    
                            <tr id="row-@item.Id">
                                <td><span class="fw-bold">@item.Nombre</span></td>
                                <td><span class="text-muted small">@(item.Telefono ?? "Sin Teléfono")</span></td>
                                <td class="text-end">
                                    <span class="balance-text @(saldo > 0 ? "debt" : "clear")">
                                        $ @saldo.ToString("N0")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="Detalle" asp-route-id="@item.Id" class="btn-action" title="Ver Estado de Cuenta">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="RegistrarPago" asp-route-id="@item.Id" class="btn-action success" title="Registrar Entrega de Efectivo">
                                            <i class="bi bi-cash-coin"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action" title="Editar Datos">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" onclick="confirmarDesactivacion(@item.Id, '@item.Nombre')" 
                                                class="btn-action danger" title="Eliminar Cliente">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-2 d-block mb-2"></i>
                                No se encontraron clientes registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (ViewBag.TotalPaginas > 1)
    {
        <div class="pagination-container">
            @if (ViewBag.PaginaActual > 1)
            {
                <a asp-action="Index" 
                   asp-route-page="@(ViewBag.PaginaActual - 1)" 
                   asp-route-filtro="@ViewBag.Filtro"
                   class="page-link-modern">
                    <i class="bi bi-chevron-left"></i>
                </a>
            }
            else
            {
                <span class="page-link-modern disabled"><i class="bi bi-chevron-left"></i></span>
            }

            @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
            {
                if (i == ViewBag.PaginaActual)
                {
                    <span class="page-link-modern active">@i</span>
                }
                else
                {
                    <a asp-action="Index" 
                       asp-route-page="@i" 
                       asp-route-filtro="@ViewBag.Filtro"
                       class="page-link-modern">@i</a>
                }
            }

            @if (ViewBag.PaginaActual < ViewBag.TotalPaginas)
            {
                <a asp-action="Index" 
                   asp-route-page="@(ViewBag.PaginaActual + 1)" 
                   asp-route-filtro="@ViewBag.Filtro"
                   class="page-link-modern">
                    <i class="bi bi-chevron-right"></i>
                </a>
            }
            else
            {
                <span class="page-link-modern disabled"><i class="bi bi-chevron-right"></i></span>
            }
        </div>
    }
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        function confirmarDesactivacion(id, nombre) {
            if (confirm(`¿Está seguro de que desea eliminar al cliente "${nombre}"?`)) {
                desactivarCliente(id);
            }
        }

        function desactivarCliente(id) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const row = document.getElementById(`row-${id}`);
            
            row.style.opacity = "0.5";
            row.style.pointerEvents = "none";

            $.ajax({
                url: '/Cliente/DesactivarAjax',
                type: 'POST',
                data: { 
                    id: id,
                    __RequestVerificationToken: token 
                },
                success: function(response) {
                    if (response.ok) {
                        $(row).fadeOut(400, function() {
                            $(this).remove();
                            mostrarAlerta("✅ Cliente eliminado correctamente.", "success");
                        });
                    } else {
                        row.style.opacity = "1";
                        row.style.pointerEvents = "auto";
                        mostrarAlerta("❌ Error: " + response.error, "danger");
                    }
                },
                error: function() {
                    row.style.opacity = "1";
                    row.style.pointerEvents = "auto";
                    mostrarAlerta("❌ Error al conectar con el servidor.", "danger");
                }
            });
        }

        function mostrarAlerta(mensaje, tipo) {
            const alertDiv = document.getElementById("ajaxAlert");
            const alertMsg = document.getElementById("ajaxAlertMessage");
            alertDiv.className = `alert-modern ${tipo}`;
            alertMsg.textContent = mensaje;
            alertDiv.classList.remove("d-none");
            setTimeout(() => { $(alertDiv).fadeOut(); }, 3000);
        }
    </script>
}
