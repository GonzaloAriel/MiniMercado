@model IEnumerable<MiniMercado.Models.Rubro>

@{
    ViewData["Title"] = "Rubros";
}

<div class="d-flex justify-content-between align-items-center mb-3 mt-3">
    <h2 class="mb-0">Listado de rubros</h2>
    <div>
        <a asp-action="Create" class="btn btn-success mb-3">➕ Nuevo Rubro</a>
    </div>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Productos</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@((item.Productos?.Count() ?? 0))</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">✏ Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">🗑 Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>