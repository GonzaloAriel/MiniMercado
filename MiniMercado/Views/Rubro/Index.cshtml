@model IEnumerable<MiniMercado.Models.Rubro>

@{
    ViewData["Title"] = "Rubros";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h2>📂 Rubros / Categorías</h2>
    <div>
        <a asp-action="Inactivos" class="btn btn-outline-warning me-2">
            ♻ Rubros Inactivos
        </a>
        <a asp-action="Create" class="btn btn-success">
            ➕ Nuevo Rubro
        </a>
    </div>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div id="ajaxAlert" class="alert d-none alert-dismissible fade show">
    <span id="ajaxAlertMessage"></span>
    <button type="button" class="btn-close" onclick="this.parentElement.classList.add('d-none')"></button>
</div>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>Nombre del Rubro</th>
                <th class="text-center">Productos Asociados</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr id="row-@item.Id">
                        <td class="fw-bold">@item.Nombre</td>
                        <td class="text-center">
                            <span class="badge bg-info text-dark">
                                @(item.Productos?.Count ?? 0)
                            </span>
                        </td>
                        <td class="text-center">
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">
                                    <i class="bi bi-pencil"></i> Editar
                                </a>
                                <button type="button" 
                                        onclick="confirmarDesactivacion(@item.Id, '@item.Nombre')" 
                                        class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center py-4 text-muted">No se encontraron rubros.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        function confirmarDesactivacion(id, nombre) {
            if (confirm(`¿Está seguro de que desea eliminar el rubro "${nombre}"?`)) {
                desactivarRubro(id);
            }
        }

        function desactivarRubro(id) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const row = document.getElementById(`row-${id}`);
            
            row.style.opacity = "0.5";
            row.style.pointerEvents = "none";

            $.ajax({
                url: '/Rubro/DesactivarAjax',
                type: 'POST',
                data: { 
                    id: id,
                    __RequestVerificationToken: token 
                },
                success: function(response) {
                    if (response.ok) {
                        $(row).fadeOut(400, function() {
                            $(this).remove();
                            mostrarAlerta("✅ Rubro eliminado correctamente.", "alert-success");
                        });
                    } else {
                        row.style.opacity = "1";
                        row.style.pointerEvents = "auto";
                        mostrarAlerta("❌ Error: " + response.error, "alert-danger");
                    }
                },
                error: function() {
                    row.style.opacity = "1";
                    row.style.pointerEvents = "auto";
                    mostrarAlerta("❌ Error al conectar con el servidor.", "alert-danger");
                }
            });
        }

        function mostrarAlerta(mensaje, clase) {
            const alertDiv = document.getElementById("ajaxAlert");
            const alertMsg = document.getElementById("ajaxAlertMessage");
            alertDiv.className = `alert ${clase} alert-dismissible fade show`;
            alertMsg.textContent = mensaje;
            alertDiv.classList.remove("d-none");
            setTimeout(() => { $(alertDiv).fadeOut(); }, 3000);
        }
    </script>
}