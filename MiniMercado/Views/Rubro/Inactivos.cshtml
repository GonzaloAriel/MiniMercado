@model List<MiniMercado.Models.Rubro>

<h2>Productos Inactivos</h2>

<form method="get" class="mb-3">
    <input type="text" name="filtro"
           class="form-control"
           placeholder="Buscar por nombre" />
</form>

<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Productos</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nombre</td>
                    <td>@((item.Productos?.Count() ?? 0))</td>
                    <td>
                        <a asp-action="Reactivar"
                               asp-route-id="@item.Id"
                               class="btn btn-success btn-sm">
                            Reactivar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (ViewBag.TotalPaginas > 1)
{
    <div class="pagination-container">
        @if (ViewBag.PaginaActual > 1)
        {
            <a asp-action="Inactivos" 
               asp-route-page="@(ViewBag.PaginaActual - 1)" 
               asp-route-filtro="@ViewBag.Filtro"
               class="page-link-modern">
                <i class="bi bi-chevron-left"></i>
            </a>
        }
        else
        {
            <span class="page-link-modern disabled"><i class="bi bi-chevron-left"></i></span>
        }

        @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
        {
            if (i == ViewBag.PaginaActual)
            {
                <span class="page-link-modern active">@i</span>
            }
            else
            {
                <a asp-action="Inactivos" 
                   asp-route-page="@i" 
                   asp-route-filtro="@ViewBag.Filtro"
                   class="page-link-modern">@i</a>
            }
        }

        @if (ViewBag.PaginaActual < ViewBag.TotalPaginas)
        {
            <a asp-action="Inactivos" 
               asp-route-page="@(ViewBag.PaginaActual + 1)" 
               asp-route-filtro="@ViewBag.Filtro"
               class="page-link-modern">
                <i class="bi bi-chevron-right"></i>
            </a>
        }
        else
        {
            <span class="page-link-modern disabled"><i class="bi bi-chevron-right"></i></span>
        }
    </div>
}

<a asp-action="Index" class="btn btn-secondary">
    Volver
</a>
