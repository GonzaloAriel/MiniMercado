@model MiniMercado.Models.Rubro

@{
    ViewData["Title"] = "Editar Rubro";
}

<div class="container py-3">
    <div class="card shadow-sm">
        <div class="card-body">
            <h3 class="card-title mb-3">Editar Rubro</h3>

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" maxlength="100" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    💾 Guardar cambios
                </button>

                <a asp-action="Index" class="btn btn-secondary ms-2">⬅ Volver</a>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
