@model List<MiniMercado.Models.Producto>
@{
    ViewData["Title"] = "Reparar Stock Importado";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0"><i class="bi bi-tools me-2"></i>Herramienta de Reparación de Inventario</h2>
            <p class="text-muted">Productos con stock positivo pero sin lotes asociados (importados).</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver al Catálogo
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
            <div class="row align-items-center">
                <div class="col">
                    <h5 class="mb-0">Resumen de Inconsistencias</h5>
                </div>
                <div class="col-auto">
                    <span class="badge bg-danger rounded-pill px-3">
                        @Model.Count productos a reparar
                    </span>
                </div>
            </div>
        </div>

        <h3>Total encontrados: @ViewBag.Total</h3>

        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Código</th>
                                <th>Producto</th>
                                <th>Tenant</th>
                                <th class="text-end">Stock Actual</th>
                                <th class="text-center">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td><code>@p.CodigoBarra</code></td>
                                    <td>
                                        <div class="fw-bold">@p.Nombre</div>
                                        @if (p.ProductoBaseId.HasValue)
                                        {
                                            <small class="text-primary"><i class="bi bi-globe me-1"></i>Vinculado a Catálogo</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @p.Tenant?.NombreComercio
                                        </span>
                                    </td>
                                    <td class="text-end fw-bold text-danger">
                                        @p.Stock.ToString("N2") @(p.EsPorPeso ? "Kg" : "Un")
                                    </td>
                                    <td class="text-center">
                                        <span class="text-warning" title="Sin lotes detectados">
                                            <i class="bi bi-exclamation-triangle-fill"></i>
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-check2-circle text-success" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">No se detectaron inconsistencias</h5>
                    <p class="text-muted">Todos los productos con stock tienen sus lotes correspondientes.</p>
                </div>
            }
        </div>
        @if (Model.Any())
        {
            <div class="card-footer bg-white py-3 text-end">
                <form asp-action="EjecutarReparacion" method="post" id="repairForm">
                    <button type="submit" class="btn btn-primary btn-lg px-5 shadow-sm" id="btnReparar">
                        <i class="bi bi-lightning-fill me-2"></i>Ejecutar reparación masiva
                    </button>
                </form>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('repairForm')?.addEventListener('submit', function() {
            const btn = document.getElementById('btnReparar');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Procesando...';
        });
    </script>
}
