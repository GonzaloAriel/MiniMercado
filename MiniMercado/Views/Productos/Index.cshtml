@model List<MiniMercado.Models.ProductoListViewModel>

<h2>Listado de Productos</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}


<a asp-action="Create" class="btn btn-success mb-3">
    ➕ Nuevo Producto
</a>


<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text"
               name="filtro"
               value="@Context.Request.Query["filtro"]"
               class="form-control"
               placeholder="Buscar por nombre o código de barra" />

        <button class="btn btn-primary" type="submit">
            🔍 Buscar
        </button>
    </div>
</form>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Código</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Activo</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var producto in Model)
        {
            <tr>
                <td>@producto.Nombre</td>
                <td>@producto.CodigoBarra</td>
                <td>@producto.Precio</td>
                <td>@producto.Stock</td>
                <td>@(producto.Activo ? "Sí" : "No")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@producto.Id" class="btn btn-warning btn-sm">
                        Editar
                    </a>
                    <a asp-action="Delete" asp-route-id="@producto.Id" class="btn btn-danger btn-sm">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Inactivos" class="btn btn-warning mb-3">
    ♻ Productos Inactivos
</a>


