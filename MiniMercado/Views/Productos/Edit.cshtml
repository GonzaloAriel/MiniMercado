@model MiniMercado.Models.Producto

<h2>Editar Producto</h2>

<form asp-action="Edit" method="post">

    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label asp-for="CodigoBarra" class="form-label"></label>
        <input asp-for="CodigoBarra" class="form-control" />
        <span asp-validation-for="CodigoBarra" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Precio"></label>
        <input asp-for="Precio" class="form-control" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Rubro</label>
        <select asp-for="RubroId" class="form-select">
            <option value="">-- Sin rubro --</option>
            @foreach (var r in ViewBag.Rubros as List<MiniMercado.Models.Rubro>)
            {
                <option value="@r.Id">@r.Nombre</option>
            }
        </select>
        <span asp-validation-for="RubroId" class="text-danger"></span>
    </div>

    <div class="form-check mb-2">
        <input asp-for="EsPorPeso" class="form-check-input" />
        <label asp-for="EsPorPeso" class="form-check-label">
            Se vende por peso
        </label>
    </div>

    <div class="form-check mb-3">
        <input asp-for="PrecioEditable" class="form-check-input" />
        <label asp-for="PrecioEditable" class="form-check-label">
            Precio editable en venta
        </label>
    </div>


    <div class="mb-3">
        <div class="form-check">
            <input asp-for="Activo" class="form-check-input" />
            <label asp-for="Activo" class="form-check-label">Activo</label>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar cambios
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
