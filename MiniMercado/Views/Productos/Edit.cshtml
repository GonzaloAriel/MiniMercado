@model MiniMercado.Models.Producto

<h2>Editar Producto</h2>

<form asp-action="Edit" method="post">

    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label asp-for="CodigoBarra" class="form-label"></label>
        <input asp-for="CodigoBarra" class="form-control" />
        <span asp-validation-for="CodigoBarra" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Precio"></label>
        <input asp-for="Precio" class="form-control" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Rubro</label>
        <div class="input-group">
            <select asp-for="RubroId" class="form-select">
                <option value="">-- Sin rubro --</option>
                @foreach (var r in ViewBag.Rubros as List<MiniMercado.Models.Rubro>)
                {
                    <option value="@r.Id">@r.Nombre</option>
                }
            </select>
            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalRubro">
                Nuevo Rubro
            </button>
        </div>
        <span asp-validation-for="RubroId" class="text-danger"></span>
    </div>

    <div class="form-check mb-2">
        <input asp-for="EsPorPeso" class="form-check-input" />
        <label asp-for="EsPorPeso" class="form-check-label">
            Se vende por peso
        </label>
    </div>

    <div class="form-check mb-3">
        <input asp-for="PrecioEditable" class="form-check-input" />
        <label asp-for="PrecioEditable" class="form-check-label">
            Precio editable en venta
        </label>
    </div>


    <div class="mb-3">
        <div class="form-check">
            <input asp-for="Activo" class="form-check-input" />
            <label asp-for="Activo" class="form-check-label">Activo</label>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar cambios
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>
</form>

<!-- Modal Nuevo Rubro -->
<div class="modal fade text-black rounded" id="modalRubro" tabindex="-1">
    <div class="modal-dialog rounded">
        <div class="modal-content rounded">

            <div class="modal-header bg-success rounded">
                <h5 class="modal-title">Nuevo Rubro</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="form-group">
                    <label>Nombre del rubro</label>
                    <input type="text" id="nuevoRubroNombre" class="form-control" placeholder="Ej: Bebidas, Lácteos..." />
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" onclick="crearRubro()">Guardar</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function crearRubro() {
            var nombre = document.getElementById("nuevoRubroNombre").value;

            if (!nombre) {
                alert("Por favor, ingrese un nombre para el rubro.");
                return;
            }

            fetch('/Rubro/CrearDesdeModal', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: 'nombre=' + encodeURIComponent(nombre)
            })
            .then(res => {
                if (!res.ok) {
                    return res.text().then(text => { throw new Error(text) });
                }
                return res.json();
            })
            .then(data => {
                var select = document.querySelector("select[name='RubroId']");

                var option = new Option(data.nombre, data.id, true, true);
                select.add(option);

                // Limpiar y cerrar modal
                document.getElementById("nuevoRubroNombre").value = "";
                var modalElement = document.getElementById('modalRubro');
                var modal = bootstrap.Modal.getInstance(modalElement);
                modal.hide();
            })
            .catch(err => {
                alert(err.message);
            });
        }
    </script>
}
