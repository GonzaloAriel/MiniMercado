@{
    ViewData["Title"] = "Importar Productos";
}

<h2>Importar Productos</h2>

<form asp-action="Importar"
      method="post"
      enctype="multipart/form-data">

    <div class="mb-3">
        <label class="form-label">
            Archivo Excel
        </label>

        <input type="file"
               name="archivo"
               class="form-control"
               accept=".xlsx" />
    </div>

    <button type="submit"
            class="btn btn-primary">
        Importar
    </button>
</form>