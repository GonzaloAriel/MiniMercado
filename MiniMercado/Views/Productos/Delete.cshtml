@model MiniMercado.Models.Producto

<h2>Desactivar Producto</h2>

<div class="alert alert-warning">
    ⚠ Este producto será desactivado (Se ocultara).
</div>

<dl class="row">
    <dt class="col-sm-4">Código de Barra</dt>
    <dd class="col-sm-8">@Model.CodigoBarra</dd>

    <dt class="col-sm-4">Nombre</dt>
    <dd class="col-sm-8">@Model.Nombre</dd>

    <dt class="col-sm-4">Precio</dt>
    <dd class="col-sm-8">@Model.Precio</dd>

    <dt class="col-sm-4">Stock</dt>
    <dd class="col-sm-8">@Model.Stock</dd>
</dl>

<form asp-action="DeleteConfirmed" method="post">
    <input asp-for="Id" type="hidden" />

    <button type="submit" class="btn btn-danger">
        Desactivar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>
</form>
