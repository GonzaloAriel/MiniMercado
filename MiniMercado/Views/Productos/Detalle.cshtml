@model MiniMercado.Models.Producto

@{
    ViewData["Title"] = "Detalle de Producto";
    var lotes = (List<MiniMercado.Models.LoteProducto>)ViewBag.Lotes;
    var stockTotal = (decimal)ViewBag.StockTotal;
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap');

    .db-wrap {
        font-family: 'DM Sans', system-ui, sans-serif;
        color: var(--text-primary);
        background: var(--bg-primary);
        padding: 40px 24px 64px;
        max-width: 1100px;
        margin: 0 auto;
        min-height: 100vh;
    }

    .db-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 32px;
        flex-wrap: wrap;
        gap: 20px;
    }

    .db-header-left h1 {
        font-size: 32px;
        font-weight: 700;
        letter-spacing: -0.03em;
        margin: 0 0 6px;
        color: var(--text-primary);
    }

    .stock-total-badge {
        background: var(--blue-bg);
        border: 1px solid var(--blue);
        color: var(--blue-text);
        padding: 12px 24px;
        border-radius: 16px;
        font-family: 'DM Mono', monospace;
        font-weight: 700;
        font-size: 20px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 32px;
    }

    .info-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 20px;
    }

    .info-label {
        font-size: 12px;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: .1em;
        margin-bottom: 4px;
        display: block;
    }

    .info-value {
        font-size: 18px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .section-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: .1em;
        margin: 32px 0 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .section-title::after { content: ''; flex: 1; height: 1px; background: var(--border); }

    .data-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        overflow: hidden;
        margin-bottom: 32px;
    }

    .db-table {
        width: 100%;
        border-collapse: collapse;
    }

    .db-table th {
        padding: 16px 24px;
        background: var(--bg-tertiary);
        color: var(--text-secondary);
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
        border-bottom: 1px solid var(--border);
        text-align: left;
    }

    .db-table td {
        padding: 16px 24px;
        border-bottom: 1px solid var(--border-light);
        color: var(--text-primary);
        vertical-align: middle;
    }

    .db-table tr:hover td { background: var(--bg-card-hover); }

    .badge-status {
        font-family: 'DM Mono', monospace;
        font-size: 12px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 8px;
    }

    .badge-status.red { background: var(--red-bg); color: var(--red-text); }
    .badge-status.amber { background: var(--amber-bg); color: var(--amber-text); }
    .badge-status.green { background: var(--green-bg); color: var(--green-text); }

    .btn-action {
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        border: 1px solid var(--border);
        background: var(--bg-surface);
        color: var(--text-secondary);
        transition: all 0.2s;
        cursor: pointer;
    }

    .btn-action:hover {
        background: var(--bg-card-hover);
        border-color: var(--blue);
        color: var(--blue-text);
    }

    .btn-action.danger:hover {
        border-color: var(--red);
        color: var(--red-text);
    }

    .modal-content {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        color: var(--text-primary);
    }

    .modal-header { border-bottom: 1px solid var(--border); padding: 24px; }
    .modal-footer { border-top: 1px solid var(--border); padding: 20px; }

    .form-control-modern {
        background: var(--bg-surface);
        border: 1px solid var(--border);
        color: var(--text-primary);
        border-radius: 10px;
        padding: 10px 14px;
    }

    .form-control-modern:focus {
        border-color: var(--blue);
        box-shadow: 0 0 0 2px var(--blue-bg);
        outline: none;
    }

    .btn-modern {
        padding: 10px 20px;
        border-radius: 10px;
        font-weight: 700;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-modern.primary { background: var(--blue); color: #fff; }
    .btn-modern.outline { background: transparent; border: 1px solid var(--border); color: var(--text-secondary); }
</style>

<div class="db-wrap">
    
    <div class="db-header">
        <div class="db-header-left">
            <h1>@Model.NombreDisplay</h1>
            <p>Visualización detallada y control de inventario</p>
        </div>
        <div class="stock-total-badge">
            <small style="display:block; font-size: 10px; text-transform: uppercase; margin-bottom: 2px; color: var(--blue-text);">Stock Total</small>
            @stockTotal.ToString("0.##")
        </div>
    </div>

    <div class="info-grid">
        <div class="info-card">
            <span class="info-label">Código</span>
            <span class="info-value">@Model.CodigoDisplay</span>
        </div>
        <div class="info-card">
            <span class="info-label">Rubro</span>
            <span class="info-value">@(Model.Rubro?.Nombre ?? "Sin Clasificar")</span>
        </div>
        <div class="info-card">
            <span class="info-label">Precio Unitario</span>
            <span class="info-value" style="color: var(--green-text)">$ @Model.Precio.ToString("N2")</span>
        </div>
        <div class="info-card">
            <span class="info-label">Estado</span>
            <span class="info-value">@(Model.Activo ? "Activo" : "Inactivo")</span>
        </div>
    </div>

    <p class="section-title">Lotes y Existencias</p>

    <div class="data-card">
        <div class="table-responsive">
            <table class="db-table table">
                <thead>
                    <tr>
                        <th>Cantidad</th>
                        <th>Ingreso</th>
                        <th>Vencimiento</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (lotes.Any())
                    {
                        foreach (var lote in lotes)
                        {
                            var diasParaVencer = lote.FechaVencimiento.HasValue 
                                ? (lote.FechaVencimiento.Value.Date - DateTime.Today).TotalDays 
                                : double.MaxValue;
    
                            <tr>
                                <td><span class="fw-bold fs-5">@lote.Cantidad.ToString("0.##")</span></td>
                                <td><span class="text-muted small">@lote.FechaIngreso.ToString("dd/MM/yyyy")</span></td>
                                <td><span>@(lote.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "—")</span></td>
                                <td class="text-center">
                                    @if (diasParaVencer < 0) { <span class="badge-status red">VENCIDO</span> }
                                    else if (diasParaVencer < 7) { <span class="badge-status amber">PRÓXIMO</span> }
                                    else { <span class="badge-status green">VIGENTE</span> }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <button class="btn-action" onclick="abrirModalEditar(@lote.Id, @lote.Cantidad, '@(lote.FechaVencimiento?.ToString("yyyy-MM-dd"))')">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn-action danger" onclick="confirmarEliminar(@lote.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-box-seam fs-2 d-block mb-2"></i>
                                No hay lotes con stock disponible para este producto.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn-modern outline" style="display:inline-flex; align-items:center; gap:8px;">
            <i class="bi bi-arrow-left"></i> Volver al Listado
        </a>
    </div>
</div>

<!-- MODAL EDITAR LOTE -->
<div class="modal fade" id="modalEditar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="EditarLote" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="editLoteId" />
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Editar Lote</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="info-label">Cantidad Actual</label>
                    <input type="number" name="cantidad" id="editCantidad" class="form-control-modern w-100" step="0.01" required />
                </div>
                <div class="mb-3">
                    <label class="info-label">Fecha de Vencimiento</label>
                    <input type="date" name="fechaVencimiento" id="editFecha" class="form-control-modern w-100" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-modern outline" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn-modern primary">Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL ELIMINAR LOTE -->
<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="EliminarLote" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="deleteLoteId" />
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-danger">Eliminar Lote</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <p class="text-secondary mb-4">¿Por qué motivo desea eliminar este lote de mercadería?</p>
                <select name="motivo" class="form-control-modern w-100 mb-3">
                    <option value="MERMA">Merma (Roto/Pérdida/Robo)</option>
                    <option value="VENCIDO">Vencimiento del producto</option>
                    <option value="ERROR">Error en carga inicial</option>
                </select>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-modern outline" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-danger btn-modern">Eliminar Lote</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModalEditar(id, cant, fecha) {
            document.getElementById('editLoteId').value = id;
            document.getElementById('editCantidad').value = cant;
            document.getElementById('editFecha').value = fecha || "";
            new bootstrap.Modal(document.getElementById('modalEditar')).show();
        }
        function confirmarEliminar(id) {
            document.getElementById('deleteLoteId').value = id;
            new bootstrap.Modal(document.getElementById('modalEliminar')).show();
        }
    </script>
}
