@model List<MiniMercado.Models.LoteProducto>

@{
    ViewData["Title"] = "Alertas de Vencimiento";
}

<div class="mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>📅 Alertas de Vencimiento</h2>
        <a asp-controller="Productos" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver a Productos
        </a>
    </div>

    <div class="alert alert-warning shadow-sm">
        <i class="bi bi-info-circle-fill"></i> Se muestran los lotes con stock que vencen en los próximos <strong>7 días</strong>.
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Producto</th>
                    <th class="text-center">Cantidad en Lote</th>
                    <th class="text-center">Fecha Vencimiento</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var lote in Model)
                    {
                        var dias = (lote.FechaVencimiento.Value.Date - DateTime.Today).TotalDays;
                        <tr>
                            <td class="fw-bold">@(lote.Producto?.Nombre ?? "Producto Desconocido")</td>
                            <td class="text-center">
                                <span class="badge bg-info">@lote.Cantidad.ToString("0.##")</span>
                            </td>
                            <td class="text-center">
                                @lote.FechaVencimiento.Value.ToString("dd/MM/yyyy")
                            </td>
                            <td class="text-center">
                                @if (dias < 0)
                                {
                                    <span class="badge bg-danger">VENCIDO</span>
                                }
                                else if (dias == 0)
                                {
                                    <span class="badge bg-danger">VENCE HOY</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">VENCE EN @dias DÍAS</span>
                                }
                            </td>
                            <td class="text-center">
                                <a href="/MovimientoStock/Ingreso?productoId=@lote.ProductoId" class="btn btn-outline-success btn-sm ms-1">
                                    <i class="bi bi-plus-circle"></i> Reponer
                                </a>
                                <a href="/Productos/Detalle/@lote.ProductoId" class="btn btn-outline-success btn-sm ms-1">
                                    <i class="bi bi-trash"></i> Eliminar Lote
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            No hay lotes próximos a vencer.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
