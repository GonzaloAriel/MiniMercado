@model List<MiniMercado.Models.LoteProducto>

@{
    ViewData["Title"] = "Alertas de Vencimiento";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap');

    .db-wrap {
        font-family: 'DM Sans', system-ui, sans-serif;
        color: var(--text-primary);
        background: var(--bg-primary);
        padding: 40px 24px 64px;
        max-width: 1200px;
        margin: 0 auto;
        min-height: 100vh;
    }

    .db-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 32px;
        gap: 20px;
        flex-wrap: wrap;
    }

    .db-header-left h1 {
        font-size: 32px;
        font-weight: 700;
        letter-spacing: -0.03em;
        margin: 0 0 6px;
        color: var(--text-primary);
    }

    .db-header-left p {
        font-size: 16px;
        color: var(--text-secondary);
        margin: 0;
        font-family: 'DM Mono', monospace;
    }

    .btn-modern {
        font-size: 14px;
        font-weight: 600;
        padding: 10px 20px;
        border-radius: 12px;
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid var(--border);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
    }

    .btn-modern.outline { background: var(--bg-surface); color: var(--text-secondary); }
    .btn-modern:hover { transform: translateY(-2px); opacity: 0.9; color: #fff; text-decoration: none; }

    .data-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        overflow: hidden;
    }

    .db-table {
        width: 100%;
        border-collapse: collapse;
    }

    .db-table th {
        padding: 16px 24px;
        background: var(--bg-tertiary);
        color: var(--text-secondary);
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
        border-bottom: 1px solid var(--border);
        text-align: left;
    }

    .db-table td {
        padding: 16px 24px;
        border-bottom: 1px solid var(--border-light);
        color: var(--text-primary);
        vertical-align: middle;
    }

    .db-table tr:hover td { background: var(--bg-card-hover); }

    .badge-modern {
        font-family: 'DM Mono', monospace;
        font-size: 13px;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 30px;
    }

    .badge-modern.red { background: var(--red-bg); color: var(--red-text); }
    .badge-modern.amber { background: var(--amber-bg); color: var(--amber-text); }
    .badge-modern.blue { background: var(--blue-bg); color: var(--blue-text); }

    .alert-card {
        background: var(--amber-bg);
        border: 1px solid var(--amber);
        color: var(--amber-text);
        padding: 16px 24px;
        border-radius: 16px;
        margin-bottom: 24px;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .id-text { font-family: 'DM Mono', monospace; color: var(--text-muted); }
</style>

<div class="db-wrap">
    
    <div class="db-header">
        <div class="db-header-left">
            <h1>Control de Vencimientos</h1>
            <p>Lotes con stock con fecha próxima de caducidad (7 días)</p>
        </div>
        <div class="header-actions">
            <a asp-controller="Productos" asp-action="Index" class="btn-modern outline">
                <i class="bi bi-arrow-left"></i> Volver a Productos
            </a>
        </div>
    </div>

    <div class="alert-card">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <span>Atención: Estos productos deben ser rotados o retirados a la brevedad para evitar mermas.</span>
    </div>

    <div class="data-card">
        <table class="db-table">
            <thead>
                <tr>
                    <th style="width: 35%">Producto</th>
                    <th class="text-center">Stock en Lote</th>
                    <th class="text-center">Fecha de Vencimiento</th>
                    <th class="text-center">Estado Crítico</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var lote in Model)
                    {
                        var dias = (lote.FechaVencimiento.Value.Date - DateTime.Today).TotalDays;
                        <tr>
                            <td>
                                <div class="fw-bold">@(lote.Producto?.Nombre ?? "Producto Desconocido")</div>
                                <div class="id-text small">Lote ID: @lote.Id</div>
                            </td>
                            <td class="text-center">
                                <span class="badge-modern blue">@lote.Cantidad.ToString("0.##")</span>
                            </td>
                            <td class="text-center">
                                <span class="fw-bold">@lote.FechaVencimiento.Value.ToString("dd/MM/yyyy")</span>
                            </td>
                            <td class="text-center">
                                @if (dias < 0)
                                {
                                    <span class="badge-modern red"><i class="bi bi-x-circle-fill me-1"></i> VENCIDO</span>
                                }
                                else if (dias == 0)
                                {
                                    <span class="badge-modern red"><i class="bi bi-clock-fill me-1"></i> VENCE HOY</span>
                                }
                                else
                                {
                                    <span class="badge-modern amber"><i class="bi bi-hourglass-split me-1"></i> @dias DÍAS</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a href="/MovimientoStock/Ingreso?productoId=@lote.ProductoId" class="btn-modern outline btn-sm" title="Reponer">
                                        <i class="bi bi-plus-lg"></i>
                                    </a>
                                    <a href="/Productos/Detalle/@lote.ProductoId" class="btn-modern outline btn-sm" title="Gestionar Lotes">
                                        <i class="bi bi-box-seam"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-check fs-2 d-block mb-2 text-success"></i>
                            No hay lotes próximos a vencer. Todo bajo control.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
