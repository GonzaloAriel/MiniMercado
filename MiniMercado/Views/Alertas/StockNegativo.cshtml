@model List<MiniMercado.Models.Producto>

@{
    ViewData["Title"] = "Stock Negativo";
}

<div class="mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>🔴 Stock Negativo</h2>
        <a asp-controller="Productos" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver a Productos
        </a>
    </div>

    <div class="alert alert-danger shadow-sm">
        <i class="bi bi-exclamation-octagon-fill"></i> Se muestran productos con stock menor a <strong>0</strong>. ¡Debes regularizar estos productos!
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Producto</th>
                    <th class="text-center">Stock Actual</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var producto in Model)
                    {
                        <tr>
                            <td class="fw-bold">@producto.Nombre</td>
                            <td class="text-center">
                                <span class="badge bg-danger">@producto.Stock.ToString("0.##")</span>
                            </td>
                            <td class="text-center">
                                <a href="/MovimientoStock/Ingreso?productoId=@producto.Id" class="btn btn-sm btn-success">
                                    <i class="bi bi-plus-circle"></i> Reponer
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center py-4 text-muted">
                            No hay productos con stock negativo.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
