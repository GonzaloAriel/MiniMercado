@model List<MiniMercado.Models.Producto>

@{
    ViewData["Title"] = "Alerta: Stock Negativo";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap');

    .db-wrap {
        font-family: 'DM Sans', system-ui, sans-serif;
        color: var(--text-primary);
        background: var(--bg-primary);
        padding: 40px 24px 64px;
        max-width: 900px;
        margin: 0 auto;
        min-height: 100vh;
    }

    .db-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 32px;
        gap: 20px;
        flex-wrap: wrap;
    }

    .db-header-left h1 {
        font-size: 32px;
        font-weight: 700;
        letter-spacing: -0.03em;
        margin: 0 0 6px;
        color: var(--text-primary);
    }

    .db-header-left p {
        font-size: 16px;
        color: var(--text-secondary);
        margin: 0;
        font-family: 'DM Mono', monospace;
    }

    .btn-modern {
        font-size: 14px;
        font-weight: 600;
        padding: 10px 20px;
        border-radius: 12px;
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid var(--border);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
    }

    .btn-modern.outline { background: var(--bg-surface); color: var(--text-secondary); }
    .btn-modern.success { background: var(--green); color: #fff; border: none; }
    .btn-modern:hover { transform: translateY(-2px); opacity: 0.9; color: #fff; text-decoration: none; }

    .data-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        overflow: hidden;
    }

    .db-table {
        width: 100%;
        border-collapse: collapse;
    }

    .db-table th {
        padding: 16px 24px;
        background: var(--bg-tertiary);
        color: var(--text-secondary);
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
        border-bottom: 1px solid var(--border);
        text-align: left;
    }

    .db-table td {
        padding: 16px 24px;
        border-bottom: 1px solid var(--border-light);
        color: var(--text-primary);
        vertical-align: middle;
    }

    .db-table tr:hover td { background: var(--bg-card-hover); }

    .badge-modern {
        font-family: 'DM Mono', monospace;
        font-size: 14px;
        font-weight: 700;
        padding: 4px 14px;
        border-radius: 30px;
        background: var(--red-bg);
        color: var(--red-text);
    }

    .alert-card {
        background: var(--red-bg);
        border: 1px solid var(--red);
        color: var(--red-text);
        padding: 16px 24px;
        border-radius: 16px;
        margin-bottom: 24px;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
</style>

<div class="db-wrap">
    
    <div class="db-header">
        <div class="db-header-left">
            <h1>Stock Negativo Crítico</h1>
            <p>Productos con inconsistencias de inventario (&lt; 0 unidades)</p>
        </div>
        <div class="header-actions">
            <a asp-controller="Productos" asp-action="Index" class="btn-modern outline">
                <i class="bi bi-arrow-left"></i> Volver a Productos
            </a>
        </div>
    </div>

    <div class="alert-card">
        <i class="bi bi-exclamation-octagon-fill fs-5"></i>
        <span>Error detectado: El stock no puede ser menor a cero. Regularice cargando mercadería o auditando movimientos.</span>
    </div>

    <div class="data-card">
        <table class="db-table">
            <thead>
                <tr>
                    <th style="width: 50%">Producto con Inconsistencia</th>
                    <th class="text-center">Stock Registrado</th>
                    <th class="text-end">Acción de Ajuste</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var producto in Model)
                    {
                        <tr>
                            <td><span class="fw-bold">@producto.Nombre</span></td>
                            <td class="text-center">
                                <span class="badge-modern">@producto.Stock.ToString("0.##")</span>
                            </td>
                            <td class="text-end">
                                <a href="/MovimientoStock/Ingreso?productoId=@producto.Id" class="btn-modern success btn-sm">
                                    <i class="bi bi-plus-circle"></i> Regularizar
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center py-5 text-muted">
                            <i class="bi bi-shield-check fs-2 d-block mb-2 text-success"></i>
                            No hay productos con stock negativo. ¡Excelente gestión!
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
