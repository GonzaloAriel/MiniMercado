@model List<MiniMercado.Models.Producto>

@{
    ViewData["Title"] = "Alertas de Stock Bajo";
}

<div class="mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>⚠️ Alertas de Stock Bajo</h2>
        <a asp-controller="Productos" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver a Productos
        </a>
    </div>

    <div class="alert alert-info shadow-sm">
        <i class="bi bi-info-circle-fill"></i> Se muestran los productos activos con stock igual o menor a <strong>5 unidades</strong>.
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Producto</th>
                    <th class="text-center">Stock Actual</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var producto in Model)
                    {
                        <tr>
                            <td class="fw-bold">@producto.Nombre</td>
                            <td class="text-center">
                                <span class="badge @(producto.Stock <= 0 ? "bg-danger" : "bg-warning text-dark")">
                                    @producto.Stock.ToString("0.##")
                                </span>
                            </td>
                            <td class="text-center">
                                @if (producto.Stock <= 0)
                                {
                                    <span class="text-danger fw-bold">SIN STOCK</span>
                                }
                                else
                                {
                                    <span class="text-warning fw-bold">STOCK CRÍTICO</span>
                                }
                            </td>
                            <td class="text-center">
                                <a href="/MovimientoStock/Ingreso?productoId=@producto.Id" class="btn btn-sm btn-success">
                                    <i class="bi bi-plus-circle"></i> Reponer Stock
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">
                            No hay productos con stock bajo. ¡Buen trabajo!
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
