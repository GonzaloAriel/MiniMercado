@model IEnumerable<MiniMercado.Models.EgresoCaja>

@{
    ViewData["Title"] = "Historial de Egresos";
}

<div class="container-fluid mt-4">
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h2 class="text-white">
                <i class="bi bi-cash-stack me-2"></i>Historial de Egresos
            </h2>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="Create" class="btn btn-danger">
                <i class="bi bi-plus-circle me-1"></i>Registrar Nuevo Egreso
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow border-0 bg-dark text-white">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 align-middle">
                    <thead class="table-secondary">
                        <tr>
                            <th class="ps-4">Fecha</th>
                            <th>Categoría</th>
                            <th>Beneficiario</th>
                            <th>Descripción</th>
                            <th class="text-end">Monto</th>
                            <th>Usuario</th>
                            <th class="pe-4">Caja ID</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-info-circle fs-2 d-block mb-2"></i>
                                    No se encontraron egresos registrados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <span class="badge bg-outline-info border border-info text-info">
                                            @item.Categoria.ToString()
                                        </span>
                                    </td>
                                    <td>@(item.Proveedor?.Nombre ?? item.Beneficiario ?? "-")</td>
                                    <td>
                                        <span title="@item.Observaciones" style="cursor:help">
                                            @item.Descripcion
                                        </span>
                                    </td>
                                    <td class="text-end fw-bold text-danger ps-4">$ @item.Monto.ToString("N2")</td>
                                    <td>@item.Usuario?.UserName</td>
                                    <td class="pe-4">
                                        @if (item.CajaId.HasValue)
                                        {
                                            <span class="badge bg-secondary">#@item.CajaId</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Sin caja</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (ViewBag.TotalPaginas > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                {
                    <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                        <a class="page-link @(i == ViewBag.PaginaActual ? "bg-danger border-danger" : "bg-dark text-white border-secondary")" 
                           asp-action="Index" asp-route-page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
