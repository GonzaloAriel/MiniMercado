@using MiniMercado.Models.ViewModels
@model CambiarPasswordVM

<h2>Cambiar Contraseña</h2>

<form asp-action="CambiarPassword" method="post">

    <div class="alert alert-info">
        La contraseña debe cumplir con los requisitos del sistema:
        <ul>
            <li>Mínimo 6 caracteres</li>
            <li>Al menos una mayúscula</li>
            <li>Al menos un número</li>
            <li>Al menos un carácter especial</li>
        </ul>
    </div>

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label">Nueva Contraseña</label>
        <input asp-for="NuevaPassword" type="password" class="form-control" />
        <span asp-validation-for="NuevaPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Cambiar Contraseña
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}