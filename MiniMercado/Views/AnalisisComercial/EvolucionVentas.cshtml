@model IEnumerable<MiniMercado.Models.EvolucionVentasViewModel>
@{
    ViewData["Title"] = "Evolución de Ventas";
    var totalFact = Model.Sum(x => x.Facturacion);
    var totalVentas = Model.Sum(x => x.CantidadVentas);
    var ticketPromedio = totalVentas > 0 ? totalFact / totalVentas : 0;
    var mejorPeriodo = Model.OrderByDescending(x => x.Facturacion).FirstOrDefault();
}

<div class="container py-4">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="fw-bold text-white mb-1">📈 Evolución de Ventas</h2>
            <p class="text-white-50">Analizá cómo evolucionan las ventas a lo largo del tiempo.</p>
        </div>
    </div>

    <partial name="_AnalisisComercialNavigation" />

    <!-- Formulario de Filtros -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-bold small">Período</label>
                    <select name="filtro" id="filtro" class="form-select rounded-pill" onchange="togglePersonalizado()">
                        <option value="Hoy" selected="@(ViewBag.Filtro == "Hoy")">Hoy</option>
                        <option value="Mes" selected="@(ViewBag.Filtro == "Mes")">Mes</option>
                        <option value="Año" selected="@(ViewBag.Filtro == "Año")">Año</option>
                        <option value="Personalizado" selected="@(ViewBag.Filtro == "Personalizado")">Personalizado</option>
                    </select>
                </div>
                <div class="col-md-3" id="divDesde" style="display:none;">
                    <label class="form-label fw-bold small">Fecha Desde</label>
                    <input type="date" name="desde" value="@ViewBag.Desde" class="form-control rounded-pill" />
                </div>
                <div class="col-md-3" id="divHasta" style="display:none;">
                    <label class="form-label fw-bold small">Fecha Hasta</label>
                    <input type="date" name="hasta" value="@ViewBag.Hasta" class="form-control rounded-pill" />
                </div>
                <div class="col-md-auto">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Aplicar</button>
                </div>
            </form>
        </div>
    </div>

    <!-- KPIs -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
                <span class="text-muted small text-uppercase fw-bold">Facturación Total</span>
                <h3 class="fw-bold mt-2 text-primary">$@totalFact.ToString("N0")</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
                <span class="text-muted small text-uppercase fw-bold">Cant. Ventas</span>
                <h3 class="fw-bold mt-2 text-primary">@totalVentas.ToString("N0")</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
                <span class="text-muted small text-uppercase fw-bold">Ticket Promedio</span>
                <h3 class="fw-bold mt-2 text-primary">$@ticketPromedio.ToString("N0")</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
                <span class="text-muted small text-uppercase fw-bold">Mejor período</span>
                <h3 class="fw-bold mt-2 text-truncate" title="@(mejorPeriodo?.Periodo ?? "-")">@(mejorPeriodo?.Periodo ?? "-")</h3>
            </div>
        </div>
    </div>

    <!-- Tabla -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead class="text-secondary small">
                        <tr>
                            <th>Fecha</th>
                            <th>Facturación</th>
                            <th>Cantidad de ventas</th>
                            <th>Ticket promedio</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.Periodo</td>
                                <td>$@item.Facturacion.ToString("N0")</td>
                                <td>@item.CantidadVentas.ToString("N0")</td>
                                <td>$@item.TicketPromedio.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Gráfico -->
    <div class="card border-0 shadow-sm rounded-4 mt-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-4">Evolución de Facturación</h5>
            <canvas id="chartEvolucion"></canvas>
        </div>
    </div>
</div>

<partial name="_AnalisisComercialCharts" />
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const labels = @Html.Raw(Json.Serialize(Model.Select(x => x.Periodo)));
        const data = @Html.Raw(Json.Serialize(Model.Select(x => x.Facturacion)));
        createLineChart('chartEvolucion', labels, data, 'Facturación');
    });
</script>

<script>
    function togglePersonalizado() {
        const filtro = document.getElementById('filtro').value;
        const divDesde = document.getElementById('divDesde');
        const divHasta = document.getElementById('divHasta');
        if (filtro === 'Personalizado') {
            divDesde.style.display = 'block';
            divHasta.style.display = 'block';
        } else {
            divDesde.style.display = 'none';
            divHasta.style.display = 'none';
        }
    }
    document.addEventListener("DOMContentLoaded", togglePersonalizado);
</script>
