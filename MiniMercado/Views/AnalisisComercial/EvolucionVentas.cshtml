@{
    ViewData["Title"] = "Evolución de Ventas";
}

<div class="container py-5">
    <div class="card shadow-sm rounded-4 border-0 bg-card p-5 text-center">
        <div class="card-body">
            <div class="icon-shape bg-success-soft text-success rounded-3 mx-auto mb-4" style="width: 72px; height: 72px; display: flex; align-items: center; justify-content: center;">
                <i class="bi bi-graph-up-arrow fs-1"></i>
            </div>
            <h2 class="fw-bold text-primary mb-3">📈 Evolución de Ventas</h2>
            <p class="text-secondary fs-5 mb-4">Próximamente</p>
            <a asp-action="Index" class="btn btn-success rounded-pill px-5 fw-bold text-white">
                Volver al Centro de Análisis
            </a>
        </div>
    </div>
</div>

<style>
    .bg-card { background: var(--bg-card); }
    .bg-success-soft { background: rgba(16,185,129,0.1); }
</style>
