@model MiniMercado.Models.MovimientoStock

<h2>Venta (Salida de Stock)</h2>

<form asp-action="Venta" method="post">

    <div class="form-group">
        <label>Producto</label>
        <select asp-for="ProductoId"
                asp-items="ViewBag.Productos"
                class="form-control">
            <option value="">Seleccione un producto</option>
        </select>
        <span asp-validation-for="ProductoId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Cantidad</label>
        <input asp-for="Cantidad" class="form-control" />
        <span asp-validation-for="Cantidad" class="text-danger"></span>
    </div>

    <input type="hidden" asp-for="Tipo" value="VENTA" />

    <div class="form-group">
        <label>Observación</label>
        <textarea asp-for="Observacion" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-danger mt-3">
        Confirmar Venta
    </button>

    <a asp-controller="Productos" asp-action="Index"
       class="btn btn-secondary mt-3">
        Cancelar
    </a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
