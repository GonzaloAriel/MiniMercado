@model MiniMercado.Models.ViewModels.RegistrarPagoViewModel

@{
    ViewData["Title"] = "Registrar Pago Manual";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Tenants">Gestión de Tenants</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Registrar Pago</li>
                </ol>
            </nav>

            <div class="card shadow-sm mt-3">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0 text-center"><i class="bi bi-wallet2 me-2"></i> Registrar Pago: @Model.NombreComercio</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="RegistrarPago" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="TenantId" />
                        <input type="hidden" asp-for="NombreComercio" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Plan" class="form-label fw-bold">Plan</label>
                                <select asp-for="Plan" class="form-select">
                                    <option value="Mensual">Mensual</option>
                                    <option value="Anual">Anual</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Meses" class="form-label fw-bold">Cantidad de Meses</label>
                                <input asp-for="Meses" class="form-control" type="number" id="inputMeses" min="1" max="60" />
                                <span asp-validation-for="Meses" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Monto" class="form-label fw-bold">Monto Total a Cobrar</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Monto" class="form-control form-control-lg text-primary fw-bold" placeholder="0.00" id="inputMonto" />
                            </div>
                            <span asp-validation-for="Monto" class="text-danger small"></span>
                            <div class="form-text mt-2"><i class="bi bi-info-circle me-1"></i> Precio mensual configurado: <strong>@Model.PrecioSugerido.ToString("C")</strong></div>
                        </div>

                        <hr class="my-4">

                        <div class="mb-4">
                            <label asp-for="Observacion" class="form-label fw-bold"></label>
                            <textarea asp-for="Observacion" class="form-control" rows="3" placeholder="Escribe aquí cualquier nota adicional..."></textarea>
                            <span asp-validation-for="Observacion" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                                <i class="bi bi-check-lg"></i> Confirmar Suscripción
                            </button>
                            <a asp-action="Tenants" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const inputMeses = document.getElementById('inputMeses');
            const inputMonto = document.getElementById('inputMonto');
            const precioMensual = @Json.Serialize(Model.PrecioSugerido);

            inputMeses.addEventListener('input', function() {
                const meses = parseInt(this.value) || 0;
                inputMonto.value = (meses * precioMensual).toFixed(2);
            });
        });
    </script>
}
