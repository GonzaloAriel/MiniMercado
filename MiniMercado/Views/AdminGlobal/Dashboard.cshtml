@model MiniMercado.Models.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Dashboard de Ingresos Globales";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Dashboard Administrativo Global</h2>
        <a asp-action="Tenants" class="btn btn-outline-primary">
            <i class="bi bi-list-task me-1"></i> Ver Todos los Tenants
        </a>
    </div>

    <!-- Fila de Métricas Principales -->
    <div class="row g-4 mb-5">
        <!-- Total Recaudado -->
        <div class="col-md-4">
            <div class="card bg-primary text-white shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <i class="bi bi-cash-coin" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3 opacity-75">Total Recaudado</h5>
                    <p class="display-6 fw-bold mb-0">@Model.TotalRecaudado.ToString("C")</p>
                </div>
            </div>
        </div>

        <!-- Tenants Activos -->
        <div class="col-md-4">
            <div class="card bg-success text-white shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <i class="bi bi-shop" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3 opacity-75">Tenants Activos</h5>
                    <p class="display-6 fw-bold mb-0">@Model.TenantsActivos</p>
                </div>
            </div>
        </div>

        <!-- Tenants Vencidos -->
        <div class="col-md-4">
            <div class="card bg-danger text-white shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <i class="bi bi-exclamation-octagon" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3 opacity-75">Tenants Vencidos</h5>
                    <p class="display-6 fw-bold mb-0">@Model.TenantsVencidos</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Fila de Detalles Secundarios -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-dark"><i class="bi bi-info-circle me-2"></i> Resumen de Estados</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Total de Comercios registrados
                            <span class="badge bg-dark rounded-pill">@Model.TotalTenants</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Comercios Bloqueados manualmente
                            <span class="badge bg-danger rounded-pill">@Model.TenantsBloqueados</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-dark"><i class="bi bi-lightning-charge me-2"></i> Acceso Rápido</h5>
                </div>
                <div class="card-body d-flex align-items-center justify-content-around">
                    <a asp-controller="Tenants" asp-action="Create" class="btn btn-success btn-lg px-4 shadow-sm">
                        <i class="bi bi-plus-circle me-2"></i> Crear Nuevo Tenant
                    </a>
                    <a asp-action="Tenants" class="btn btn-primary btn-lg px-4 shadow-sm">
                        <i class="bi bi-search me-2"></i> Gestionar Cobros
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
