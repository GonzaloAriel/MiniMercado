@model MiniMercado.Models.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Dashboard Global SaaS";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap');

    .db-wrap {
        font-family: 'DM Sans', system-ui, sans-serif;
        color: var(--text-primary);
        background: var(--bg-primary);
        padding: 40px 24px 64px;
        max-width: 1200px;
        margin: 0 auto;
        min-height: 100vh;
    }

    .db-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
        gap: 20px;
        flex-wrap: wrap;
    }

    .db-header-left h1 {
        font-size: 36px;
        font-weight: 700;
        letter-spacing: -0.03em;
        margin: 0 0 6px;
        color: var(--text-primary);
    }

    .db-header-left p {
        font-size: 17px;
        color: var(--text-secondary);
        margin: 0;
        font-family: 'DM Mono', monospace;
    }

    .btn-modern {
        font-size: 14px;
        font-weight: 600;
        padding: 12px 24px;
        border-radius: 12px;
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid var(--border);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
    }

    .btn-modern.primary { background: var(--blue); color: #fff; border: none; }
    .btn-modern.success { background: var(--green); color: #fff; border: none; }
    .btn-modern.outline { background: var(--bg-surface); color: var(--text-secondary); }
    .btn-modern:hover { transform: translateY(-2px); opacity: 0.9; color: #fff; text-decoration: none; }

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .kpi-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        padding: 32px;
        position: relative;
        overflow: hidden;
    }

    .kpi-card .icon-bg {
        position: absolute;
        right: -10px;
        bottom: -10px;
        font-size: 80px;
        opacity: 0.05;
        color: var(--text-primary);
    }

    .kpi-label {
        font-size: 14px;
        font-weight: 700;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: .1em;
        margin-bottom: 12px;
        display: block;
    }

    .kpi-value {
        font-family: 'DM Mono', monospace;
        font-size: 40px;
        font-weight: 700;
        line-height: 1;
    }

    .kpi-value.blue { color: var(--blue-text); }
    .kpi-value.green { color: var(--green-text); }
    .kpi-value.red { color: var(--red-text); }

    .data-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 24px;
    }

    .data-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        overflow: hidden;
    }

    .data-card-header {
        padding: 20px 24px;
        background: var(--bg-tertiary);
        border-bottom: 1px solid var(--border);
        font-weight: 700;
        font-size: 16px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .data-card-body { padding: 24px; }

    .list-group-modern .list-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 0;
        border-bottom: 1px solid var(--border-light);
    }

    .list-group-modern .list-item:last-child { border-bottom: none; }

    .badge-modern {
        font-family: 'DM Mono', monospace;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 30px;
        background: var(--bg-surface);
        color: var(--text-primary);
    }

    .badge-modern.red { background: var(--red-bg); color: var(--red-text); }

    .quick-actions {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .quick-actions .btn-modern { width: 100%; justify-content: center; padding: 16px; font-size: 16px; }
</style>

<div class="db-wrap">
    
    <div class="db-header">
        <div class="db-header-left">
            <h1>Panel Administrativo Global</h1>
            <p>Métricas de ingresos y control de suscripciones SaaS</p>
        </div>
        <div class="header-actions">
            <a asp-action="Tenants" class="btn-modern outline">
                <i class="bi bi-list-task"></i> Gestionar Locales
            </a>
        </div>
    </div>

    <div class="kpi-grid">
        <div class="kpi-card">
            <i class="bi bi-cash-coin icon-bg"></i>
            <span class="kpi-label">Recaudación Total</span>
            <span class="kpi-value blue">@Model.TotalRecaudado.ToString("C0")</span>
        </div>
        <div class="kpi-card">
            <i class="bi bi-shop icon-bg"></i>
            <span class="kpi-label">Locales Activos</span>
            <span class="kpi-value green">@Model.TenantsActivos</span>
        </div>
        <div class="kpi-card">
            <i class="bi bi-exclamation-octagon icon-bg"></i>
            <span class="kpi-label">Suscripciones Vencidas</span>
            <span class="kpi-value red">@Model.TenantsVencidos</span>
        </div>
    </div>

    <div class="data-grid">
        <div class="data-card">
            <div class="data-card-header">
                <i class="bi bi-info-circle"></i> Resumen de Estados
            </div>
            <div class="data-card-body">
                <div class="list-group-modern">
                    <div class="list-item">
                        <span class="text-secondary">Total de Comercios registrados</span>
                        <span class="badge-modern">@Model.TotalTenants</span>
                    </div>
                    <div class="list-item">
                        <span class="text-secondary">Comercios Bloqueados manualmente</span>
                        <span class="badge-modern red">@Model.TenantsBloqueados</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="data-card">
            <div class="data-card-header">
                <i class="bi bi-lightning-charge"></i> Acciones Rápidas
            </div>
            <div class="data-card-body">
                <div class="quick-actions">
                    <a asp-controller="Tenants" asp-action="Create" class="btn-modern success">
                        <i class="bi bi-plus-circle"></i> Alta de Nuevo Comercio
                    </a>
                    <a asp-action="Tenants" class="btn-modern primary">
                        <i class="bi bi-credit-card"></i> Registrar Cobros / Pagos
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
