<h4 class="mt-5 text-white">🛡 Registro de Auditoría</h4>

<div class="table-responsive">
    <table class="table table-bordered table-hover table">
    
        <thead>
    
            <tr>
                <th>Fecha</th>
                <th>Usuario</th>
                <th>Acción</th>
                <th>Tabla</th>
                <th>Descripción</th>
            </tr>
    
        </thead>
    
        <tbody>
    
            @foreach (var a in Model.Auditorias)
            {
                <tr>
    
                    <td>@a.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
    
                    <td>@a.UsuarioId</td>
    
                    <td>@a.Accion</td>
    
                    <td>@a.Tabla</td>
    
                    <td>@a.Descripcion</td>
    
