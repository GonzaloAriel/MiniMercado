@model MiniMercado.ViewModels.DashboardCajasViewModel

<h2 class="mt-4 text-white">📋 Auditoría de Cajas</h2>

<form method="get" class="row mb-4">

    <div class="col-md-3">
        <label class="text-white">Desde</label>
        <input type="date" name="desde" value="@Model.FechaDesde?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>

    <div class="col-md-3">
        <label class="text-white">Hasta</label>
        <input type="date" name="hasta" value="@Model.FechaHasta?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>

    <div class="col-md-3 align-self-end">
        <button class="btn btn-primary">Filtrar</button>
    </div>

</form>


<h4 class="text-white">💰 Ventas por Caja / Día</h4>

<div class="table-responsive">
    <table class="table table-bordered table-hover table">
    
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Usuario</th>
                <th>Ventas</th>
                <th>Anuladas</th>
                <th>Total Vendido</th>
            </tr>
        </thead>
    
        <tbody>
    
            @foreach (var item in Model.ResumenCajas)
            {
                <tr>
                    <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@item.Usuario</td>
                    <td>@item.CantidadVentas</td>
                    <td>@item.CantidadAnuladas</td>
                    <td>$@item.TotalVendido</td>
                </tr>
            }
    
        </tbody>
    
    </table>
</div>

@if (ViewBag.TotalResumen > 1)
{
    <div class="pagination-container">
        @if (ViewBag.PageResumen > 1)
        {
            <a asp-action="AuditoriaCajas" 
               asp-route-pageResumen="@(ViewBag.PageResumen - 1)" 
               asp-route-pageVentas="@ViewBag.PageVentas"
               asp-route-pageAuditoria="@ViewBag.PageAuditoria"
               asp-route-desde="@ViewBag.Desde"
               asp-route-hasta="@ViewBag.Hasta"
               class="page-link-modern">
                <i class="bi bi-chevron-left"></i>
            </a>
        }
        else
        {
            <span class="page-link-modern disabled"><i class="bi bi-chevron-left"></i></span>
        }

        @for (int i = 1; i <= ViewBag.TotalResumen; i++)
        {
            if (i == ViewBag.PageResumen)
            {
                <span class="page-link-modern active">@i</span>
            }
            else
            {
                <a asp-action="AuditoriaCajas" 
                   asp-route-pageResumen="@i" 
                   asp-route-pageVentas="@ViewBag.PageVentas"
                   asp-route-pageAuditoria="@ViewBag.PageAuditoria"
                   asp-route-desde="@ViewBag.Desde"
                   asp-route-hasta="@ViewBag.Hasta"
                   class="page-link-modern">@i</a>
            }
        }

        @if (ViewBag.PageResumen < ViewBag.TotalResumen)
        {
            <a asp-action="AuditoriaCajas" 
               asp-route-pageResumen="@(ViewBag.PageResumen + 1)" 
               asp-route-pageVentas="@ViewBag.PageVentas"
               asp-route-pageAuditoria="@ViewBag.PageAuditoria"
               asp-route-desde="@ViewBag.Desde"
               asp-route-hasta="@ViewBag.Hasta"
               class="page-link-modern">
                <i class="bi bi-chevron-right"></i>
            </a>
        }
        else
        {
            <span class="page-link-modern disabled"><i class="bi bi-chevron-right"></i></span>
        }
    </div>
}


<h4 class="mt-5 text-white">🧾 Ventas por Usuario</h4>

<div class="table-responsive">
    <table class="table table-bordered table-hover table">
    
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Usuario</th>
                <th>Total</th>
                <th>Estado</th>
            </tr>
        </thead>
    
        <tbody>
    
            @foreach (var venta in Model.HistorialVentas)
            {
                <tr>
    
                    <td>@venta.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
    
                    <td>@venta.Usuario</td>
    
                    <td>$@venta.Total</td>
    
                    <td>
                        @if (!venta.Activa)
                        {
                            <span class="badge bg-success">Activa</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Anulada</span>
                        }
                    </td>
    
                </tr>
            }
    
        </tbody>
    
    </table>
</div>

