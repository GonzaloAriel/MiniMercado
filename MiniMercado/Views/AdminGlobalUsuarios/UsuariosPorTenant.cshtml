@using MiniMercado.Models.ViewModels
@model List<UsuarioListadoVM>

<h2>Usuarios - @ViewBag.TenantNombre</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Email</th>
            <th>Rol</th>
            <th>Acción</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.Rol</td>
                <td>
                    <a asp-action="ResetPassword"
                       asp-route-id="@user.Id"
                       class="btn btn-sm btn-warning">
                        Reset Password
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Tenants" class="btn btn-secondary">
    Volver
</a>