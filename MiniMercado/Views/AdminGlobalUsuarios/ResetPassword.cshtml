@using MiniMercado.Models.ViewModels
@model CambiarPasswordVM

<h2>Resetear Contraseña</h2>

<div class="alert alert-info">
    La contraseña debe cumplir con los requisitos del sistema:
    <ul>
        <li>Mínimo 6 caracteres</li>
        <li>Al menos una mayúscula</li>
        <li>Al menos un número</li>
        <li>Al menos un carácter especial</li>
    </ul>
</div>

<form asp-action="ResetPassword" method="post">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label>Nueva Contraseña</label>
        <input asp-for="NuevaPassword" type="password" class="form-control" />
        <span asp-validation-for="NuevaPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        Actualizar
    </button>

    <a asp-action="Tenants" class="btn btn-secondary">
        Cancelar
    </a>

</form>