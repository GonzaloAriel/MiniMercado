@model Venta

<h2>Detalle de Venta #@Model.Id</h2>

<table class="table">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Cant.</th>
            <th>Precio</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.Detalles)
        {
            <tr>
                <td>@d.Producto.Nombre</td>
                <td>@d.Cantidad.ToString("0.##")</td>
                <td>@d.PrecioUnitario.ToString("N2")</td>
                <td>
                    @((d.Cantidad * d.PrecioUnitario).ToString("N2"))
                </td>
            </tr>
        }
    </tbody>
</table>

<h4>Total: @Model.Total.ToString("N2")</h4>

<a asp-action="Ticket"
   asp-route-id="@Model.Id"
   target="_blank"
   class="btn btn-secondary">
    🧾 Imprimir Ticket
</a>
