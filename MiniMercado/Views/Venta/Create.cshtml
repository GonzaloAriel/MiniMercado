@model List<MiniMercado.Models.VentaDetalle>

@{
    ViewData["Title"] = "Nueva Venta";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap');

    .db-wrap {
        font-family: 'DM Sans', system-ui, sans-serif;
        color: var(--text-primary);
        background: var(--bg-primary);
        padding: 24px;
        max-width: 1400px;
        margin: 0 auto;
        min-height: 100vh;
    }

    .pos-grid {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 24px;
    }

    @@media (max-width: 1100px) {
        .pos-grid { grid-template-columns: 1fr; }
    }

    .data-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .search-section {
        background: var(--bg-tertiary);
        padding: 24px;
        border-bottom: 1px solid var(--border);
    }

    .search-title {
        font-size: 14px;
        font-weight: 700;
        color: var(--blue-text);
        text-transform: uppercase;
        letter-spacing: .1em;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .form-control-pos {
        background: var(--bg-surface);
        border: 1px solid var(--border);
        color: var(--text-primary);
        border-radius: 12px;
        padding: 14px 20px;
        font-size: 16px;
        width: 100%;
    }

    .form-control-pos:focus {
        border-color: var(--blue);
        box-shadow: 0 0 0 4px var(--blue-bg);
        outline: none;
    }

    .table-container {
        flex: 1;
        overflow-y: auto;
        min-height: 400px;
        max-height: calc(100vh - 350px);
    }

    .db-table {
        width: 100%;
        border-collapse: collapse;
    }

    .db-table th {
        padding: 14px 20px;
        background: var(--bg-tertiary);
        color: var(--text-secondary);
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
        position: sticky;
        top: 0;
        z-index: 10;
        border-bottom: 1px solid var(--border);
    }

    .db-table td {
        padding: 12px 20px;
        border-bottom: 1px solid var(--border-light);
        vertical-align: middle;
    }

    .product-info .name { font-weight: 600; color: var(--text-primary); display: block; }
    .product-info .code { font-family: 'DM Mono', monospace; font-size: 12px; color: var(--text-muted); }

    .qty-input {
        width: 80px;
        background: var(--bg-surface);
        border: 1px solid var(--border);
        color: var(--text-primary);
        border-radius: 8px;
        padding: 6px;
        text-align: center;
        font-family: 'DM Mono', monospace;
        font-weight: 700;
    }

    .price-input {
        width: 100px;
        background: transparent;
        border: 1px solid transparent;
        color: var(--green-text);
        text-align: right;
        font-family: 'DM Mono', monospace;
        font-weight: 700;
    }

    .price-input:not([readonly]) {
        border-color: var(--border);
        background: var(--bg-surface);
        border-radius: 8px;
        padding: 4px 8px;
    }

    .subtotal-text {
        font-family: 'DM Mono', monospace;
        font-weight: 700;
        color: var(--text-primary);
        font-size: 16px;
        text-align: right;
        display: block;
    }

    /* RIGHT COLUMN */
    .summary-card {
        display: flex;
        flex-direction: column;
        gap: 20px;
        position: sticky;
        top: 24px;
    }

    .total-display {
        background: var(--green-bg);
        border: 1px solid var(--green);
        border-radius: var(--radius-xl);
        padding: 32px 24px;
        text-align: center;
    }

    .total-label {
        font-size: 14px;
        font-weight: 700;
        color: var(--green-text);
        text-transform: uppercase;
        letter-spacing: .1em;
        margin-bottom: 8px;
        display: block;
    }

    .total-amount {
        font-family: 'DM Mono', monospace;
        font-size: 48px;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1;
    }

    .total-amount span { color: var(--green); }

    .fiado-section {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        padding: 24px;
    }

    .btn-fiado-toggle {
        width: 100%;
        background: var(--bg-surface);
        border: 1px solid var(--border);
        color: var(--text-secondary);
        padding: 14px;
        border-radius: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-bottom: 16px;
    }

    .btn-fiado-toggle.active {
        background: var(--amber-bg);
        border-color: var(--amber);
        color: var(--amber-text);
    }

    .btn-confirm {
        width: 100%;
        background: var(--green);
        color: #fff;
        border: none;
        padding: 20px;
        border-radius: 16px;
        font-size: 18px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 10px 20px rgba(16, 185, 129, 0.2);
    }

    .btn-confirm:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 30px rgba(16, 185, 129, 0.3);
        filter: brightness(1.1);
    }

    .client-result-item {
        padding: 12px 16px;
        border-bottom: 1px solid var(--border-light);
        cursor: pointer;
        transition: background 0.2s;
        color: var(--text-primary);
    }

    .client-result-item:hover { background: var(--bg-card-hover); }

    .badge-client {
        background: var(--blue-bg);
        color: var(--blue-text);
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 12px;
    }

    .toast-modern {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 12px;
        color: var(--text-primary);
    }
</style>

<div class="db-wrap">
    <div class="pos-grid">
        
        <!-- COLUMNA IZQUIERDA: BUSCADOR Y TABLA -->
        <div class="data-card">
            <div class="search-section">
                <div class="search-title">
                    <i class="bi bi-upc-scan"></i> Escanear o Buscar Producto
                </div>
                @{
                    ViewBag.Label = "";
                    ViewBag.InputId = "productoSeleccionadoId";
                    ViewBag.InputName = "productoSeleccionadoId";
                    ViewBag.SearchId = "superBuscador";
                    ViewBag.ResultId = "dropdownBuscador";
                    ViewBag.Placeholder = "Nombre del producto o código de barras...";
                }
                @await Html.PartialAsync("_BuscadorProductos")
            </div>

            <form method="post" id="formVenta">
                @Html.AntiForgeryToken()
                <div class="table-container">
                    <table class="db-table" id="tablaVenta">
                        <thead>
                            <tr>
                                <th style="width:45%">Producto</th>
                                <th style="width:15%" class="text-center">Cant / Kg</th>
                                <th style="width:15%" class="text-end">Precio</th>
                                <th style="width:15%" class="text-end">Subtotal</th>
                                <th style="width:10%"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                for (int i = 0; i < Model.Count; i++)
                                {
                                    if (!Model[i].ProductoId.HasValue) continue;
                                    <tr>
                                        <td>
                                            <div class="product-info">
                                                <span class="name">@Model[i].Producto?.Nombre</span>
                                                <span class="code">ID: @Model[i].ProductoId</span>
                                                <input type="hidden" name="detalles[@i].ProductoId" value="@Model[i].ProductoId" class="producto-id" />
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <input type="number" name="detalles[@i].Cantidad" class="qty-input cantidad" value="@Model[i].Cantidad" step="0.01" min="0.01" />
                                        </td>
                                        <td class="text-end">
                                            <input type="text" name="detalles[@i].PrecioUnitario" class="price-input precio" value="@Model[i].PrecioUnitario" @(Model[i].Producto?.PrecioEditable == true ? "" : "readonly") />
                                        </td>
                                        <td class="text-end">
                                            <span class="subtotal-text subtotal">$@(Model[i].Cantidad * Model[i].PrecioUnitario)</span>
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn-action btn btn-outline-danger btn-sm border-0" onclick="eliminarFila(this)">
                                                <i class="bi bi-trash fs-5"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <input type="hidden" id="esFiadoInput" name="EsFiado" value="false" />
                <input type="hidden" id="clienteId" name="ClienteId" />
            </form>
        </div>

        <!-- COLUMNA DERECHA: TOTAL Y ACCIONES -->
        <div class="summary-card">
            
            <div class="total-display">
                <span class="total-label">Total a Pagar</span>
                <div class="total-amount"><span>$</span> <span id="totalVenta">0</span></div>
            </div>

            <div class="fiado-section">
                <button type="button" id="btnFiado" class="btn-fiado-toggle" onclick="toggleFiado()">
                    <i class="bi bi-journal-bookmark"></i> Venta al Fiado
                </button>

                <div id="seccionFiado" class="d-none">
                    <div class="position-relative mb-2">
                        <input type="text" id="buscadorCliente" class="form-control-pos" placeholder="Buscar cliente..." autocomplete="off" />
                        <button type="button" class="btn btn-sm btn-success position-absolute top-50 end-0 translate-middle-y me-2" onclick="abrirModalCliente()">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>
                    <div id="resultadosCliente" class="list-group list-group-flush bg-transparent border-0"></div>

                    <div id="clienteSeleccionado" class="badge-client d-none">
                        <span id="clienteNombre"></span>
                        <span id="clienteSaldo"></span>
                    </div>
                </div>
            </div>

            <button type="button" class="btn-confirm" onclick="document.getElementById('formVenta').submit()">
                <i class="bi bi-check2-circle me-2"></i> Confirmar Venta
            </button>

            <div class="text-muted text-center small mt-2">
                <i class="bi bi-keyboard me-1"></i> [F10] Confirmar · [F2] Fiado · [ESC] Limpiar
            </div>
        </div>
    </div>
</div>

<!-- TOAST FEEDBACK -->
<div class="toast-container position-fixed bottom-0 start-50 translate-middle-x p-3">
    <div id="liveToast" class="toast toast-modern shadow-lg" role="alert">
        <div class="d-flex p-3 align-items-center">
            <i class="bi bi-check-circle-fill text-success fs-4 me-3"></i>
            <div class="toast-body p-0 fw-bold" id="toastMessage">Producto agregado</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/buscador-productos.js"></script>
    <script>
    let index = @(Model?.Count ?? 0);
    let fiadoActivo = false;
    let toastBootstrap;

    const beep = new Audio('/sounds/beep.mp3');
    const errorSound = new Audio('/sounds/error.mp3');

    document.addEventListener("DOMContentLoaded", function() {
        toastBootstrap = bootstrap.Toast.getOrCreateInstance(document.getElementById('liveToast'));

        initBuscador({
            searchId: "superBuscador",
            inputId: "productoSeleccionadoId",
            resultId: "dropdownBuscador",
            onSelect: function(p) {
                agregarOIncrementar(p);
                mostrarToast(`✔ ${p.nombre} agregado`);
                document.getElementById("superBuscador").value = "";
                setTimeout(() => document.getElementById("superBuscador").focus(), 50);
            }
        });

        document.addEventListener("keydown", function(e) {
            if (e.key === "F2") { e.preventDefault(); toggleFiado(); }
            if (e.key === "F10" || e.key === "End") { e.preventDefault(); document.getElementById("formVenta").submit(); }
            if (e.key === "Escape") {
                const buscador = document.getElementById("superBuscador");
                buscador.value = "";
                document.getElementById("dropdownBuscador").classList.add("d-none");
                buscador.focus();
            }
        });
    });

    function mostrarToast(mensaje) {
        document.getElementById("toastMessage").innerText = mensaje;
        toastBootstrap.show();
    }

    function agregarOIncrementar(prod) {
        const p = {
            id: prod.id,
            nombre: prod.nombre,
            precio: prod.precio,
            stock: prod.stock,
            esPorPeso: prod.esPorPeso,
            codigoBarra: prod.codigo || prod.codigoBarra
        };

        const filas = document.querySelectorAll("#tablaVenta tbody tr");
        for (let fila of filas) {
            const idInput = fila.querySelector(".producto-id");
            if (idInput && idInput.value == p.id) {
                const cantidadInput = fila.querySelector(".cantidad");
                cantidadInput.value = (parseFloat(cantidadInput.value) + 1).toFixed(p.esPorPeso ? 2 : 0);
                recalcularFila(fila);
                resaltarFila(fila);
                return;
            }
        }

        const tbody = document.querySelector("#tablaVenta tbody");
        const nuevaFila = `
            <tr>
                <td>
                    <div class="product-info">
                        <span class="name">${p.nombre}</span>
                        <span class="code">COD: ${p.codigoBarra}</span>
                        <input type="hidden" name="detalles[${index}].ProductoId" value="${p.id}" class="producto-id" />
                    </div>
                </td>
                <td class="text-center">
                    <input type="number" name="detalles[${index}].Cantidad" class="qty-input cantidad" 
                           value="1" step="0.01" min="0.01" oninput="recalcularFila(this.closest('tr'))" />
                </td>
                <td class="text-end">
                    <input type="text" name="detalles[${index}].PrecioUnitario" class="price-input precio" 
                               value="${p.precio}" readonly />
                </td>
                <td class="text-end">
                    <span class="subtotal-text subtotal">$${p.precio}</span>
                </td>
                <td class="text-center">
                    <button type="button" class="btn-action btn btn-outline-danger btn-sm border-0" onclick="eliminarFila(this)">
                        <i class="bi bi-trash fs-5"></i>
                    </button>
                </td>
            </tr>
        `;
        tbody.insertAdjacentHTML("beforeend", nuevaFila);
        index++;
        recalcularTotal();
        
        if (p.stock <= 0) {
            mostrarToast(`⚠ ${p.nombre} (Sin stock)`);
            errorSound.play().catch(() => { });
        } else {
            beep.play().catch(() => { });
        }
    }

    function resaltarFila(fila) {
        fila.style.background = "var(--bg-card-hover)";
        setTimeout(() => fila.style.background = "transparent", 400);
    }

    function recalcularFila(fila) {
        const cant = parseFloat(fila.querySelector(".cantidad").value) || 0;
        const prec = parseFloat(fila.querySelector(".precio").value) || 0;
        fila.querySelector(".subtotal").innerText = "$" + (cant * prec).toFixed(0);
        recalcularTotal();
    }

    function recalcularTotal() {
        let total = 0;
        document.querySelectorAll(".subtotal").forEach(s => {
            total += parseFloat(s.innerText.replace("$", "")) || 0;
        });
        document.getElementById("totalVenta").innerText = total.toFixed(0);
    }

    function eliminarFila(btn) {
        btn.closest("tr").remove();
        renumerarFilas();
        recalcularTotal();
        document.getElementById("superBuscador").focus();
    }

    function renumerarFilas() {
        document.querySelectorAll("#tablaVenta tbody tr").forEach((fila, i) => {
            fila.querySelector(".producto-id").name = `detalles[${i}].ProductoId`;
            fila.querySelector(".cantidad").name = `detalles[${i}].Cantidad`;
            fila.querySelector(".precio").name = `detalles[${i}].PrecioUnitario`;
        });
        index = document.querySelectorAll("#tablaVenta tbody tr").length;
    }

    function toggleFiado() {
        fiadoActivo = !fiadoActivo;
        const seccion = document.getElementById("seccionFiado");
        const btn = document.getElementById("btnFiado");
        const input = document.getElementById("esFiadoInput");

        if (fiadoActivo) {
            seccion.classList.remove("d-none");
            btn.classList.add("active");
            input.value = "true";
            document.getElementById("buscadorCliente").focus();
        } else {
            seccion.classList.add("d-none");
            btn.classList.remove("active");
            input.value = "false";
            document.getElementById("clienteId").value = "";
            document.getElementById("clienteSeleccionado").classList.add("d-none");
            document.getElementById("resultadosCliente").innerHTML = "";
            document.getElementById("buscadorCliente").value = "";
        }
    }

    document.getElementById("buscadorCliente")?.addEventListener("input", function() {
        const q = this.value;
        if (q.length < 2) {
            document.getElementById("resultadosCliente").innerHTML = "";
            return;
        }

        fetch(`/Cliente/Buscar?q=${encodeURIComponent(q)}`)
            .then(r => r.json())
            .then(data => {
                const lista = document.getElementById("resultadosCliente");
                lista.innerHTML = "";
                data.forEach(c => {
                    const item = document.createElement("div");
                    item.className = "client-result-item small";
                    item.textContent = c.nombre;
                    item.onclick = () => {
                        seleccionarCliente(c);
                        lista.innerHTML = "";
                        document.getElementById("buscadorCliente").value = c.nombre;
                    };
                    lista.appendChild(item);
                });
            });
    });

    function seleccionarCliente(c) {
        document.getElementById("clienteId").value = c.id;
        document.getElementById("clienteNombre").textContent = c.nombre;
        document.getElementById("clienteSeleccionado").classList.remove("d-none");

        fetch(`/Cliente/Saldo?id=${c.id}`)
            .then(r => r.json())
            .then(data => {
                const saldoEl = document.getElementById("clienteSaldo");
                saldoEl.textContent = data.saldo > 0 ? `$${data.saldo.toFixed(0)}` : "Al día";
                saldoEl.className = data.saldo > 0 ? "text-danger" : "text-success";
            });
    }

    function abrirModalCliente() {
        new bootstrap.Modal(document.getElementById("modalNuevoCliente")).show();
        setTimeout(() => document.getElementById("nuevoClienteNombre").focus(), 400);
    }

    function guardarClienteRapido() {
        const nombre = document.getElementById("nuevoClienteNombre").value.trim();
        const telefono = document.getElementById("nuevoClienteTelefono").value.trim();
        if (!nombre) return;

        fetch("/Cliente/CrearRapido", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ nombre, telefono })
        })
        .then(r => r.json())
        .then(data => {
            if (data.ok) {
                seleccionarCliente({ id: data.id, nombre: data.nombre });
                document.getElementById("buscadorCliente").value = data.nombre;
                bootstrap.Modal.getInstance(document.getElementById("modalNuevoCliente")).hide();
            }
        });
    }

    window.onload = () => {
        document.getElementById("superBuscador").focus();
        recalcularTotal();
    };

    document.addEventListener("input", function(e) {
        if (e.target.classList.contains("cantidad") || e.target.classList.contains("precio")) {
            const fila = e.target.closest("tr");
            if (fila) recalcularFila(fila);
        }
    });

    document.querySelector("form").onsubmit = function(e) {
        if (fiadoActivo && !document.getElementById("clienteId").value) {
            e.preventDefault();
            alert("Seleccione un cliente.");
            return false;
        }
        document.querySelectorAll(".cantidad, .precio").forEach(i => i.value = i.value.replace(",", "."));
    };
    </script>
}

<!-- MODAL NUEVO CLIENTE -->
<div class="modal fade" id="modalNuevoCliente" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-xl);">
            <div class="modal-header border-0 p-4 pb-0">
                <h5 class="modal-title fw-bold">Nuevo Cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="text-secondary small fw-bold text-uppercase mb-2 d-block">Nombre Completo</label>
                    <input type="text" id="nuevoClienteNombre" class="form-control-pos" placeholder="Juan Pérez" />
                </div>
                <div class="mb-3">
                    <label class="text-secondary small fw-bold text-uppercase mb-2 d-block">Teléfono</label>
                    <input type="text" id="nuevoClienteTelefono" class="form-control-pos" placeholder="Opcional" />
                </div>
            </div>
            <div class="modal-footer border-0 p-4 pt-0">
                <button type="button" class="btn btn-outline-secondary w-100 mb-2" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success w-100" onclick="guardarClienteRapido()">Guardar y Seleccionar</button>
            </div>
        </div>
    </div>
</div>
