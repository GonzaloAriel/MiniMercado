@model List<MiniMercado.Models.VentaDetalle>

<h2 class="mb-3 mt-4">🛒 Nueva Venta</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form method="post">

    <div class="card mb-3">
        <div class="card-body p-0">

            <div class="mb-3">
                <input type="text"
                       id="buscadorProducto"
                       class="form-control form-control-lg"
                       placeholder="🔎 Buscar producto o código de barras..." />
            </div>

            <table class="table table-bordered table-hover mb-0" id="tablaVenta">
                <thead class="table-dark text-center">
                    <tr>
                        <th style="width:35%">Producto</th>
                        <th style="width:15%">Cantidad / Kg</th>
                        <th style="width:15%">Precio</th>
                        <th style="width:15%">Subtotal</th>
                        <th style="width:10%"></th>
                    </tr>
                </thead>

                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr>
                            <td>
                                <select name="detalles[@i].ProductoId"
                                        class="form-control producto-select">

                                    <option value="">Seleccione</option>

                                    @foreach (var p in ViewBag.Productos)
                                    {
                                        <option value="@p.Id"
                                                data-precio="@p.Precio"
                                                data-peso="@p.EsPorPeso"
                                                data-editable="@p.PrecioEditable">

                                            @p.Nombre (Stock: @p.Stock.ToString("0.##"))

                                        </option>
                                    }

                                </select>
                            </td>

                            <td>
                                <input type="number"
                                       name="detalles[@i].Cantidad"
                                       class="form-control cantidad"
                                       value="1"
                                       step="0.01"
                                       min="0.01" />
                            </td>

                            <td>
                                <input type="text"
                                       name="detalles[@i].PrecioUnitario"
                                       class="form-control precio"
                                       readonly />
                            </td>

                            <td class="text-end fw-bold subtotal">$0</td>

                            <td class="text-center">
                                <button type="button"
                                        class="btn btn-danger"
                                        onclick="eliminarFila(this)">
                                    ❌
                                </button>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center">

        <button type="button"
                class="btn btn-primary btn-lg"
                onclick="agregarFila()">
            ➕ Agregar producto
        </button>

        <div class="fs-3 fw-bold">
            TOTAL: $ <span id="totalVenta">0</span>
        </div>

    </div>

    <div class="mt-4">
        <button type="submit"
                class="btn btn-success btn-lg w-100 mt-4">
            ✅ Confirmar Venta
        </button>
    </div>

</form>

<script>

    let index = @Model.Count;

    const productos = [

    @foreach (var p in ViewBag.Productos)
    {
                        @: {
                        @: id: @p.Id,
                        @: nombre: "@p.Nombre",
                        @: codigo: "@p.CodigoBarra",
                        @: precio: @p.Precio,
                        @: peso: "@p.EsPorPeso",
                        @: editable: "@p.PrecioEditable"
                        @: },
    }

    ];

</script>

<script>

    function agregarFila(){

    const tbody = document.querySelector("#tablaVenta tbody");

    const fila = `
    <tr>

    <td>

    <select name="detalles[${index}].ProductoId"
            class="form-control producto-select">

    <option value="">Seleccione</option>

    @foreach (var p in ViewBag.Productos)
    {
                        <text>
                            <option value="@p.Id"
                    data-precio="@p.Precio"
                    data-peso="@p.EsPorPeso"
                    data-editable="@p.PrecioEditable">
                                @p.Nombre
                            </option>
                        </text>
    }

    </select>

    </td>

    <td>
    <input type="number"
    name="detalles[${index}].Cantidad"
    class="form-control cantidad"
    value="1"
    step="0.01"
    min="0.01"/>
    </td>

    <td>
    <input type="text"
    name="detalles[${index}].PrecioUnitario"
    class="form-control precio"
    readonly/>
    </td>

    <td class="text-end fw-bold subtotal">$0</td>

    <td class="text-center">
    <button type="button"
    class="btn btn-danger"
    onclick="eliminarFila(this)">❌</button>
    </td>

    </tr>
    `;

    tbody.insertAdjacentHTML("beforeend",fila);

    index++;

    }

</script>

<script>

    document.getElementById("buscadorProducto")
    .addEventListener("keyup",function(){

    const texto=this.value.toLowerCase();

    if(texto.length<2) return;

    const producto=productos.find(p=>

    p.nombre.toLowerCase().includes(texto)
    ||
    p.codigo.includes(texto)

    );

    if(producto){

    completarFila(producto);

    this.value="";

    }

    });

</script>

<script>
       function completarFila(prod)
    {
        const filas = document.querySelectorAll("#tablaVenta tbody tr");

        // 1️⃣ buscar si el producto ya está en la tabla
        for (let fila of filas)
        {
            const select = fila.querySelector(".producto-select");

            if (select.value == prod.id)
            {
                const cantidadInput = fila.querySelector(".cantidad");

                let cantidad = parseFloat(cantidadInput.value) || 0;

                cantidadInput.value = cantidad + 1;

                recalcularFila(fila);

                return; // ya existe → no crear nueva fila
            }
        }

        // 2️⃣ buscar fila libre
        let filaLibre = null;

        filas.forEach(f => {

            const select = f.querySelector(".producto-select");

            if (!select.value && !filaLibre)
                filaLibre = f;
        });

        // 3️⃣ si no hay fila libre → crear
        if (!filaLibre)
        {
            agregarFila();
            filaLibre = document.querySelector("#tablaVenta tbody tr:last-child");
        }

        // 4️⃣ completar producto
        const select = filaLibre.querySelector(".producto-select");

        for (let option of select.options)
        {
            if (option.value == prod.id)
            {
                option.selected = true;
                break;
            }
        }

        select.dispatchEvent(new Event("change", { bubbles: true }));

        document.getElementById("buscadorProducto").focus();
    }
</script>

<script>

    document.addEventListener("change",function(e){

    if(e.target.classList.contains("producto-select")){

    const fila=e.target.closest("tr");

    const option=e.target.selectedOptions[0];

    const precio=parseFloat(option.dataset.precio)||0;

    const precioInput=fila.querySelector(".precio");

    precioInput.value=precio.toFixed(0);

    recalcularFila(fila);

    }

    });

</script>

<script>

    function recalcularFila(fila){

    const cantidad=parseFloat(
    fila.querySelector(".cantidad").value.replace(",",".")
    )||0;

    const precio=parseFloat(
    fila.querySelector(".precio").value.replace(",",".")
    )||0;

    const subtotal=cantidad*precio;

    fila.querySelector(".subtotal").innerText="$"+subtotal.toFixed(0);

    recalcularTotal();

    }

    function recalcularTotal(){

    let total=0;

    document.querySelectorAll(".subtotal").forEach(s=>{

    total+=parseFloat(s.innerText.replace("$",""))||0;

    });

    document.getElementById("totalVenta").innerText=total.toFixed(0);

    }

</script>

<script>
    function eliminarFila(btn) {
        btn.closest("tr").remove();
        renumerarFilas();
        recalcularTotal();
    }

    function renumerarFilas() {
        const filas = document.querySelectorAll("#tablaVenta tbody tr");
        filas.forEach(function (fila, i) {
            const select = fila.querySelector(".producto-select");
            const cantidad = fila.querySelector(".cantidad");
            const precio = fila.querySelector(".precio");

            if (select)   select.name   = `detalles[${i}].ProductoId`;
            if (cantidad) cantidad.name = `detalles[${i}].Cantidad`;
            if (precio)   precio.name   = `detalles[${i}].PrecioUnitario`;
        });
        index = filas.length;
    }
</script>

<script>

    document.querySelector("form")
    .addEventListener("submit",function(){

    document.querySelectorAll(".cantidad,.precio").forEach(i=>{

    i.value=i.value.replace(",", ".");

    });

    });

</script>

<script>
        window.onload = function ()
    {
        document.getElementById("buscadorProducto").focus();
    };
</script>

<script>
    document.addEventListener("input", function (e) {
        if (e.target.classList.contains("cantidad")) {
            const fila = e.target.closest("tr");
            recalcularFila(fila);
        }
    });
</script>

<script>
    // Bloquea punto y coma en productos por unidad
    document.addEventListener("keydown", function (e) {
        if (!e.target.classList.contains("cantidad")) return;

        const fila = e.target.closest("tr");
        const select = fila.querySelector(".producto-select");
        const option = select?.selectedOptions[0];
        const esPorPeso = option?.dataset.peso?.toLowerCase() === "true";

        if (!esPorPeso && (e.key === "." || e.key === ",")) {
            e.preventDefault();
        }
    });
</script>

<script>
    // Limpia decimales en tiempo real si el producto es por unidad
    document.addEventListener("input", function (e) {
        if (!e.target.classList.contains("cantidad")) return;

        const fila = e.target.closest("tr");
        const select = fila.querySelector(".producto-select");
        const option = select?.selectedOptions[0];
        const esPorPeso = option?.dataset.peso?.toLowerCase() === "true";

        if (!esPorPeso) {
            const val = e.target.value;
            if (val.includes(".") || val.includes(",")) {
                e.target.value = Math.floor(parseFloat(val) || 1);
            }
        }

        recalcularFila(fila);
    });
</script>
