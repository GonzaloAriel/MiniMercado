@model List<MiniMercado.Models.VentaDetalle>

<h2 class="mb-3 mt-4">🛒 Nueva Venta</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form method="post">

    <div class="card mb-3">
        <div class="card-body p-0">

            <table class="table table-bordered table-hover mb-0" id="tablaVenta">
                <thead class="table-dark text-center">
                    <tr>
                        <th style="width:35%">Producto</th>
                        <th style="width:15%">Cantidad / Kg</th>
                        <th style="width:15%">Precio</th>
                        <th style="width:15%">Subtotal</th>
                        <th style="width:10%"></th>
                    </tr>
                </thead>

                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr>
                            <td>
                                <select name="detalles[@i].ProductoId"
                                        class="form-control producto-select"
                                        data-index="@i">
                                    <option value="">Seleccione</option>
                                    @foreach (var p in ViewBag.Productos)
                                    {
                                        <option value="@p.Id"
                                                data-precio="@p.Precio"
                                                data-peso="@p.EsPorPeso"
                                                data-editable="@p.PrecioEditable">
                                            @p.Nombre (Stock: @p.Stock.ToString("0.##"))
                                        </option>
                                    }
                                </select>
                            </td>

                            <td>
                                <input type="number"
                                       name="detalles[@i].Cantidad"
                                       class="form-control cantidad"
                                       value="1"
                                       step="0.01"
                                       min="0.01" />
                            </td>

                            <td>
                                <input type="text"
                                       name="detalles[@i].PrecioUnitario"
                                       class="form-control precio"
                                       step="0.01"
                                       readonly />
                            </td>

                            <td class="text-end fw-bold subtotal">$0.00</td>

                            <td class="text-center">
                                <button type="button"
                                        class="btn btn-danger"
                                        onclick="eliminarFila(this)">
                                    ❌
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>

    <!-- TOTAL BIEN VISIBLE -->
    <div class="d-flex justify-content-between align-items-center ">
        <button type="button"
                class="btn btn-primary btn-lg"
                onclick="agregarFila()">
            ➕ Agregar producto
        </button>

        <div class="fs-3 fw-bold">
            TOTAL: $ <span id="totalVenta">0.00</span>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-success btn-lg w-100 mt-4">
            ✅ Confirmar Venta
        </button>
    </div>

</form>

<script>
    let index = @Model.Count;

    function agregarFila() {

        limpiarErroresGlobales();

        const tbody = document.querySelector("#tablaVenta tbody");

        const fila = `
        <tr>
            <td>
                <select name="detalles[${index}].ProductoId"
                        class="form-control producto-select"
                        data-index="${index}">
                    <option value="">Seleccione</option>
                    @foreach (var p in ViewBag.Productos)
                    {
                                        <option value="@p.Id"
                                                data-precio="@p.Precio"
                                                data-peso="@p.EsPorPeso"
                                                data-editable="@p.PrecioEditable">
                                            @p.Nombre
                                        </option>
                    }
                </select>
            </td>

            <td>
                <input type="number"
                       name="detalles[${index}].Cantidad"
                       class="form-control cantidad"
                       value="1"
                       step="0.01"
                       min="0.01" />
            </td>

            <td>
                <input type="text"
                       name="detalles[${index}].PrecioUnitario"
                       class="form-control precio"
                       step="0.01"
                       readonly />
            </td>

            <td class="text-end fw-bold subtotal">$0.00</td>

            <td class="text-center">
                <button type="button"
                        class="btn btn-danger"
                        onclick="eliminarFila(this)">
                    ❌
                </button>
            </td>
        </tr>
        `;

        tbody.insertAdjacentHTML("beforeend", fila);
        index++;
    }
</script>

<script>
    function recalcularFila(fila) {
            const cantidad = parseFloat(
        fila.querySelector(".cantidad").value.replace(",", ".")
    ) || 0;

            const precio = parseFloat(
        fila.querySelector(".precio").value.replace(",", ".")
    ) || 0;

        const subtotal = cantidad * precio;

        fila.querySelector(".subtotal").innerText = "$" + subtotal;
        recalcularTotal();
    }

    function recalcularTotal() {
        let total = 0;
        document.querySelectorAll(".subtotal").forEach(s => {
            total += parseFloat(s.innerText.replace("$", "")) || 0;
        });
        document.getElementById("totalVenta").innerText = total;
    }

       document.addEventListener("change", function (e) {

        if (e.target.classList.contains("producto-select")) {

            limpiarErroresGlobales();

            const fila = e.target.closest("tr");
            const option = e.target.selectedOptions[0];

            const precio = parseFloat(option.dataset.precio) || 0;

            const esPorPeso = option.dataset.peso === "True";
            const editable = option.dataset.editable === "True";

            const cantidadInput = fila.querySelector(".cantidad");

    if (esPorPeso) {
        cantidadInput.step = "0.01";
        cantidadInput.min = "0.01";
    } else {
        cantidadInput.step = "1";
        cantidadInput.min = "1";
        cantidadInput.value = Math.floor(cantidadInput.value);
    }


            const precioInput = fila.querySelector(".precio");
            precioInput.value = Number.isInteger(precio)
    ? precio.toString()
    : precio.toFixed(2);

            precioInput.readOnly = !editable;

            recalcularFila(fila);
        }
    });


    document.addEventListener("input", function (e) {
        if (e.target.classList.contains("cantidad") ||
            e.target.classList.contains("precio")) {
            recalcularFila(e.target.closest("tr"));
        }
    });

    function eliminarFila(btn)
    {
        btn.closest("tr").remove();
        reindexarFilas();
        recalcularTotal();
    }

    function reindexarFilas()
    {
        const filas = document.querySelectorAll("#tablaVenta tbody tr");

        filas.forEach((fila, i) => {

            fila.querySelectorAll("select, input").forEach(input => {

                if (input.name.includes("ProductoId"))
                    input.name = `detalles[${i}].ProductoId`;

                if (input.name.includes("Cantidad"))
                    input.name = `detalles[${i}].Cantidad`;

                if (input.name.includes("PrecioUnitario"))
                    input.name = `detalles[${i}].PrecioUnitario`;
            });
        });

        index = filas.length;
    }

</script>

<script>
    document.querySelector("form").addEventListener("submit", function () {

        document.querySelectorAll(".cantidad, .precio").forEach(input => {
            input.value = input.value.replace(",", ".");
        });

    });
</script>

<script>
        function limpiarErroresGlobales() {
        const summary = document.querySelector(".validation-summary-errors");

        if (summary) {
            summary.innerHTML = "";
            summary.classList.remove("validation-summary-errors");
            summary.classList.add("validation-summary-valid");
        }
    }
</script>

<script>
        document.addEventListener("focusin", function (e) {
        if (e.target.classList.contains("producto-select")) {
            limpiarErroresGlobales();
        }
    });

    document.addEventListener("click", function (e) {
        if (e.target.classList.contains("producto-select")) {
            limpiarErroresGlobales();
        }
    });
</script>
