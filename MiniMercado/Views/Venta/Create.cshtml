@model List<MiniMercado.Models.VentaDetalle>

<h2 class="mb-3 mt-4">🛒 Nueva Venta</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<div class="card mb-4 shadow-sm border-primary">
    <div class="card-body bg-dark text-white">
        <h5 class="card-title text-primary"><i class="bi bi-upc-scan"></i>BUSCADOR</h5>
        <p class="small text-muted">Escriba nombre, código o escanee directamente. Presione ENTER para agregar.</p>
        
        @{
            ViewBag.Label = "";
            ViewBag.InputId = "productoSeleccionadoId"; // ID temporal
            ViewBag.InputName = "productoSeleccionadoId";
            ViewBag.SearchId = "superBuscador";
            ViewBag.ResultId = "dropdownBuscador";
            ViewBag.Placeholder = "Escriba nombre, código o escanee...";
        }
        @await Html.PartialAsync("_BuscadorProductos")
        
        <div id="statusBusqueda" class="mt-2 small"></div>
    </div>
</div>

<form method="post">
    @Html.AntiForgeryToken()

    <div class="card mb-3 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-bordered table-hover mb-0" id="tablaVenta">
                <thead class="table-dark text-center">
                    <tr>
                        <th style="width:40%">Producto</th>
                        <th style="width:15%">Cantidad / Kg</th>
                        <th style="width:15%">Precio</th>
                        <th style="width:15%">Subtotal</th>
                        <th style="width:15%"></th>
                    </tr>
                </thead>
                <tbody class="align-middle">
                    @* Empezamos con la tabla vacía o con filas si vienen del modelo (ej: errores de validación) *@
                    @if (Model != null && Model.Any(d => d.ProductoId.HasValue))
                    {
                        for (int i = 0; i < Model.Count; i++)
                        {
                            if (!Model[i].ProductoId.HasValue) continue;
                            <tr>
                                <td>
                                    <span class="fw-bold">@Model[i].Producto?.Nombre</span>
                                    <input type="hidden" name="detalles[@i].ProductoId" value="@Model[i].ProductoId" class="producto-id" />
                                </td>
                                <td>
                                    <input type="number" name="detalles[@i].Cantidad" class="form-control cantidad text-center" value="@Model[i].Cantidad" step="0.01" min="0.01" />
                                </td>
                                <td>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input type="text" name="detalles[@i].PrecioUnitario" class="form-control precio" value="@Model[i].PrecioUnitario" @(Model[i].Producto?.PrecioEditable == true ? "" : "readonly") />
                                    </div>
                                </td>
                                <td class="text-end fw-bold subtotal">$@(Model[i].Cantidad * Model[i].PrecioUnitario)</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="eliminarFila(this)">
                                        <i class="bi bi-trash"></i> Quitar
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            @* Botón opcional si quieren agregar manual, aunque el superbuscador debería bastar *@
        </div>
        <div class="card bg-light border-0">
            <div class="card-body py-2 px-4">
                <span class="text-muted small me-2">TOTAL A PAGAR:</span>
                <span class="fs-2 fw-bold text-success">$ <span id="totalVenta">0</span></span>
            </div>
        </div>
    </div>

    <!-- SECCIÓN FIADO -->
    <div class="mt-lg-5 border-top pt-3">

        <input type="hidden" id="esFiadoInput" name="EsFiado" value="false" />

        <button type="button"
                id="btnFiado"
                class="btn btn-outline-secondary btn-lg"
                onclick="toggleFiado()">
            📋 Fiado
        </button>

        <div id="seccionFiado" class="d-none mt-3">
            <div class="input-group mb-2">
                <input type="text"
                       id="buscadorCliente"
                       class="form-control"
                       placeholder="🔎 Buscar cliente por nombre..."
                       autocomplete="off" />
                <button type="button"
                        class="btn btn-outline-success "
                        onclick="abrirModalCliente()">
                    ➕ Nuevo
                </button>
            </div>

            <div id="resultadosCliente" class="list-group mb-2"></div>

            <input type="hidden" id="clienteId" name="ClienteId" />

            <div id="clienteSeleccionado" class="alert alert-info d-none">
                <span id="clienteNombre"></span>
                <span id="clienteSaldo" class="ms-3 fw-bold text-danger"></span>
            </div>
        </div>

    </div>

    <div class="mt-2">
        <button type="submit"
                class="btn btn-success btn-lg w-100 mt-4">
            ✅ Confirmar Venta
        </button>
    </div>

</form>

@section Scripts {
    <script src="~/js/buscador-productos.js"></script>
    <script>
    let index = @(Model?.Count ?? 0);
    let fiadoActivo = false;

    document.addEventListener("DOMContentLoaded", function() {
        initBuscador({
            searchId: "superBuscador",
            inputId: "productoSeleccionadoId",
            resultId: "dropdownBuscador",
            onSelect: function(p) {
                agregarOIncrementar(p);

                // Limpieza extra por seguridad
                document.getElementById("superBuscador").value = "";

                const statusBusqueda = document.getElementById("statusBusqueda");                statusBusqueda.innerHTML = `<span class="text-success fw-bold"><i class="bi bi-check-circle"></i> ${p.nombre} agregado.</span>`;
                setTimeout(() => { if(statusBusqueda.innerText.includes(p.nombre)) statusBusqueda.innerHTML = ""; }, 2000);
            }
        });
    });

    function agregarOIncrementar(prod) {
        const p = {
            id: prod.id,
            nombre: prod.nombre,
            precio: prod.precio,
            stock: prod.stock,
            esPorPeso: prod.esPorPeso,
            codigoBarra: prod.codigo || prod.codigoBarra
        };

        const filas = document.querySelectorAll("#tablaVenta tbody tr");
        
        for (let fila of filas) {
            const idInput = fila.querySelector(".producto-id");
            if (idInput && idInput.value == p.id) {
                const cantidadInput = fila.querySelector(".cantidad");
                cantidadInput.value = (parseFloat(cantidadInput.value) + 1).toFixed(p.esPorPeso ? 2 : 0);
                recalcularFila(fila);
                resaltarFila(fila);
                return;
            }
        }

        const tbody = document.querySelector("#tablaVenta tbody");
        const cantidadInicial = 1;
        const nuevaFila = `
            <tr class="table-success transition-all">
                <td>
                    <span class="fw-bold d-block">${p.nombre}</span>
                    <small class="text-muted">Cod: ${p.codigoBarra}</small>
                    <input type="hidden" name="detalles[${index}].ProductoId" value="${p.id}" class="producto-id" />
                </td>
                <td>
                    <input type="number" name="detalles[${index}].Cantidad" class="form-control cantidad text-center" 
                           value="${cantidadInicial}" step="0.01" min="0.01" oninput="recalcularFila(this.closest('tr'))" />
                </td>
                <td>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input type="text" name="detalles[${index}].PrecioUnitario" class="form-control precio" 
                               value="${p.precio}" readonly />
                    </div>
                </td>
                <td class="text-end fw-bold subtotal">$${p.precio}</td>
                <td class="text-center">
                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="eliminarFila(this)">
                        <i class="bi bi-trash"></i> Quitar
                    </button>
                </td>
            </tr>
        `;
        tbody.insertAdjacentHTML("beforeend", nuevaFila);
        index++;
        recalcularTotal();
        
        setTimeout(() => {
            const lastRow = tbody.lastElementChild;
            if (lastRow) lastRow.classList.remove("table-success");
        }, 1000);

        if (p.stock <= 0) {
            document.getElementById("statusBusqueda").innerHTML += ` <span class="text-warning small">(Sin stock)</span>`;
        }
    }

    function resaltarFila(fila) {
        fila.classList.add("table-warning");
        setTimeout(() => fila.classList.remove("table-warning"), 500);
    }

    function recalcularFila(fila) {
        const cantidadInput = fila.querySelector(".cantidad");
        const precioInput = fila.querySelector(".precio");
        const subtotalTd = fila.querySelector(".subtotal");

        const cantidad = parseFloat(cantidadInput.value) || 0;
        const precio = parseFloat(precioInput.value) || 0;
        const subtotal = cantidad * precio;

        subtotalTd.innerText = "$" + subtotal.toFixed(0);
        recalcularTotal();
    }

    function recalcularTotal() {
        let total = 0;
        document.querySelectorAll(".subtotal").forEach(s => {
            total += parseFloat(s.innerText.replace("$", "")) || 0;
        });
        document.getElementById("totalVenta").innerText = total.toFixed(0);
    }

    function eliminarFila(btn) {
        btn.closest("tr").remove();
        renumerarFilas();
        recalcularTotal();
    }

    function renumerarFilas() {
        const filas = document.querySelectorAll("#tablaVenta tbody tr");
        filas.forEach((fila, i) => {
            const prodId = fila.querySelector(".producto-id");
            const cant = fila.querySelector(".cantidad");
            const prec = fila.querySelector(".precio");
            if(prodId) prodId.name = `detalles[${i}].ProductoId`;
            if(cant) cant.name = `detalles[${i}].Cantidad`;
            if(prec) prec.name = `detalles[${i}].PrecioUnitario`;
        });
        index = filas.length;
    }

    function toggleFiado() {
        fiadoActivo = !fiadoActivo;
        const seccion = document.getElementById("seccionFiado");
        const btn = document.getElementById("btnFiado");
        const input = document.getElementById("esFiadoInput");

        if (fiadoActivo) {
            seccion.classList.remove("d-none");
            btn.classList.replace("btn-outline-secondary", "btn-warning");
            btn.innerHTML = "📋 Fiado ✅ <small>(clic para cancelar)</small>";
            input.value = "true";
            document.getElementById("buscadorCliente").focus();
        } else {
            seccion.classList.add("d-none");
            btn.classList.replace("btn-warning", "btn-outline-secondary");
            btn.innerHTML = "📋 Fiado";
            input.value = "false";
            document.getElementById("clienteId").value = "";
            document.getElementById("clienteSeleccionado").classList.add("d-none");
            document.getElementById("resultadosCliente").innerHTML = "";
            document.getElementById("buscadorCliente").value = "";
        }
    }

    document.getElementById("buscadorCliente")?.addEventListener("input", function() {
        const q = this.value;
        if (q.length < 2) {
            document.getElementById("resultadosCliente").innerHTML = "";
            return;
        }

        fetch(`/Cliente/Buscar?q=${encodeURIComponent(q)}`)
            .then(r => r.json())
            .then(data => {
                const lista = document.getElementById("resultadosCliente");
                lista.innerHTML = "";
                data.forEach(c => {
                    const item = document.createElement("a");
                    item.href = "#";
                    item.className = "list-group-item list-group-item-action";
                    item.textContent = c.nombre + (c.telefono ? ` — ${c.telefono}` : "");
                    item.onclick = (e) => {
                        e.preventDefault();
                        seleccionarCliente(c);
                        lista.innerHTML = "";
                        document.getElementById("buscadorCliente").value = c.nombre;
                    };
                    lista.appendChild(item);
                });
            });
    });

    function seleccionarCliente(c) {
        document.getElementById("clienteId").value = c.id;
        document.getElementById("clienteNombre").textContent = "👤 " + c.nombre;
        document.getElementById("clienteSeleccionado").classList.remove("d-none");

        fetch(`/Cliente/Saldo?id=${c.id}`)
            .then(r => r.json())
            .then(data => {
                const saldoEl = document.getElementById("clienteSaldo");
                if (data.saldo > 0) {
                    saldoEl.textContent = `⚠️ Saldo pendiente: $${data.saldo.toFixed(0)}`;
                    saldoEl.classList.add("text-danger");
                } else {
                    saldoEl.textContent = "✅ Al día";
                    saldoEl.classList.replace("text-danger", "text-success");
                }
            });
    }

    function abrirModalCliente() {
        document.getElementById("nuevoClienteNombre").value = "";
        document.getElementById("nuevoClienteTelefono").value = "";
        document.getElementById("errorNombre").classList.add("d-none");
        new bootstrap.Modal(document.getElementById("modalNuevoCliente")).show();
        setTimeout(() => document.getElementById("nuevoClienteNombre").focus(), 300);
    }

    function guardarClienteRapido() {
        const nombre = document.getElementById("nuevoClienteNombre").value.trim();
        const telefono = document.getElementById("nuevoClienteTelefono").value.trim();

        if (!nombre) {
            document.getElementById("errorNombre").classList.remove("d-none");
            return;
        }

        fetch("/Cliente/CrearRapido", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ nombre, telefono })
        })
        .then(r => r.json())
        .then(data => {
            if (data.ok) {
                seleccionarCliente({ id: data.id, nombre: data.nombre });
                document.getElementById("buscadorCliente").value = data.nombre;
                bootstrap.Modal.getInstance(document.getElementById("modalNuevoCliente")).hide();
            } else {
                alert("Error: " + data.error);
            }
        });
    }

    window.onload = () => {
        document.getElementById("superBuscador").focus();
        recalcularTotal();
    };

    document.addEventListener("input", function(e) {
        if (e.target.classList.contains("cantidad") || e.target.classList.contains("precio")) {
            const fila = e.target.closest("tr");
            if (fila) recalcularFila(fila);
        }
    });

    document.querySelector("form").onkeypress = (e) => {
        if (e.target.id === "superBuscador" && e.key === "Enter") return false;
    };

    document.querySelector("form").onsubmit = function(e) {
        if (fiadoActivo && !document.getElementById("clienteId").value) {
            e.preventDefault();
            alert("Debe seleccionar un cliente para venta al fiado.");
            return false;
        }
        document.querySelectorAll(".cantidad, .precio").forEach(i => {
            i.value = i.value.replace(",", ".");
        });
    };
    </script>
}


<!-- MODAL CLIENTE RÁPIDO -->
<div class="modal fade text-black rounded" id="modalNuevoCliente" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog rounded">
        <div class="modal-content rounded">
            <div class="modal-header bg-success rounded">
                <h5 class="modal-title fw-bold text-white">➕ Nuevo Cliente</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="fw-bold">Nombre completo <span class="text-danger">*</span></label>
                    <input type="text" id="nuevoClienteNombre" class="form-control form-control-lg" placeholder="Ej: Juan Pérez" />
                    <div id="errorNombre" class="text-danger d-none text-small">El nombre es obligatorio.</div>
                </div>
                <div class="mb-3">
                    <label class="fw-bold">Teléfono <span class="text-muted">(opcional)</span></label>
                    <input type="text" id="nuevoClienteTelefono" class="form-control form-control-lg" placeholder="Ej: 011-4444-5555" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success btn-lg" onclick="guardarClienteRapido()">💾 Guardar y seleccionar</button>
            </div>
        </div>
    </div>
</div>
