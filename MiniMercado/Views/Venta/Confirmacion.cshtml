@{
    ViewData["Title"] = "Venta Confirmada";
    var ventaId = ViewBag.VentaId;
}

<h2 class="text-success mt-4">Venta confirmada!!</h2>

<p>@ViewBag.Mensaje</p>

<!-- Botones de acción -->
<div class="mt-5">

    <a asp-action="Create" class="btn btn-success">
        🛒 Nueva Venta
    </a>

    <a asp-action="Detalle"
       asp-route-id="@ventaId"
       class="btn btn-primary">
        📄 Ver detalle
    </a>

    <a asp-action="Ticket"
       asp-route-id="@ventaId"
       target="_blank"
       class="btn btn-secondary">
        🧾 Imprimir Ticket
    </a>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-info">
        🏠 Inicio
    </a>

</div>

<div class="mt-5">
    <!-- Formulario para agregar nombre/nota a la venta -->
    <form method="post"
          asp-controller="Venta"
          asp-action="Confirmacion">

        @Html.AntiForgeryToken()

        <input type="hidden" name="ventaId" value="@ventaId" />

        <div class="mb-4">
            <label class="form-label">
                Nombre o nota de la venta (opcional)
            </label>

            <input type="text"
                   name="NombreVenta"
                   class="form-control"
                   placeholder="Ej: Cliente Juan / Pedido especial" />
        </div>

        <button type="submit" class="btn btn-outline-primary">
            💾 Guardar nota
        </button>
    </form>

    <div class="mt-3">
        @if (ViewBag.MensajeNombreVenta != null)
        {
            <div class="alert alert-success">
                @ViewBag.MensajeNombreVenta
            </div>
        }
    </div>

</div>