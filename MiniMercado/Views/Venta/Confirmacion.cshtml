@model MiniMercado.Models.Venta

@{
    ViewData["Title"] = "Venta Confirmada";
    var ventaId = ViewBag.VentaId;
}

<h2 class="text-white mt-4 fs-1">Venta confirmada🎉!!!</h2>

<p class="text-white">@ViewBag.Mensaje</p>

<!-- Detalle de la venta -->
<div class="mt-5">
    <div class="table-responsive">
        <table class="table mt-3">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cant.</th>
                    <th>Precio</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Detalles)
                {
                    <tr>
                        <td>@d.Producto.Nombre</td>
                        <td>@d.Cantidad.ToString("0.##")</td>
                        <td>@d.PrecioUnitario.ToString("0.##")</td>
                        <td>@((d.Cantidad * d.PrecioUnitario).ToString("0.##"))</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-end fw-bold">TOTAL:</td>
                    <td class="fw-bold">@Model.Total.ToString("0.##")</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="mt-5">
    <form method="post"
          asp-controller="Venta"
          asp-action="Confirmacion">

        @Html.AntiForgeryToken()

        <input type="hidden" name="ventaId" value="@ventaId" />

        <div class="mb-4">
            <label class="text-white form-label">
                Nombre o nota de la venta (opcional)
            </label>
            <input type="text"
                   name="NombreVenta"
                   class="form-control"
                   placeholder="Ej: Cliente Juan / Pedido especial" />

            <button type="submit" class="btn btn-outline-primary mt-3">
                💾 Guardar nota
            </button>
        </div>
        <div class="mt-2">
            @if (ViewBag.MensajeNombreVenta != null)
            {
                <div class="alert alert-success">
                    @ViewBag.MensajeNombreVenta
                </div>
            }
        </div>
    </form>
</div>

<!-- Botones de acción -->
<div class="mt-4">
    <a id="btnNuevaVenta" asp-action="Create" class="btn btn-success mt-4 me-2">
        🛒 Nueva Venta
    </a>
    <a asp-action="Ticket"
           asp-route-id="@ventaId"
           target="_blank"
           class="btn btn-secondary mt-4 me-2">
        🧾 Imprimir Ticket
    </a>
    <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-info mt-4 me-2">
        🏠 Inicio
    </a>
    <a asp-controller="VentaAdmin"
           asp-action="Anular"
           asp-route-id="@ventaId"
           class="btn btn-danger mt-4">
        ❌ Anular
    </a>
</div>

@section Scripts {
    <script>
        document.addEventListener("keydown", function(e) {
            // Si presiona Enter y no está escribiendo en el input de nombre/nota
            if (e.key === "Enter" && e.target.tagName !== "INPUT" && e.target.tagName !== "TEXTAREA") {
                e.preventDefault();
                document.getElementById("btnNuevaVenta").click();
            }
        });
    </script>
}
