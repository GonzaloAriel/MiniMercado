@model MiniMercado.Models.Venta
@using MiniMercado.Models

@{
    var tenant = ViewBag.Tenant as Tenant;
}

<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: monospace; width: 280px; }
        h3 { text-align: center; }
        p.centro { text-align: center; }
        table { width: 100%; }
        .table-responsive { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    </style>
</head>
<body onload="window.print()">

    <h3>@(tenant?.NombreComercio ?? "MiniMercado")</h3>

    @if (!string.IsNullOrEmpty(tenant?.Direccion))
    {
        <p class="centro">@tenant.Direccion</p>
    }
    @if (!string.IsNullOrEmpty(tenant?.Telefono))
    {
        <p class="centro">Tel: @tenant.Telefono</p>
    }
    @if (!string.IsNullOrEmpty(tenant?.CUIT))
    {
        <p class="centro">CUIT: @tenant.CUIT</p>
    }

    <hr />

   <p>Venta #@Model.Id | @Model.Fecha.ToString("dd/MM/yyyy HH:mm")</p>

    <hr />

    <div class="table-responsive">
        <table class="table">
            @foreach (var d in Model.Detalles)
            {
                <tr>
                    <td>@d.Producto.Nombre</td>
                    <td>x @d.Cantidad.ToString("0.##")</td>
                    <td>$@((d.Cantidad * d.PrecioUnitario).ToString("0.##"))</td>
                </tr>
            }
        </table>
    </div>

    <hr />
    <p><strong>Total: $@Model.Total.ToString("0.##")</strong></p>

    @if (!string.IsNullOrEmpty(tenant?.MensajeTicket))
    {
        <p class="centro">@tenant.MensajeTicket</p>
    }

</body>
</html>