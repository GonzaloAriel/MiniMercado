@model List<Venta>

<h2 class="mt-4" >Historial de Ventas</h2>

<hr />

<form method="get" class="row g-2 mb-3">

    <div class="col-md-2">
        <label class="form-label">N° venta</label>
        <input type="number"
               name="ventaId"
               class="form-control"
               placeholder="N°" />
    </div>

    <div class="col-md-3">
        <label class="form-label">Nombre</label>
        <input type="text"
               name="nombreVenta"
               class="form-control"
               placeholder="Cliente / Nota" />
    </div>

    <div class="col-md-2">
        <label class="form-label">Desde</label>
        <input type="date"
               name="desde"
               class="form-control" />
    </div>

    <div class="col-md-2">
        <label class="form-label">Hasta</label>
        <input type="date"
               name="hasta"
               class="form-control" />
    </div>

    <div class="col-md-3">
        <label class="form-label">Filtrar</label>
        <button class="btn btn-primary w-100">
            🔍 Filtrar
        </button>
    </div>

</form>


<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Fecha</th>
            <th>Nombre</th>
            <th>Total</th>
            <th style="width:200px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td>@v.Id</td>

                <td>@v.Fecha.ToString("dd/MM/yyyy HH:mm")</td>

                <td>
                    @(string.IsNullOrWhiteSpace(v.NombreVenta)
                                    ? "-"
                                    : v.NombreVenta)
                </td>

                <td>$@v.Total</td>

                <td>

                    <a asp-action="Detalle"
                       asp-route-id="@v.Id"
                       class="btn btn-sm btn-info">
                        👁 Detalle
                    </a>

                    <a asp-action="Ticket"
                       asp-route-id="@v.Id"
                       target="_blank"
                       class="btn btn-sm btn-secondary">
                        🧾 Ticket
                    </a>

                </td>
            </tr>
        }
    </tbody>
</table>
