@model MiniMercado.Models.Producto
@{
    ViewData["Title"] = "Crear Producto Elaborado";
}

<div class="container py-4">
    <div class="card shadow-sm rounded-4 border-0 bg-card">
        <div class="card-body p-5">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }
            <h3 class="fw-bold text-primary mb-1">Crear Producto Elaborado</h3>
            <p class="text-secondary mb-4">Crea productos sin código de fábrica y genera un código interno para venderlos fácilmente.</p>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nombre del producto *</label>
                        <input asp-for="Nombre" class="form-control rounded-pill" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Categoría *</label>
                        <select asp-for="RubroId" class="form-select rounded-pill" asp-items="ViewBag.RubroId" required>
                            <option value="">Seleccione una categoría</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Precio de venta *</label>
                        <input asp-for="Precio" class="form-control rounded-pill" type="number" step="0.01" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Stock inicial *</label>
                        <input name="stockInicial" class="form-control rounded-pill" type="number" step="0.01" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Unidad</label>
                        <select class="form-select rounded-pill">
                            <option>Unidad</option>
                            <option>Kg</option>
                            <option>Gramos</option>
                            <option>Litros</option>
                            <option>Mililitros</option>
                            <option>Docena</option>
                            <option>Paquete</option>
                        </select>
                    </div>
                </div>
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Guardar Producto</button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Volver</a>
                </div>
            </form>
        </div>
    </div>
</div>
