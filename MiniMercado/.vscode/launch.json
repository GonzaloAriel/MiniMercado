{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MiniMercado (http:5267)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/bin/Debug/net6.0/MiniMercado.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5267"
      },
      "envFile": "${workspaceFolder}/.env",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(\\S+)"
      }
    }
  ]
}
